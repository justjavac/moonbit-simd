name = "justjavac/memchr"

version = "0.1.1"

readme = "README.md"

repository = "https://github.com/justjavac/moonbit-simd"

license = "MIT"

keywords = [ "memchr", "memmem", "substring", "search", "simd" ]

description = "Portable SIMD byte and substring search, double-ended byte matches, and reusable Two-Way finders ported from memchr"

preferred_target = "wasm"

warnings = "+missing_doc+test_unqualified_package"
