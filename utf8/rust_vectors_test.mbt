}

///|
test "Rust standard-library fixtures retain exact compatibility errors" {
  for (data, position, length) in rust_vectors() {
    match position {
      None => {
        assert_true(@utf8.is_valid(data))
        @utf8.validate(data)
      }
      Some(position) => expect_error(data, position, length)
    }
  }
}
