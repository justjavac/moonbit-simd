----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
}
----

///|
/// Exports native trace metadata, optionally selecting one current runtime log.
/// Flat library roots share the same three trace-source paths.
async fn main {
  let args = @env.args()
  guard args.length() >= 3 &&
    ["linux", "macos", "windows", "local"].contains(args[1]) else {
    fail("Usage: moon run scripts/coverage_report.mbtx <OS flag> <module>...")
  }
  let flag = args[1]
  let directories : Array[String] = []
  let mut runtime_log : String? = None
  for index = 2; index < args.length(); {
    if args[index] == "--runtime-log" {
      guard index + 1 < args.length() &&
        runtime_log is None &&
        args[index + 1] != "" else {
        fail("--runtime-log requires one nonempty path and may be given once")
      }
      runtime_log = Some(args[index + 1])
      continue index + 2
    } else {
      directories.push(args[index])
      continue index + 1
    }
  }
  guard !directories.is_empty() else { fail("At least one module is required") }
  for module_dir in directories {
    guard module_dir != "" &&
      module_dir != "." &&
      module_dir != ".." &&
      module_dir.find("/") is None &&
      module_dir.find("\\") is None else {
      fail("Expected a direct workspace module directory")
    }
    let prefix = "_build/native/debug/test/justjavac/\{module_dir}/\{module_dir}"
    let report = "coverage-\{module_dir}-\{flag}.xml"
    let command = [
      "coverage",
      "report",
      "--",
      "--no-ignore-missing-files",
      "-p",
      "justjavac/\{module_dir}",
      "-f",
      "cobertura",
      "-o",
      report,
    ]
    if runtime_log is Some(path) {
      command.push("-t")
      command.push(path)
    }
    command.push("\{prefix}.trace.source")
    command.push("\{prefix}.whitebox_test.trace.source")
    command.push("\{prefix}.internal_test.trace.source")
    let output = @shell.Cmd("moon", command).output(max_output_bytes=2097152)
    guard output.exit_code() == 0 else {
      fail(output.stdout() + output.stderr())
    }
    println("Generated \{report} from native coverage")
  }
}
