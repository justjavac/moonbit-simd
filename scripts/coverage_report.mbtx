----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
}
----

///|
/// Exports filtered Cobertura from an explicit set of trace files and runtime logs.
async fn export_report(
  package_path : String,
  prefix : String,
  report : String,
  runtime_logs : Array[String],
  whitebox~ : Bool,
) -> Unit {
  let command = [
    "coverage",
    "report",
    "--",
    "--no-ignore-missing-files",
    "-p",
    "justjavac/\{package_path}",
    "-f",
    "cobertura",
    "-o",
    report,
  ]
  for path in runtime_logs {
    command.push("-t")
    command.push(path)
  }
  command.push("\{prefix}.trace.source")
  if whitebox {
    command.push("\{prefix}.whitebox_test.trace.source")
  }
  command.push("\{prefix}.internal_test.trace.source")
  let output = @shell.Cmd("moon", command).output(max_output_bytes=2097152)
  guard output.exit_code() == 0 else { fail(output.stdout() + output.stderr()) }
  println("Generated \{report}")
}

///|
/// Exports the JavaScript StringZilla tests from their isolated build directory.
async fn export_string_js(flag : String) -> Unit {
  let directory = "_build/string-js-coverage"
  let logs = @fs.readdir(directory, sort=true)
    .filter(name => {
      name.has_prefix("moonbit_coverage_") && name.has_suffix(".txt")
    })
    .map(name => directory + "/" + name)
  guard !logs.is_empty() else {
    fail("No JavaScript string coverage logs found")
  }
  export_report(
    "string",
    directory + "/js/debug/test/justjavac/string/string",
    "coverage-string-js-\{flag}.xml",
    logs,
    whitebox=false,
  )
}

///|
/// Exports native workspace coverage or the supplemental JavaScript string report.
async fn main {
  let args = @env.args()
  guard args.length() >= 3 &&
    ["linux", "macos", "windows", "local"].contains(args[1]) else {
    fail(
      "Usage: moon run scripts/coverage_report.mbtx <OS flag> <module>... | --string-js",
    )
  }
  let flag = args[1]
  if args.length() == 3 && args[2] == "--string-js" {
    export_string_js(flag)
    return
  }
  let directories : Array[String] = []
  let mut runtime_log : String? = None
  for index = 2; index < args.length(); {
    if args[index] == "--runtime-log" {
      guard index + 1 < args.length() &&
        runtime_log is None &&
        args[index + 1] != "" else {
        fail("--runtime-log requires one nonempty path and may be given once")
      }
      runtime_log = Some(args[index + 1])
      continue index + 2
    } else {
      directories.push(args[index])
      continue index + 1
    }
  }
  guard !directories.is_empty() else { fail("At least one module is required") }
  for module_dir in directories {
    guard [
      "crc32", "url", "utf8", "base64", "atoi", "argminmax", "uuid", "ryu", "memchr",
      "wc", "bytecount", "string",
    ].contains(module_dir) else {
      fail("Expected a configured workspace library: " + module_dir)
    }
    let packages = if module_dir == "memchr" {
      [("memchr", "memchr"), ("memchr/memmem", "memchr-memmem")]
    } else {
      [(module_dir, module_dir)]
    }
    for (package_path, report_name) in packages {
      let file_name = if package_path == "memchr/memmem" {
        "memmem"
      } else {
        module_dir
      }
      let prefix = "_build/native/debug/test/justjavac/\{package_path}/\{file_name}"
      let report = "coverage-\{report_name}-\{flag}.xml"
      let logs = match runtime_log {
        Some(path) => [path]
        None => []
      }
      export_report(
        package_path,
        prefix,
        report,
        logs,
        whitebox=!["bytecount", "string"].contains(module_dir),
      )
    }
  }
}
