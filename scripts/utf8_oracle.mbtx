----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
}
----

///|
/// Formats exact bytes as ASCII hex for Rust input and checked MoonBit fixtures.
fn hex(bytes : BytesView, escaped~ : Bool = false) -> String {
  let digits = "0123456789abcdef"
  let builder = StringBuilder()
  for byte in bytes {
    if escaped {
      builder.write_string("\\x")
    }
    let high = byte.to_int() >> 4
    let low = byte.to_int() & 15
    builder.write_string(digits[high:high + 1].to_owned())
    builder.write_string(digits[low:low + 1].to_owned())
  }
  builder.to_string()
}

///|
/// Runs Rust's standard UTF-8 validator and records exact error metadata.
async fn main {
  @fs.mkdir("_build/utf8-oracle", recursive=true, allow_existing=true)
  let invalid : Array[Bytes] = [
    b"\x80", b"\xC0\x80", b"\xC1\xBF", b"\xE0\x9F\x80", b"\xED\xA0\x80", b"\xF0\x8F\xBF\xBF",
    b"\xF4\x90\x80\x80", b"\xF5", b"\xFF", b"\xC3", b"\xE2\x82", b"\xF0\x9F", b"\xF0\x9F\x98",
    b"\xE2\x82a", b"\xF0\x9Fa", b"\xF0\x9F\x98a",
  ]
  let valid : Array[Bytes] = [
    b"", b"\x00", b"\xC2\x80", b"\xDF\xBF", b"\xE0\xA0\x80", b"\xED\x9F\xBF", b"\xEF\xBB\xBF",
    b"\xF0\x90\x80\x80", b"\xF4\x8F\xBF\xBF",
  ]
  let inputs : Array[Bytes] = []
  for prefix in [0, 1, 15, 16, 31, 32, 63, 64, 65, 127, 128, 129] {
    let before = Bytes::make(prefix, b'a')
    for bytes in invalid {
      inputs.push(before + bytes)
      inputs.push(before + bytes + b"ASCII suffix")
    }
    for bytes in valid {
      inputs.push(before + bytes + Bytes::make(19, b'b'))
    }
  }
  let mut seed = 0x5EED1234U
  for sample in 0..<128 {
    let bytes = Bytes::makei(sample % 32, _ => {
      seed = seed * 1664525U + 1013904223U
      (seed >> 24).to_byte()
    })
    inputs.push(Bytes::make(63, b'a') + bytes)
  }
  @fs.write_text(
    "_build/utf8-oracle/input.txt",
    inputs.map(input => hex(input)).join("\n"),
  )
  let rust =
    #|use std::{env, fs};
    #|fn main() {
    #|    let input = fs::read_to_string(env::args().nth(1).unwrap()).unwrap();
    #|    for line in input.lines() {
    #|        let bytes: Vec<u8> = line.as_bytes().chunks_exact(2).map(|pair| {
    #|            u8::from_str_radix(std::str::from_utf8(pair).unwrap(), 16).unwrap()
    #|        }).collect();
    #|        match std::str::from_utf8(&bytes) {
    #|            Ok(_) => println!("ok"),
    #|            Err(error) => match error.error_len() {
    #|                Some(length) => println!("{}:{}", error.valid_up_to(), length),
    #|                None => println!("{}:none", error.valid_up_to()),
    #|            }
    #|        }
    #|    }
    #|}
  @fs.write_text("_build/utf8-oracle/main.rs", rust)
  let executable = if @env.get_env_var("OS") == Some("Windows_NT") {
    "_build/utf8-oracle/oracle.exe"
  } else {
    "_build/utf8-oracle/oracle"
  }
  let compile = @shell.Cmd("rustc", [
    "--edition=2021", "_build/utf8-oracle/main.rs", "-o", executable,
  ]).output()
  guard compile.exit_code() == 0 else { fail(compile.stderr()) }
  let output = @shell.Cmd(executable, ["_build/utf8-oracle/input.txt"]).output()
  guard output.exit_code() == 0 else { fail(output.stderr()) }
  let results = output.stdout().trim().split("\n").to_array()
  guard results.length() == inputs.length() else {
    fail("Incomplete Rust oracle output")
  }
  let version = @shell.Cmd("rustc", ["--version"]).output()
  guard version.exit_code() == 0 else { fail(version.stderr()) }
  let builder = StringBuilder()
  builder.write_string(
    "// Generated by moon run scripts/utf8_oracle.mbtx. Do not edit.\n",
  )
  builder.write_string(
    "// Oracle: " +
    version.stdout().trim().to_owned() +
    "; seed 0x5EED1234.\n\n",
  )
  builder.write_string(
    "///|\n/// Returns Rust standard-library acceptance and exact error metadata.\n",
  )
  builder.write_string(
    "fn rust_vectors() -> Array[(Bytes, Int?, Int?)] {\n  [\n",
  )
  for index, bytes in inputs {
    let result = results[index].trim()
    let expected = if result == "ok" {
      "None, None"
    } else {
      let parts = result.split(":").to_array()
      guard parts.length() == 2 else { fail("Malformed Rust error") }
      let length = if parts[1] == "none" { "None" } else { "Some(\{parts[1]})" }
      "Some(\{parts[0]}), " + length
    }
    builder.write_string(
      "    (b\"\{hex(bytes, escaped=true)}\", \{expected}),\n",
    )
  }
  builder.write_string("  ]\n}\n")
  let replay =
    #|
    #|///|
    #|test "Rust standard-library fixtures retain exact compatibility errors" {
    #|  for (data, position, length) in rust_vectors() {
    #|    match position {
    #|      None => {
    #|        assert_true(@utf8.is_valid(data))
    #|        @utf8.validate(data)
    #|      }
    #|      Some(position) => expect_error(data, position, length)
    #|    }
    #|  }
    #|}
  builder.write_string(replay)
  @fs.write_text("utf8/rust_vectors_test.mbt", builder.to_string())
  println("Generated \{inputs.length()} Rust UTF-8 compatibility vectors")
}
