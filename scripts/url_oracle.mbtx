----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/json",
}
----

///|
/// Generates deterministic valid and invalid inputs covering distinct parser states.
fn inputs() -> Array[Json] {
  let cases : Array[Json] = []
  let schemes = ["https", "http", "ftp", "ws", "wss"]
  let hosts = [
    "example.com", "Example.COM", "192.168.1.1", "0x7f.1", "[2001:db8::1]", "例子.测试",
  ]
  let paths = [
    "/a/b", "/a/../b", "/a/%2e%2e/x", "/a//b/", "/a\\b", "/hello world", "/你好",
    "/%ZZ",
  ]
  let suffixes = [
    "", "?", "#", "?#", "?x=hello world#top", "?q=你好", "#x?y", "?x=1&x=2",
  ]
  let bases = [
    "https://example.com/a/b?old=1", "file:///C:/a/b", "foo:/a/b", "about:blank",
  ]
  let references = [
    "../x", "/x", "?x=1", "#top", "", "//other.example/x", "C|/x", "./a\\b",
  ]
  let opaque_urls = [
    "mailto:alice@example.com", "data:text/plain,hello", "about:blank", "foo:a/../b",
    "blob:https://example.com/id",
  ]
  let malformed = [
    "http://[broken", "http://h:65536", "http://0x100000000", "http://1..2", "http://a b",
    "https://", "http://[1:2:3]", "relative/path",
  ]
  let mut seed = 0xA5A5F00DU
  for i in 0..<800 {
    seed = seed * 1664525U + 1013904223U
    let pick = (seed >> 8).reinterpret_as_int()
    let entry : Json = match i % 4 {
      0 =>
        {
          "input": "\{schemes[pick % schemes.length()]}://\{hosts[(pick / 7) % hosts.length()]}\{paths[(pick / 11) % paths.length()]}\{suffixes[(pick / 13) % suffixes.length()]}",
          "base": null,
        }
      1 =>
        {
          "input": references[pick % references.length()],
          "base": bases[pick / 7 % bases.length()],
        }
      2 =>
        {
          "input": opaque_urls[pick % opaque_urls.length()] +
          suffixes[pick / 7 % suffixes.length()],
          "base": null,
        }
      _ => { "input": malformed[pick % malformed.length()], "base": null }
    }
    cases.push(entry)
  }
  cases
}

///|
/// Executes the external reference runtime and requires a successful exit.
async fn node(args : Array[String]) -> String {
  let output = @shell.Cmd("node", args).output(max_output_bytes=2097152)
  guard output.exit_code() == 0 else { fail(output.stderr()) }
  output.stdout().trim().to_owned()
}

///|
/// Records a portable fixture from Node's independent WHATWG URL implementation.
async fn main {
  @fs.mkdir("_build", allow_existing=true)
  @fs.write_text("_build/url-oracle-input.json", Json(inputs()).stringify())
  // JavaScript is only the minimal adapter required to call Node's URL API;
  // corpus generation, process orchestration, and fixture writing stay in MoonBit.
  let adapter =
    #|const fs=require('node:fs');const cases=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.stdout.write(JSON.stringify(cases.map(c=>{try{const u=c.base===null?new URL(c.input):new URL(c.input,c.base);return {...c,href:u.href,origin:u.origin,protocol:u.protocol,username:u.username,password:u.password,host:u.host,hostname:u.hostname,port:u.port,pathname:u.pathname,search:u.search,hash:u.hash};}catch{return {...c,failure:true};}})));
  let data = @json.parse(node(["-e", adapter, "_build/url-oracle-input.json"])).stringify(
    indent=2,
  )
  let node_version = node(["--version"])
  let ada_version = node(["-p", "process.versions.ada"])
  let output = StringBuilder()
  output.write_string(
    "// Generated by scripts/url_oracle.mbtx; seed 0xA5A5F00D, 800 cases.\n// Reference: Node.js \{node_version}, embedded Ada \{ada_version}.\n\n///|\n/// Holds independently normalized URLs and rejection outcomes from Node's URL API.\nlet node_oracle_data : String =\n",
  )
  for line in data.split("\n") {
    output.write_string("  #|" + line.to_owned() + "\n")
  }
  @fs.write_text("url/node_oracle_data_test.mbt", output.to_string())
  println(
    "Generated 800 cases with Node.js \{node_version}, Ada \{ada_version}",
  )
}
