----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}
----

///|
/// Isolates the seed inventory without reading similarly named helper declarations.
fn seed_table(source : String) -> StringView raise {
  guard source.find("const SEEDS:") is Some(start) else {
    fail("Missing seeds")
  }
  let table = source[start:]
  guard table.find("\n];") is Some(end) else { fail("Missing seed table end") }
  table[:end]
}

///|
/// Preserves a Rust string as a MoonBit byte literal with the three ASCII escapes.
fn take_string(input : StringView) -> (String, StringView) raise {
  let input = input.trim()
  guard input.has_prefix("\"") else { fail("Expected a Rust string literal") }
  let mut index = 1
  while index < input.length() {
    if input[index] == 92 {
      index = index + 2
    } else if input[index] == 34 {
      let literal = input[:index + 1]
        .to_owned()
        .replace_all(old="\\u{0}", new="\\x00")
        .replace_all(old="\\u{15}", new="\\x15")
        .replace_all(old="\\u{1e}", new="\\x1e")
      return ("b" + literal, input[index + 1:])
    } else {
      index = index + 1
    }
  }
  fail("Unterminated Rust string literal")
}

///|
/// Consumes a comma between pinned positional seed arguments.
fn after_comma(input : StringView) -> StringView raise {
  let input = input.trim()
  guard input.has_prefix(",") else { fail("Missing seed argument separator") }
  input[1:]
}

///|
/// Preserves a seed's explicit optional match offset without recomputing results.
fn take_option(input : StringView) -> (String, StringView) raise {
  let input = input.trim()
  if input.has_prefix("None") {
    return ("None", input[4:])
  }
  guard input.has_prefix("Some(") && input.find(")") is Some(end) else {
    fail("Expected an upstream optional offset")
  }
  let value = @string.parse_int(input[5:end])
  guard value >= 0 else { fail("Expected a nonnegative match offset") }
  ("Some(\{value})", input[end + 1:])
}

///|
/// Preserves a named seed's bracketed byte or offset array verbatim.
fn named_array(input : StringView, name : String) -> String raise {
  guard input.find(name + ":") is Some(start) else { fail("Missing " + name) }
  let field = input[start + name.length() + 1:].trim()
  guard field.has_prefix("&[") && field.find("]") is Some(end) else {
    fail("Expected a seed array: " + name)
  }
  "[" + field[2:end].to_owned() + "]"
}

///|
/// Translates every byte-search seed, including repeated upstream rows.
fn byte_vectors(source : String) -> String raise {
  let output = StringBuilder()
  output.write_string(
    "///|\n/// All 27 byte-search seeds from memchr 2.8.3 at 5fdb40c054e1fff359a2f7bdf7f87a13b34b465d.\n/// Generated by scripts/memchr_fixtures.mbtx; upstream expectations use MIT.\nfn upstream_byte_seeds() -> Array[(Bytes, Array[Byte], Array[Int32])] {\n  [\n",
  )
  let mut count = 0
  for seed in seed_table(source).split("Seed {").drop(1) {
    guard seed.find("haystack:") is Some(start) else {
      fail("Missing haystack")
    }
    let (data, _) = take_string(seed[start + 9:])
    let needles = named_array(seed, "needles")
    let positions = named_array(seed, "positions")
    output.write_string(
      "    (" + data + ", " + needles + ", " + positions + "),\n",
    )
    count = count + 1
  }
  guard count == 27 else { fail("Expected all 27 upstream byte-search seeds") }
  output.write_string("  ]\n}\n")
  output.to_string()
}

///|
/// Translates every substring seed while retaining explicit forward/reverse results.
fn substring_vectors(source : String) -> String raise {
  let output = StringBuilder()
  output.write_string(
    "///|\n/// All 37 substring seeds from memchr 2.8.3 at 5fdb40c054e1fff359a2f7bdf7f87a13b34b465d.\n/// Generated by scripts/memchr_fixtures.mbtx; upstream expectations use MIT.\nfn upstream_substring_seeds() -> Array[(Bytes, Bytes, Int32?, Int32?)] {\n  [\n",
  )
  let mut count = 0
  for seed in seed_table(source).split("Seed::new(").drop(1) {
    let (needle, tail) = take_string(seed)
    let (data, tail) = take_string(after_comma(tail))
    let (first, tail) = take_option(after_comma(tail))
    let (last, _) = take_option(after_comma(tail))
    output.write_string(
      "    (" + needle + ", " + data + ", " + first + ", " + last + "),\n",
    )
    count = count + 1
  }
  guard count == 37 else { fail("Expected all 37 upstream substring seeds") }
  output.write_string("  ]\n}\n")
  output.to_string()
}

///|
/// Regenerates complete pinned upstream fixtures and the byte-frequency table.
async fn main {
  let args = @env.args()
  guard args.length() == 2 else {
    fail("Usage: moon run scripts/memchr_fixtures.mbtx <memchr-2.8.3-source>")
  }
  let root = args[1]
  let provenance = @json.parse(@fs.read_text(root + "/.cargo_vcs_info.json"))
  guard provenance
    is {
      "git": { "sha1": String("5fdb40c054e1fff359a2f7bdf7f87a13b34b465d"), .. },
      ..
    } else {
    fail("Expected the pinned memchr 2.8.3 source revision")
  }
  let source = @fs.read_text(root + "/src/arch/all/packedpair/default_rank.rs")
  guard source.find("= [") is Some(start) else { fail("Missing rank table") }
  let table = source[start + 3:]
  guard table.find("];") is Some(end) else { fail("Missing rank table end") }
  let values : Array[Int32] = []
  for line in table[:end].split("\n") {
    let line = line.trim()
    if line.find(",") is Some(comma) {
      values.push(@string.parse_int(line[:comma]))
    }
  }
  guard values.length() == 256 else { fail("Expected all 256 frequency ranks") }
  for value in values {
    guard value >= 0 && value <= 255 else {
      fail("Expected a byte-frequency rank between zero and 255")
    }
  }
  let output = StringBuilder()
  output.write_string(
    "///|\n/// Upstream memchr 2.8.3 background byte-frequency ranks; lower means rarer.\n/// Generated by scripts/memchr_fixtures.mbtx from revision\n/// 5fdb40c054e1fff359a2f7bdf7f87a13b34b465d, under the MIT option.\nlet frequency_rank : ReadOnlyArray[Int32] = [\n",
  )
  for row in 0..<16 {
    output.write_string(
      "  " +
      values[row * 16:row * 16 + 16]
      .iter()
      .map(value => value.to_string())
      .join(", ") +
      ",\n",
    )
  }
  output.write_string("]\n")
  let bytes = byte_vectors(
    @fs.read_text(root + "/src/tests/memchr/mod.rs").replace_all(
      old="\r\n",
      new="\n",
    ),
  )
  let substrings = substring_vectors(
    @fs.read_text(root + "/src/tests/substring/mod.rs").replace_all(
      old="\r\n",
      new="\n",
    ),
  )
  @fs.write_text("memchr/memmem/frequency.mbt", output.to_string())
  @fs.write_text("memchr/upstream_vectors_test.mbt", bytes)
  @fs.write_text("memchr/memmem/upstream_vectors_test.mbt", substrings)
  println(
    "Regenerated 27 byte seeds, 37 substring seeds, and 256 pinned frequency ranks",
  )
}
