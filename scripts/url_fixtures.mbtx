----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
}
----

///|
/// Embeds exact upstream JSON text without interpreting UTF-16 surrogate escapes.
fn source(name : String, input : String) -> String {
  let output = StringBuilder()
  output.write_string(
    "// Generated by scripts/url_fixtures.mbtx from Ada 8a4bf2e213a6519534d04128f7c2002c0494af5c.\n// WPT data is covered by url/TEST-DATA-LICENSE.md; Ada additions retain its MIT notice.\n\n///|\n/// Holds the unmodified upstream test cases, including malformed surrogate inputs.\nlet \{name} : String =\n",
  )
  for line in input.trim_end().split("\n") {
    output.write_string("  #|" + line.trim_end(chars="\r").to_owned() + "\n")
  }
  output.to_string()
}

///|
/// Generates portable embedded fixtures from a pinned Ada checkout without shell transforms.
async fn main {
  let args = @env.args()
  guard args.length() == 2 else {
    fail("Usage: moon run scripts/url_fixtures.mbtx <Ada checkout>")
  }
  let root = args[1]
  for
    (file, name) in [
      ("urltestdata.json", "wpt_url_data"),
      ("ada_extra_urltestdata.json", "ada_url_data"),
      ("urltestdata-javascript-only.json", "javascript_url_data"),
      ("setters_tests.json", "wpt_setter_data"),
      ("ada_extra_setters_tests.json", "ada_setter_data"),
      ("toascii.json", "wpt_ascii_data"),
      ("IdnaTestV2.json", "idna_v2_data"),
      ("ada_long_urltestdata.json", "long_url_data"),
      ("verifydnslength_tests.json", "dns_length_data"),
    ] {
    let contents = @fs.read_text("\{root}/tests/wpt/\{file}")
    @fs.write_text("url/\{name}_test.mbt", source(name, contents))
    println("Embedded \{file}")
  }
}
