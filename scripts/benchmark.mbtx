----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
/// Reads an optional runner environment value without exposing credentials.
fn environment(name : String) -> String {
  @env.get_env_var(name).unwrap_or("")
}

///|
/// Runs an explicit program and returns its checked standard output.
async fn capture(program : String, arguments : Array[String]) -> String {
  let output = @shell.Cmd(program, arguments).output(max_output_bytes=2097152)
  if output.exit_code() != 0 {
    fail("Command failed: \{program}\n\{output.stderr()}")
  }
  output.stdout().trim().to_owned()
}

///|
/// Identifies the operating system for a CI or local benchmark run.
async fn operating_system() -> String {
  match environment("RUNNER_OS") {
    "Windows" => "windows"
    "Linux" => "linux"
    "macOS" => "macos"
    _ =>
      if environment("OS") == "Windows_NT" {
        "windows"
      } else {
        match capture("uname", ["-s"]) {
          "Linux" => "linux"
          "Darwin" => "macos"
          other => fail("Unsupported benchmark host: \{other}")
        }
      }
  }
}

///|
/// Records a UTC timestamp using the host's standard date provider.
async fn timestamp(os : String) -> String {
  if os == "windows" {
    capture("powershell.exe", [
      "-NoProfile", "-NonInteractive", "-Command", "[DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ')",
    ])
  } else {
    capture("date", ["-u", "+%Y-%m-%dT%H:%M:%SZ"])
  }
}

///|
/// Captures CPU identity and logical CPU count without assuming a processor family.
async fn cpu_metadata(os : String) -> Json {
  if os == "windows" {
    let raw = capture("powershell.exe", [
      "-NoProfile", "-NonInteractive", "-Command", "Get-CimInstance Win32_Processor | Select-Object -First 1 Name, NumberOfCores, NumberOfLogicalProcessors | ConvertTo-Json -Compress",
    ])
    let details = @json.parse(raw)
    match details {
      {
        "Name": String(model),
        "NumberOfLogicalProcessors": Number(count, ..),
        ..
      } =>
        {
          "model": model,
          "logical_cpus": count,
          "architecture": environment("PROCESSOR_ARCHITECTURE"),
          "details": details,
        }
      _ => fail("Unexpected Windows CPU metadata")
    }
  } else if os == "macos" {
    {
      "model": capture("sysctl", ["-n", "machdep.cpu.brand_string"]),
      "logical_cpus": capture("sysctl", ["-n", "hw.logicalcpu"]),
      "architecture": capture("uname", ["-m"]),
      "system_version": capture("sw_vers", ["-productVersion"]),
    }
  } else {
    let details = @json.parse(capture("lscpu", ["--json"]))
    let mut model = ""
    let mut cpus = ""
    match details {
      { "lscpu": Array(entries), .. } =>
        for entry in entries {
          match entry {
            { "field": String("Model name:"), "data": String(value), .. } =>
              model = value
            { "field": String("CPU(s):"), "data": String(value), .. } =>
              cpus = value
            _ => ()
          }
        }
      _ => fail("Unexpected Linux CPU metadata")
    }
    guard model != "" && cpus != "" else { fail("Missing Linux CPU identity") }
    {
      "model": model,
      "logical_cpus": cpus,
      "architecture": capture("uname", ["-m"]),
      "details": details,
    }
  }
}

///|
/// Extracts named structured summaries from the benchmark program's output.
fn summaries(output : String) -> Array[Json] raise {
  let records = []
  let names : Map[String, Unit] = Map([])
  let marker = "BENCHMARK_RESULTS "
  for line in output.split("\n") {
    if line.find(marker) is Some(position) {
      match @json.parse(line[position + marker.length():].trim()) {
        Array(values) =>
          for value in values {
            match value {
              {
                "name": String(name),
                "mean": Number(mean, ..),
                "runs": Number(runs, ..),
                "batch_size": Number(batch, ..),
                ..
              } => {
                guard !names.contains(name) &&
                  mean.is_finite() &&
                  mean > 0 &&
                  runs == 10 &&
                  batch >= 1 else {
                  fail("Invalid or duplicate benchmark: \{name}")
                }
                names[name] = ()
                records.push(value)
              }
              _ => fail("Malformed benchmark summary")
            }
          }
        _ => fail("Benchmark marker did not contain a JSON array")
      }
    }
  }
  guard !records.is_empty() else {
    fail("No structured benchmark results were produced")
  }
  records
}

///|
/// Defines every Base64 case and the actual input/output lengths behind its binary-size label.
fn base64_inventory() -> Map[String, Json] {
  let cases : Map[String, Json] = Map([])
  fn add(
    workload : String,
    implementation : String,
    variant : String,
    length : Int32,
    padding : Bool,
    offset : Int32,
  ) -> Unit {
    let tail = length % 3
    let encoded = length / 3 * 4 +
      (if tail == 0 { 0 } else if padding { 4 } else { tail + 1 })
    let encoding = workload.has_prefix("encode-")
    let text_input = workload == "decode-" + variant
    cases["\{workload}:\{implementation}:\{length}:\{offset}"] = {
      "binary_bytes": length,
      "input_bytes": if encoding {
        length
      } else {
        encoded
      },
      "input_code_units": if text_input {
        encoded
      } else {
        0
      },
      "output_bytes": if encoding {
        encoded
      } else if workload.has_prefix("check-") {
        0
      } else {
        length
      },
      "input_offset": offset,
      "offset_unit": if text_input {
        "utf16-code-units"
      } else {
        "bytes"
      },
      "variant": variant,
    }
  }
  for variant in ["standard", "standard-no-pad", "url-safe", "url-safe-no-pad"] {
    let padding = variant == "standard" || variant == "url-safe"
    let sizes = if variant == "standard" {
      [0, 1, 2, 3, 16, 64, 4096, 1048576]
    } else {
      [2, 4096]
    }
    for length in sizes {
      for
        implementation in [
          "own-scalar", "own-simd", "core", "gmlewis", "kujirahand", "moonbase",
        ] {
        if implementation != "kujirahand" || variant == "standard" {
          if implementation != "kujirahand" || length <= 4096 {
            add(
              "encode-" + variant,
              implementation,
              variant,
              length,
              padding,
              0,
            )
          }
          add("decode-" + variant, implementation, variant, length, padding, 0)
        }
      }
    }
  }
  for length in [64, 1048576] {
    for
      implementation in [
        "own-scalar", "own-simd", "core", "gmlewis", "kujirahand", "moonbase",
      ] {
      if implementation != "kujirahand" || length <= 4096 {
        add("encode-standard", implementation, "standard", length, true, 1)
      }
      add("decode-standard", implementation, "standard", length, true, 1)
    }
    for implementation in ["own-scalar", "own-simd", "moonbase"] {
      add("decode-bytes-standard", implementation, "standard", length, true, 0)
    }
    for implementation in ["own-scalar", "own-simd"] {
      for
        workload in [
          "encode-into-standard", "decode-into-standard", "decode-inplace-standard",
          "check-standard",
        ] {
        add(workload, implementation, "standard", length, true, 0)
      }
    }
  }
  cases
}

///|
/// Rejects substituted Base64 workloads and annotates every result with exact byte/code-unit counts.
fn annotate_base64(records : Array[Json]) -> Unit raise {
  let expected = base64_inventory()
  guard records.length() == expected.length() && expected.length() == 200 else {
    fail("Expected 200 Base64 benchmark cases")
  }
  for record in records {
    match record {
      Object(fields) => {
        guard fields.get("name") is Some(String(name)) else {
          fail("Missing Base64 case name")
        }
        guard expected.get(name) is Some(Object(metadata)) else {
          fail("Unexpected or duplicate Base64 case: \{name}")
        }
        expected.remove(name)
        for (key, value) in metadata {
          fields[key] = value
        }
      }
      _ => fail("Malformed Base64 benchmark record")
    }
  }
  guard expected.is_empty() else { fail("Incomplete Base64 inventory") }
}

///|
/// Runs each backend sequentially and writes reproducible result and log artifacts.
async fn main {
  let arguments = @env.args()
  let requested = if arguments.length() >= 2 {
    arguments[1:].to_owned()
  } else {
    match environment("BENCHMARK_SCOPE") {
      "all" => ["crc32", "url", "base64"]
      "base64" => ["base64"]
      "crc32" => ["crc32"]
      "url" => ["url"]
      _ => fail("Usage: moon run scripts/benchmark.mbtx <module>...")
    }
  }
  let os = operating_system()
  let cpu = cpu_metadata(os)
  let toolchain = capture("moon", ["version", "--all"])
  let node = capture("node", ["--version"])
  let revision = if environment("GITHUB_SHA") != "" {
    environment("GITHUB_SHA")
  } else {
    capture("git", ["rev-parse", "HEAD"]) catch {
      _ => "uncommitted"
    }
  }
  let repository = environment("GITHUB_REPOSITORY")
  let run_id = environment("GITHUB_RUN_ID")
  let run_url = if run_id == "" {
    ""
  } else {
    "https://github.com/\{repository}/actions/runs/\{run_id}"
  }
  for package_dir in requested {
    guard package_dir != "" &&
      package_dir != "." &&
      package_dir != ".." &&
      package_dir.find("/") is None &&
      package_dir.find("\\") is None else {
      fail("A module must be a direct workspace module directory")
    }
    let directory = "_build/benchmarks/\{package_dir}"
    @fs.mkdir("\{directory}/\{os}", recursive=true, allow_existing=true)
    let backends : Array[Json] = []
    let selected = environment("BENCHMARK_BACKENDS")
    let targets = if selected == "" {
      ["native", "wasm", "wasm-gc", "js"]
    } else {
      selected.split(",").map(value => value.to_owned()).to_array()
    }
    for backend in targets {
      guard ["native", "wasm", "wasm-gc", "js"].contains(backend) else {
        fail("Unsupported benchmark backend")
      }
      let command = if package_dir == "url" {
        [
          "-C", "benchmarks", "bench", "--target", backend, "--release", "--no-parallelize",
          "-p", "justjavac/benchmarks/url/own", "-p", "justjavac/benchmarks/url/tonyfettes",
          "-p", "justjavac/benchmarks/url/moonbitstack", "-p", "justjavac/benchmarks/url/connect0459",
        ]
      } else if package_dir == "base64" {
        [
          "-C", "benchmarks", "bench", "--target", backend, "--release", "--no-parallelize",
          "-p", "justjavac/benchmarks/base64",
        ]
      } else {
        [
          "bench",
          "--target",
          backend,
          "--release",
          "--no-parallelize",
          "-p",
          "justjavac/\{package_dir}",
        ]
      }
      println("Benchmarking \{package_dir} on \{os}/\{backend}")
      let started = timestamp(os)
      let output = @shell.Cmd("moon", command).output(max_output_bytes=2097152)
      @fs.write_text(
        "\{directory}/\{os}/\{backend}.log",
        output.stdout() + output.stderr(),
      )
      guard output.exit_code() == 0 else {
        fail(
          "Benchmark failed for \{package_dir}/\{backend}; see the saved log",
        )
      }
      let records = summaries(output.stdout())
      guard package_dir != "crc32" || records.length() == 69 else {
        fail("Expected 69 crc32 cases, received \{records.length()}")
      }
      guard package_dir != "url" || records.length() == 144 else {
        fail("Expected 144 URL cases, received \{records.length()}")
      }
      if package_dir == "base64" {
        annotate_base64(records)
      }
      let mut recorded_command = "moon " + command.join(" ")
      if package_dir == "crc32" {
        let comparison_command = [
          "-C", "benchmarks", "bench", "--target", backend, "--release", "--no-parallelize",
          "-p", "justjavac/benchmarks",
        ]
        println("Comparing external CRC32 libraries on \{os}/\{backend}")
        let comparison = @shell.Cmd("moon", comparison_command).output(
          max_output_bytes=2097152,
        )
        @fs.write_text(
          "\{directory}/\{os}/\{backend}-comparison.log",
          comparison.stdout() + comparison.stderr(),
        )
        guard comparison.exit_code() == 0 else {
          fail("Cross-library benchmark failed")
        }
        let comparison_records = summaries(comparison.stdout())
        guard comparison_records.length() == 138 else {
          fail(
            "Expected 138 comparison cases, received \{comparison_records.length()}",
          )
        }
        for value in comparison_records {
          records.push(value)
        }
        recorded_command = recorded_command +
          "\nmoon " +
          comparison_command.join(" ")
      }
      backends.push({
        "backend": backend,
        "command": recorded_command,
        "started_at_utc": started,
        "finished_at_utc": timestamp(os),
        "time_unit": "microseconds",
        "summaries": Json(records),
      })
    }
    let result : Json = {
      "schema_version": 1,
      "module": "justjavac/\{package_dir}",
      "source": if run_id == "" {
        "local"
      } else {
        "github-actions"
      },
      "source_commit": revision,
      "repository": repository,
      "run_id": run_id,
      "run_attempt": environment("GITHUB_RUN_ATTEMPT"),
      "run_url": run_url,
      "os": os,
      "runner_label": environment("BENCHMARK_RUNNER_LABEL"),
      "image_os": environment("ImageOS"),
      "image_version": environment("ImageVersion"),
      "cpu": cpu,
      "toolchain": toolchain,
      "node": node,
      "module_manifest": @fs.read_text("\{package_dir}/moon.mod"),
      "comparison_manifest": @fs.read_text("benchmarks/moon.mod"),
      "dependency_tree": capture("moon", ["-C", "benchmarks", "tree"]),
      "working_tree_dirty": if run_id == "" {
        capture("git", ["status", "--porcelain"]) != ""
      } else {
        false
      },
      "comparison_dependencies": if package_dir == "base64" {
        [
          {
            "label": "core",
            "package": "moonbitlang/core/encoding/base64",
            "version": "toolchain-bundled",
            "license": "Apache-2.0",
            "api": "encode(BytesView), decode(StringView)",
          },
          {
            "label": "gmlewis",
            "package": "gmlewis/base64",
            "version": "0.16.15",
            "license": "Apache-2.0",
            "api": "std/url_encode2str(FixedArray), std/url_decode2bytes(String)",
          },
          {
            "label": "kujirahand",
            "package": "kujirahand/base64",
            "version": "0.1.1",
            "license": "Apache-2.0",
            "api": "encode_bytes(Bytes), decode_bytes(String)",
          },
          {
            "label": "moonbase",
            "package": "moonbitstack/moonbase/base64",
            "version": "0.5.1",
            "license": "Apache-2.0",
            "api": "encode(BytesView), decode(StringView)/decode_bytes(BytesView), strict=true",
          },
        ]
      } else if package_dir == "url" {
        [
          {
            "label": "tonyfettes",
            "package": "tonyfettes/url",
            "version": "0.3.5",
            "license": "Apache-2.0",
            "api": "Url::parse(StringView), href",
          },
          {
            "label": "moonbitstack",
            "package": "moonbitstack/moonurl",
            "version": "0.3.1",
            "license": "Apache-2.0",
            "api": "Url::decode(syntax=Whatwg), encode",
          },
          {
            "label": "connect0459",
            "package": "connect0459/urllib/url",
            "version": "0.6.0",
            "license": "Apache-2.0",
            "api": "parse(String), parse_with_base, href",
          },
        ]
      } else {
        [
          {
            "label": "gaato",
            "package": "gaato/crc",
            "version": "0.1.1",
            "license": "Apache-2.0",
            "api": "crc32_update(0, data)",
          },
          {
            "label": "gmlewis",
            "package": "gmlewis/crc32",
            "version": "0.9.3",
            "license": "Apache-2.0",
            "api": "Digest::new, write(Byte), digest",
          },
          {
            "label": "kujirahand",
            "package": "kujirahand/crc32",
            "version": "0.1.1",
            "license": "MIT",
            "api": "checksum(Bytes), CRC32Stream",
          },
          {
            "label": "mooncrypt",
            "package": "moonbitstack/mooncrypt/sum/crc32",
            "version": "0.5.2",
            "license": "Apache-2.0",
            "api": "crc32(data, kind=Ieee), Crc32",
          },
        ]
      },
      "backends": Json(backends),
    }
    @fs.write_text("\{directory}/\{os}.json", result.stringify(indent=2))
    println("Saved \{directory}/\{os}.json")
  }
}
