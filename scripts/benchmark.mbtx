----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}
----

///|
/// Reads an optional runner environment value without exposing credentials.
fn environment(name : String) -> String {
  @env.get_env_var(name).unwrap_or("")
}

///|
/// Runs an explicit program and returns its checked standard output.
async fn capture(program : String, arguments : Array[String]) -> String {
  let output = @shell.Cmd(program, arguments).output(max_output_bytes=2097152)
  if output.exit_code() != 0 {
    fail("Command failed: \{program}\n\{output.stderr()}")
  }
  output.stdout().trim().to_owned()
}

///|
/// Identifies the operating system for a CI or local benchmark run.
async fn operating_system() -> String {
  match environment("RUNNER_OS") {
    "Windows" => "windows"
    "Linux" => "linux"
    "macOS" => "macos"
    _ =>
      if environment("OS") == "Windows_NT" {
        "windows"
      } else {
        match capture("uname", ["-s"]) {
          "Linux" => "linux"
          "Darwin" => "macos"
          other => fail("Unsupported benchmark host: \{other}")
        }
      }
  }
}

///|
/// Records a UTC timestamp using the host's standard date provider.
async fn timestamp(os : String) -> String {
  if os == "windows" {
    capture("powershell.exe", [
      "-NoProfile", "-NonInteractive", "-Command", "[DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ')",
    ])
  } else {
    capture("date", ["-u", "+%Y-%m-%dT%H:%M:%SZ"])
  }
}

///|
/// Captures CPU identity and logical CPU count without assuming a processor family.
async fn cpu_metadata(os : String) -> Json {
  if os == "windows" {
    let raw = capture("powershell.exe", [
      "-NoProfile", "-NonInteractive", "-Command", "Get-CimInstance Win32_Processor | Select-Object -First 1 Name, NumberOfCores, NumberOfLogicalProcessors | ConvertTo-Json -Compress",
    ])
    let details = @json.parse(raw)
    match details {
      {
        "Name": String(model),
        "NumberOfLogicalProcessors": Number(count, ..),
        ..
      } =>
        {
          "model": model,
          "logical_cpus": count,
          "architecture": environment("PROCESSOR_ARCHITECTURE"),
          "details": details,
        }
      _ => fail("Unexpected Windows CPU metadata")
    }
  } else if os == "macos" {
    {
      "model": capture("sysctl", ["-n", "machdep.cpu.brand_string"]),
      "logical_cpus": capture("sysctl", ["-n", "hw.logicalcpu"]),
      "architecture": capture("uname", ["-m"]),
      "system_version": capture("sw_vers", ["-productVersion"]),
    }
  } else {
    let details = @json.parse(capture("lscpu", ["--json"]))
    let mut model = ""
    let mut cpus = ""
    match details {
      { "lscpu": Array(entries), .. } =>
        for entry in entries {
          match entry {
            { "field": String("Model name:"), "data": String(value), .. } =>
              model = value
            { "field": String("CPU(s):"), "data": String(value), .. } =>
              cpus = value
            _ => ()
          }
        }
      _ => fail("Unexpected Linux CPU metadata")
    }
    guard model != "" && cpus != "" else { fail("Missing Linux CPU identity") }
    {
      "model": model,
      "logical_cpus": cpus,
      "architecture": capture("uname", ["-m"]),
      "details": details,
    }
  }
}

///|
/// Extracts named structured summaries from the benchmark program's output.
fn summaries(output : String) -> Array[Json] raise {
  let records = []
  let names : Map[String, Unit] = Map([])
  let marker = "BENCHMARK_RESULTS "
  for line in output.split("\n") {
    if line.find(marker) is Some(position) {
      match @json.parse(line[position + marker.length():].trim()) {
        Array(values) =>
          for value in values {
            match value {
              {
                "name": String(name),
                "mean": Number(mean, ..),
                "runs": Number(runs, ..),
                "batch_size": Number(batch, ..),
                ..
              } => {
                guard !names.contains(name) &&
                  mean.is_finite() &&
                  mean > 0 &&
                  runs == 10 &&
                  batch >= 1 else {
                  fail("Invalid or duplicate benchmark: \{name}")
                }
                names[name] = ()
                records.push(value)
              }
              _ => fail("Malformed benchmark summary")
            }
          }
        _ => fail("Benchmark marker did not contain a JSON array")
      }
    }
  }
  guard !records.is_empty() else {
    fail("No structured benchmark results were produced")
  }
  records
}

///|
/// Defines every Base64 case and the actual input/output lengths behind its binary-size label.
fn base64_inventory() -> Map[String, Json] {
  let cases : Map[String, Json] = Map([])
  fn add(
    workload : String,
    implementation : String,
    variant : String,
    length : Int32,
    padding : Bool,
    offset : Int32,
  ) -> Unit {
    let tail = length % 3
    let encoded = length / 3 * 4 +
      (if tail == 0 { 0 } else if padding { 4 } else { tail + 1 })
    let encoding = workload.has_prefix("encode-")
    let text_input = workload == "decode-" + variant
    cases["\{workload}:\{implementation}:\{length}:\{offset}"] = {
      "binary_bytes": length,
      "input_bytes": if encoding {
        length
      } else {
        encoded
      },
      "input_code_units": if text_input {
        encoded
      } else {
        0
      },
      "output_bytes": if encoding {
        encoded
      } else if workload.has_prefix("check-") {
        0
      } else {
        length
      },
      "input_offset": offset,
      "offset_unit": if text_input {
        "utf16-code-units"
      } else {
        "bytes"
      },
      "variant": variant,
    }
  }
  for variant in ["standard", "standard-no-pad", "url-safe", "url-safe-no-pad"] {
    let padding = variant == "standard" || variant == "url-safe"
    let sizes = if variant == "standard" {
      [0, 1, 2, 3, 16, 64, 4096, 1048576]
    } else {
      [2, 4096]
    }
    for length in sizes {
      for
        implementation in [
          "own-scalar", "own-simd", "core", "gmlewis", "kujirahand", "moonbase",
        ] {
        if implementation != "kujirahand" || variant == "standard" {
          if implementation != "kujirahand" || length <= 4096 {
            add(
              "encode-" + variant,
              implementation,
              variant,
              length,
              padding,
              0,
            )
          }
          add("decode-" + variant, implementation, variant, length, padding, 0)
        }
      }
    }
  }
  for length in [64, 1048576] {
    for
      implementation in [
        "own-scalar", "own-simd", "core", "gmlewis", "kujirahand", "moonbase",
      ] {
      if implementation != "kujirahand" || length <= 4096 {
        add("encode-standard", implementation, "standard", length, true, 1)
      }
      add("decode-standard", implementation, "standard", length, true, 1)
    }
    for implementation in ["own-scalar", "own-simd", "moonbase"] {
      add("decode-bytes-standard", implementation, "standard", length, true, 0)
    }
    for implementation in ["own-scalar", "own-simd"] {
      for
        workload in [
          "encode-into-standard", "decode-into-standard", "decode-inplace-standard",
          "check-standard",
        ] {
        add(workload, implementation, "standard", length, true, 0)
      }
    }
  }
  cases
}

///|
/// Rejects substituted Base64 workloads and annotates every result with exact byte/code-unit counts.
fn annotate_base64(records : Array[Json]) -> Unit raise {
  let expected = base64_inventory()
  guard records.length() == expected.length() && expected.length() == 200 else {
    fail("Expected 200 Base64 benchmark cases")
  }
  for record in records {
    match record {
      Object(fields) => {
        guard fields.get("name") is Some(String(name)) else {
          fail("Missing Base64 case name")
        }
        guard expected.get(name) is Some(Object(metadata)) else {
          fail("Unexpected or duplicate Base64 case: \{name}")
        }
        expected.remove(name)
        for (key, value) in metadata {
          fields[key] = value
        }
      }
      _ => fail("Malformed Base64 benchmark record")
    }
  }
  guard expected.is_empty() else { fail("Incomplete Base64 inventory") }
}

///|
/// Defines every UUID operation, spelling, implementation, length, and offset.
fn expected_uuid_names() -> Map[String, Unit] {
  let names : Map[String, Unit] = Map([])
  let implementations = [
    "own-scalar", "own-simd", "bobzhang", "f4ah6o", "moonbitstack", "wulisususu",
  ]
  for
    (label, length) in [
      ("simple", 32),
      ("hyphenated", 36),
      ("mixed", 36),
      ("nil", 36),
      ("max", 36),
      ("braced", 38),
      ("urn", 45),
    ] {
    let offsets = if label == "simple" || label == "hyphenated" {
      [0, 1]
    } else {
      [0]
    }
    for implementation in implementations {
      if label == "braced" &&
        (implementation == "bobzhang" || implementation == "f4ah6o") {
        continue
      }
      for offset in offsets {
        for operation in ["parse", "roundtrip"] {
          names["\{operation}-\{label}:\{implementation}:\{length}:\{offset}"] = ()
        }
      }
    }
  }
  for implementation in implementations {
    names["format-hyphenated:\{implementation}:16:0"] = ()
    if implementation != "wulisususu" {
      names["format-simple:\{implementation}:16:0"] = ()
    }
    for
      (label, length) in [
        ("empty", 0),
        ("short", 31),
        ("start", 36),
        ("end", 36),
      ] {
      names["invalid-\{label}:\{implementation}:\{length}:0"] = ()
    }
    for
      (operation, length) in [
        ("parse", 36864),
        ("roundtrip", 36864),
        ("format", 16384),
      ] {
      names["\{operation}-batch1024:\{implementation}:\{length}:0"] = ()
    }
  }
  for implementation in ["own-scalar", "own-simd"] {
    for spelling in ["simple", "hyphenated"] {
      names["format-\{spelling}-upper:\{implementation}:16:0"] = ()
      for case in ["lower", "upper"] {
        for offset in [0, 1] {
          names["write-\{spelling}-\{case}:\{implementation}:16:\{offset}"] = ()
        }
      }
    }
    for
      (label, length) in [
        ("simple", 32),
        ("hyphenated", 36),
        ("braced", 38),
        ("urn", 45),
      ] {
      for offset in [0, 1] {
        names["parse-bytes-\{label}:\{implementation}:\{length}:\{offset}"] = ()
      }
    }
  }
  names
}

///|
/// Rejects missing or substituted UUID cases before accepting their measurements.
fn validate_uuid_inventory(records : Array[Json]) -> Unit raise {
  let expected = expected_uuid_names()
  guard expected.length() == 193 && records.length() == expected.length() else {
    fail("Expected exactly 193 UUID cases")
  }
  for record in records {
    match record {
      { "name": String(name), .. } => {
        guard expected.contains(name) else {
          fail("Unexpected UUID benchmark: \{name}")
        }
        let _ = expected.remove(name)
      }
      _ => fail("Missing UUID case name")
    }
  }
  guard expected.is_empty() else { fail("Incomplete UUID inventory") }
}

///|
/// Records exact input and output lengths, UUID counts, and offset units per case.
fn add_uuid_metadata(records : Array[Json]) -> Unit raise {
  for record in records {
    guard record is Object(fields) && fields.get("name") is Some(String(name)) else {
      fail("Missing UUID summary object")
    }
    let pieces = name.split(":").map(view => view.to_owned()).to_array()
    guard pieces.length() == 4 else { fail("Invalid UUID case name") }
    let operation = pieces[0]
    let length = @string.parse_int(pieces[2])
    let offset = @string.parse_int(pieces[3])
    let count = if operation.find("batch1024") is Some(_) { 1024 } else { 1 }
    let writing = operation.find("write-") is Some(0)
    let byte_input = operation.find("parse-bytes-") is Some(0)
    let text_input = !byte_input &&
      (
        operation.find("parse-") is Some(0) ||
        operation.find("roundtrip-") is Some(0) ||
        operation.find("invalid-") is Some(0)
      )
    let output = if operation.find("invalid-") is Some(0) {
      0
    } else if operation.find("simple") is Some(_) &&
      (operation.find("format-") is Some(0) || writing) {
      32 * count
    } else if operation.find("roundtrip-") is Some(0) ||
      operation.find("format-") is Some(0) ||
      writing {
      36 * count
    } else {
      16 * count
    }
    fields["input_bytes"] = Json(length)
    fields["input_code_units"] = if text_input { Json(length) } else { null }
    fields["uuid_count"] = Json(count)
    fields["output_bytes"] = Json(output)
    fields["input_offset"] = Json(if writing { 0 } else { offset })
    fields["output_offset"] = Json(if writing { offset } else { 0 })
    fields["offset_unit"] = Json(
      if writing {
        "output-bytes"
      } else if text_input {
        "utf16-code-units"
      } else {
        "input-bytes"
      },
    )
  }
}

///|
/// Defines the exact integer workloads, byte counts, variants, and view offsets.
fn expected_atoi_names() -> Map[String, Unit] {
  let expected : Map[String, Unit] = Map([])
  for
    (label, length, partial, compare_core) in [
      ("parse-u32-short", 1, false, true),
      ("parse-u32-max", 10, false, true),
      ("parse-u64-short", 1, false, true),
      ("parse-u64-eight", 8, false, true),
      ("parse-u64-sixteen", 16, true, true),
      ("parse-u64-max", 20, true, true),
      ("parse-i64-short", 2, false, true),
      ("parse-i64-sixteen", 17, true, true),
      ("parse-i64-max", 19, false, true),
      ("parse-i64-min", 20, true, true),
      ("parse-u128-sixteen", 16, false, true),
      ("parse-u128-thirtytwo", 32, true, true),
      ("parse-u128-max", 39, true, true),
      ("parse-i128-short", 2, false, true),
      ("parse-i128-thirtytwo", 33, true, true),
      ("parse-i128-min", 40, true, true),
      ("parse-u64-plus-zeroes", 83, false, true),
      ("parse-i128-plus-zeroes", 83, false, true),
      ("parse-u64-zeroes-4k", 4096, false, true),
      ("parse-u64-zeroes-1m", 1048576, false, true),
      ("prefix-u64-sixteen", 21, true, true),
      ("prefix-i64-min", 25, false, true),
      ("prefix-u128-max", 44, false, true),
      ("prefix-i128-min", 45, false, true),
      ("invalid-u64-empty", 0, false, true),
      ("invalid-u64-start", 4, false, true),
      ("invalid-u64-end", 17, false, true),
      ("invalid-u64-byte", 17, false, true),
      ("overflow-u64", 20, false, true),
      ("overflow-u32-large", 65536, false, true),
      ("overflow-u128", 39, false, true),
      ("size-u64", 64, false, false),
    ] {
    let offsets = if partial { [0, 1, 3, 15] } else { [0] }
    let implementations = if compare_core {
      ["own-scalar", "own-simd", "core"]
    } else {
      ["own-scalar", "own-simd"]
    }
    for implementation in implementations {
      for offset in offsets {
        expected["\{label}:\{implementation}:\{length}:\{offset}"] = ()
      }
    }
  }
  expected
}

///|
/// Rejects missing or substituted integer cases before preserving benchmark data.
fn validate_atoi_inventory(records : Array[Json]) -> Unit raise {
  let expected = expected_atoi_names()
  guard records.length() == expected.length() else {
    fail("Expected 176 integer cases")
  }
  for record in records {
    match record {
      { "name": String(name), .. } => {
        guard expected.contains(name) else {
          fail("Unexpected integer case: " + name)
        }
        let _ = expected.remove(name)
      }
      _ => fail("Missing integer case name")
    }
  }
  guard expected.is_empty() else { fail("Incomplete integer case inventory") }
}

///|
/// Extracts the bundled core's compiler version without platform-specific executable paths.
fn bundled_core_version(toolchain : String) -> String raise {
  for line in toolchain.split("\n") {
    if line.find("moonc ") is Some(0) && line.find(")") is Some(end) {
      return line[:end + 1].to_owned()
    }
  }
  fail("Missing compiler version for the bundled core comparison")
}

///|
/// Defines exact UTF-8 workloads, byte counts, modes, view offsets, and stream sizes.
fn expected_utf8_names() -> Map[String, Unit] {
  let expected : Map[String, Unit] = Map([])
  for
    (label, length) in [
      ("empty", 0),
      ("ascii-15", 15),
      ("ascii-64", 64),
      ("ascii-4k", 4096),
      ("ascii-1m", 1048576),
      ("latin-4k", 4096),
      ("cjk-4k", 4095),
      ("emoji-4k", 4096),
      ("mixed-4k", 4096),
      ("cjk-1m", 1048575),
      ("emoji-1m", 1048576),
    ] {
    let offsets = if ["ascii-4k", "cjk-4k", "emoji-4k"].contains(label) {
      [0, 1]
    } else {
      [0]
    }
    for prefix in ["validate-", "decode-"] {
      let implementations = if prefix == "validate-" {
        [
          "own-basic-scalar", "own-basic-simd", "own-compat", "tonyfettes", "core",
        ]
      } else {
        ["own-scalar", "own-simd", "tonyfettes", "core"]
      }
      for implementation in implementations {
        for offset in offsets {
          expected["\{prefix}\{label}:\{implementation}:\{length}:\{offset}"] = ()
        }
      }
    }
  }
  for
    label in [
      "invalid-start", "invalid-end", "invalid-overlong", "invalid-truncated",
    ] {
    for
      implementation in [
        "own-basic-scalar", "own-basic-simd", "own-compat", "tonyfettes", "core",
      ] {
      expected["\{label}:\{implementation}:65536:0"] = ()
    }
  }
  for label in ["ascii", "mixed"] {
    for implementation in ["own-scalar", "own-simd"] {
      for chunk in [1, 64, 4096] {
        expected["stream-\{label}:\{implementation}:65536:\{chunk}"] = ()
      }
    }
  }
  expected
}

///|
/// Rejects omitted or substituted UTF-8 cases before saving a measurement artifact.
fn validate_utf8_inventory(records : Array[Json]) -> Unit raise {
  let expected = expected_utf8_names()
  guard records.length() == expected.length() else {
    fail("Expected 158 UTF-8 cases")
  }
  for record in records {
    match record {
      { "name": String(name), .. } => {
        guard expected.contains(name) else {
          fail("Unexpected UTF-8 case: \{name}")
        }
        let _ = expected.remove(name)
      }
      _ => fail("Missing UTF-8 case name")
    }
  }
  guard expected.is_empty() else { fail("Incomplete UTF-8 inventory") }
}

///|
/// Defines every Ryu operation, precision, input size, implementation, and view offset.
fn expected_ryu_names() -> Map[String, Unit] {
  let expected : Map[String, Unit] = Map([])
  for
    (labels, bytes) in [
      (
        [
          "d2s-zero", "d2s-short", "d2s-pi", "d2s-smallint", "d2s-subnormal", "d2s-max",
          "d2s-small", "d2s-large",
        ],
        8,
      ),
      (["f2s-zero", "f2s-short", "f2s-pi", "f2s-subnormal", "f2s-max"], 4),
    ] {
    for label in labels {
      for implementation in ["own", "core"] {
        expected["\{label}:\{implementation}:\{bytes}:0"] = ()
      }
    }
  }
  for kind in ["fixed", "exp"] {
    for precision in [0, 6, 17, 100, 1000] {
      expected["\{kind}-short-\{precision}:own:8:0"] = ()
    }
  }
  for
    label in [
      "fixed-subnormal-324", "fixed-subnormal-1074", "fixed-large-0", "fixed-large-6",
      "fixed-carry-2", "exp-subnormal-6", "exp-subnormal-324", "exp-large-6", "exp-carry-1",
    ] {
    expected["\{label}:own:8:0"] = ()
  }
  for
    (label, length, partial) in [
      ("s2d-short", 17, false),
      ("s2d-integer", 16, false),
      ("s2d-subnormal", 23, false),
      ("s2d-max", 22, false),
      ("s2d-offset", 6, true),
      ("s2d-invalid", 4, false),
      ("s2d-zeroes", 81, false),
      ("s2f-short", 9, false),
      ("s2f-integer", 8, false),
      ("s2f-subnormal", 14, false),
      ("s2f-max", 13, false),
      ("s2f-offset", 6, true),
      ("s2f-invalid", 4, false),
      ("s2f-zeroes", 73, false),
    ] {
    for offset in (if partial { [0, 1, 3, 15] } else { [0] }) {
      for implementation in ["own", "core"] {
        expected["\{label}:\{implementation}:\{length}:\{offset}"] = ()
      }
    }
  }
  expected
}

///|
/// Rejects missing, duplicated, or substituted Ryu operations, precisions, and offsets.
fn validate_ryu_inventory(records : Array[Json]) -> Unit raise {
  let expected = expected_ryu_names()
  guard records.length() == expected.length() else {
    fail("Expected 85 Ryu cases")
  }
  for record in records {
    guard record is { "name": String(name), .. } && expected.contains(name) else {
      fail("Unexpected or duplicate Ryu benchmark")
    }
    let _ = expected.remove(name)
  }
  guard expected.is_empty() else { fail("Incomplete Ryu inventory") }
}

///|
/// Defines every memchr workload, API variant, byte length, and offset independently.
fn expected_memchr_names() -> Map[String, Unit] {
  let expected : Map[String, Unit] = Map([])
  for
    (label, length, partial) in [
      ("empty", 0, false),
      ("short-hit", 15, false),
      ("short-miss", 15, false),
      ("tail-hit", 65, false),
      ("scan-miss", 4096, true),
      ("scan-hit", 4096, true),
      ("huge-hit", 1048576, false),
    ] {
    for arity in 1..<=3 {
      let implementations = if arity == 1 {
        ["own-scalar", "own-simd", "reference", "core"]
      } else {
        ["own-scalar", "own-simd", "reference"]
      }
      for direction in ["memchr", "memrchr"] {
        for implementation in implementations {
          for offset in (if partial { [0, 1, 15] } else { [0] }) {
            expected["\{direction}\{arity}-\{label}:\{implementation}:\{length}:\{offset}"] = ()
          }
        }
      }
    }
  }
  for
    (label, length) in [
      ("count1-dense", 65536),
      ("count3-dense", 65536),
      ("iter1-dense", 4096),
      ("iter3-sparse", 4096),
    ] {
    for implementation in ["own-scalar", "own-simd", "reference"] {
      expected["\{label}:\{implementation}:\{length}:0"] = ()
    }
  }
  for
    (label, length, partial) in [
      ("empty", 4, false),
      ("short-hit", 15, false),
      ("scan-miss", 4096, false),
      ("scan-hit", 4096, true),
      ("long-hit", 8192, false),
      ("periodic-miss", 4096, false),
      ("wide-hit", 16384, false),
    ] {
    for operation in ["find", "rfind", "reuse-find", "reuse-rfind"] {
      let implementations = if operation == "find" || operation == "reuse-find" {
        ["own-scalar", "own-simd", "own-twoway", "core"]
      } else {
        ["own-scalar", "own-simd", "core"]
      }
      for implementation in implementations {
        for offset in (if partial { [0, 1, 15] } else { [0] }) {
          expected["\{operation}-\{label}:\{implementation}:\{length}:\{offset}"] = ()
        }
      }
    }
  }
  for (label, length) in [("overlap", 4096), ("empty", 256)] {
    for operation in ["find-iter", "rfind-iter"] {
      for implementation in ["own-scalar", "own-simd", "reference"] {
        expected["\{operation}-\{label}:\{implementation}:\{length}:0"] = ()
      }
    }
  }
  expected
}

///|
/// Rejects missing, duplicate, or substituted byte-search cases before saving data.
fn validate_memchr_inventory(records : Array[Json]) -> Unit raise {
  let expected = expected_memchr_names()
  guard expected.length() == 370 && records.length() == expected.length() else {
    fail("Expected all 370 memchr cases per backend")
  }
  for record in records {
    match record {
      { "name": String(name), .. } => {
        guard expected.contains(name) else {
          fail("Unexpected memchr case: " + name)
        }
        let _ = expected.remove(name)
      }
      _ => fail("Missing memchr case name")
    }
  }
  guard expected.is_empty() else { fail("Incomplete memchr case inventory") }
}

///|
/// Records exact byte/needle lengths and timed adaptation for the search corpus.
fn memchr_workload_metadata() -> Json {
  {
    "cases_per_backend": 370,
    "name_fields": [
      "operation-and-workload", "implementation", "haystack-bytes", "byte-offset",
    ],
    "byte_needles": [0, 1, 2],
    "byte_input_bytes": [0, 15, 65, 4096, 1048576],
    "partial_view_offsets": [1, 15],
    "partial_view_sentinels": 0,
    "substring_needle_bytes": {
      "empty": 0,
      "short-hit": 3,
      "scan-miss": 3,
      "scan-hit": 3,
      "long-hit": 65,
      "periodic-miss": 33,
      "wide-hit": 257,
    },
    "iteration_needle_bytes": { "overlap": 3, "empty": 0 },
    "byte_count_bytes": 65536,
    "byte_iteration_bytes": 4096,
    "substring_iteration_bytes": { "overlap": 4096, "empty": 256 },
    "timed": "Public calls, one-off finder and iterator construction, lazy consumption, result/implementation adapters, callback dispatch, and keep barriers",
    "prepared": "Immutable bytes, partial views, needles, and reusable forward/reverse finders",
    "core_adaptation": "BytesView.find/rev_find on the same views; core has no explicit reusable Finder or multi-byte-union/iterator API",
    "throughput": "Searches report time per call; only full byte counts read every supplied byte",
  }
}

///|
/// Runs each backend sequentially and writes reproducible result and log artifacts.
async fn main {
  let arguments = @env.args()
  if arguments == [arguments[0], "--self-test"] {
    assert_eq(expected_ryu_names().length(), 85)
    assert_eq(expected_memchr_names().length(), 370)
    wc_inventory_self_test()
    println("Benchmark collector inventory self-test passed")
    return
  }
  let requested = if arguments.length() >= 2 {
    arguments[1:].to_owned()
  } else {
    let scope = environment("BENCHMARK_SCOPE")
    let selector = if scope == "" {
      environment("BENCHMARK_MODULE")
    } else {
      scope
    }
    guard selector != "" else {
      fail("Usage: moon run scripts/benchmark.mbtx <module>... | all")
    }
    [selector]
  }
  let selected_modules = if requested == ["all"] {
    [
      "crc32", "url", "utf8", "base64", "atoi", "argminmax", "uuid", "ryu", "memchr",
      "wc",
    ]
  } else {
    requested
  }
  let os = operating_system()
  let cpu = cpu_metadata(os)
  let toolchain = capture("moon", ["version", "--all"])
  let node = capture("node", ["--version"])
  let revision = if environment("GITHUB_SHA") != "" {
    environment("GITHUB_SHA")
  } else {
    capture("git", ["rev-parse", "HEAD"]) catch {
      _ => "uncommitted"
    }
  }
  let repository = environment("GITHUB_REPOSITORY")
  let run_id = environment("GITHUB_RUN_ID")
  let run_url = if run_id == "" {
    ""
  } else {
    "https://github.com/\{repository}/actions/runs/\{run_id}"
  }
  for package_dir in selected_modules {
    guard package_dir != "" &&
      package_dir != "." &&
      package_dir != ".." &&
      package_dir.find("/") is None &&
      package_dir.find("\\") is None else {
      fail("A module must be a direct workspace module directory")
    }
    let directory = "_build/benchmarks/\{package_dir}"
    let reversed = package_dir == "wc" &&
      environment("WC_BENCHMARK_REVERSE") == "1"
    let log_directory = "\{directory}/\{os}" +
      (if reversed { "-reversed" } else { "" })
    @fs.mkdir(log_directory, recursive=true, allow_existing=true)
    let backends : Array[Json] = []
    let selected = environment("BENCHMARK_BACKENDS")
    let targets = if selected == "" {
      ["native", "wasm", "wasm-gc", "js"]
    } else {
      selected.split(",").map(value => value.to_owned()).to_array()
    }
    for backend in targets {
      guard ["native", "wasm", "wasm-gc", "js"].contains(backend) else {
        fail("Unsupported benchmark backend")
      }
      let command = if package_dir == "memchr" {
        [
          "-C", "benchmarks", "bench", "--target", backend, "--release", "--no-parallelize",
          "-p", "justjavac/benchmarks/memchr",
        ]
      } else if package_dir == "ryu" {
        [
          "-C", "benchmarks", "bench", "--target", backend, "--release", "--no-parallelize",
          "-p", "justjavac/benchmarks/ryu",
        ]
      } else if package_dir == "uuid" {
        [
          "-C", "benchmarks", "bench", "--target", backend, "--release", "--no-parallelize",
          "-p", "justjavac/benchmarks/uuid",
        ]
      } else if package_dir == "url" {
        [
          "-C", "benchmarks", "bench", "--target", backend, "--release", "--no-parallelize",
          "-p", "justjavac/benchmarks/url/own", "-p", "justjavac/benchmarks/url/tonyfettes",
          "-p", "justjavac/benchmarks/url/moonbitstack", "-p", "justjavac/benchmarks/url/connect0459",
        ]
      } else if package_dir == "utf8" {
        [
          "-C", "benchmarks", "bench", "--target", backend, "--release", "--no-parallelize",
          "-p", "justjavac/benchmarks/utf8",
        ]
      } else if package_dir == "atoi" ||
        package_dir == "argminmax" ||
        package_dir == "wc" {
        [
          "-C",
          "benchmarks",
          "bench",
          "--target",
          backend,
          "--release",
          "--no-parallelize",
          "-p",
          "justjavac/benchmarks/" + package_dir,
        ]
      } else if package_dir == "base64" {
        [
          "-C", "benchmarks", "bench", "--target", backend, "--release", "--no-parallelize",
          "-p", "justjavac/benchmarks/base64",
        ]
      } else {
        [
          "bench",
          "--target",
          backend,
          "--release",
          "--no-parallelize",
          "-p",
          "justjavac/\{package_dir}",
        ]
      }
      println("Benchmarking \{package_dir} on \{os}/\{backend}")
      let started = timestamp(os)
      // Direct file redirects retain partial diagnostics if the collector exits early.
      let stdout_log = "\{log_directory}/\{backend}-stdout.log"
      let stderr_log = "\{log_directory}/\{backend}-stderr.log"
      let exit_code = @shell.Cmd(
        "moon",
        command,
        stdout=ToFile(stdout_log),
        stderr=ToFile(stderr_log),
      ).status()
      let stdout = @fs.read_text(stdout_log)
      let stderr = @fs.read_text(stderr_log)
      @fs.write_text("\{log_directory}/\{backend}.log", stdout + stderr)
      guard exit_code == 0 else {
        fail(
          "Benchmark failed for \{package_dir}/\{backend}; see the saved log",
        )
      }
      let records = summaries(stdout)
      if package_dir == "ryu" {
        validate_ryu_inventory(records)
      }
      if package_dir == "memchr" {
        validate_memchr_inventory(records)
      }
      if package_dir == "wc" {
        annotate_wc(records)
      }
      if package_dir == "uuid" {
        validate_uuid_inventory(records)
        add_uuid_metadata(records)
      }
      if package_dir == "utf8" {
        validate_utf8_inventory(records)
      }
      if package_dir == "atoi" {
        validate_atoi_inventory(records)
      }
      if package_dir == "argminmax" {
        validate_argminmax_inventory(records)
      }
      guard package_dir != "crc32" || records.length() == 69 else {
        fail("Expected 69 crc32 cases, received \{records.length()}")
      }
      guard package_dir != "url" || records.length() == 144 else {
        fail("Expected 144 URL cases, received \{records.length()}")
      }
      if package_dir == "base64" {
        annotate_base64(records)
      }
      let mut recorded_command = "moon " + command.join(" ")
      if package_dir == "crc32" {
        let comparison_command = [
          "-C", "benchmarks", "bench", "--target", backend, "--release", "--no-parallelize",
          "-p", "justjavac/benchmarks",
        ]
        println("Comparing external CRC32 libraries on \{os}/\{backend}")
        let comparison = @shell.Cmd("moon", comparison_command).output(
          max_output_bytes=2097152,
        )
        @fs.write_text(
          "\{directory}/\{os}/\{backend}-comparison.log",
          comparison.stdout() + comparison.stderr(),
        )
        guard comparison.exit_code() == 0 else {
          fail("Cross-library benchmark failed")
        }
        let comparison_records = summaries(comparison.stdout())
        guard comparison_records.length() == 138 else {
          fail(
            "Expected 138 comparison cases, received \{comparison_records.length()}",
          )
        }
        for value in comparison_records {
          records.push(value)
        }
        recorded_command = recorded_command +
          "\nmoon " +
          comparison_command.join(" ")
      }
      backends.push({
        "backend": backend,
        "command": recorded_command,
        "started_at_utc": started,
        "finished_at_utc": timestamp(os),
        "time_unit": "microseconds",
        "summaries": Json(records),
      })
    }
    let result : Json = {
      "schema_version": 1,
      "module": "justjavac/\{package_dir}",
      "source": if run_id == "" {
        "local"
      } else {
        "github-actions"
      },
      "source_commit": revision,
      "repository": repository,
      "run_id": run_id,
      "run_attempt": environment("GITHUB_RUN_ATTEMPT"),
      "run_url": run_url,
      "os": os,
      "runner_label": environment("BENCHMARK_RUNNER_LABEL"),
      "image_os": environment("ImageOS"),
      "image_version": environment("ImageVersion"),
      "cpu": cpu,
      "toolchain": toolchain,
      "node": node,
      "module_manifest": @fs.read_text("\{package_dir}/moon.mod"),
      "comparison_manifest": @fs.read_text("benchmarks/moon.mod"),
      "dependency_tree": capture("moon", ["-C", "benchmarks", "tree"]),
      "working_tree_dirty": if run_id == "" {
        capture("git", ["status", "--porcelain"]) != ""
      } else {
        false
      },
      "comparison_dependencies": if package_dir == "wc" {
        [
          {
            "label": "reference",
            "package": "justjavac/benchmarks/wc",
            "version": "0.1.0",
            "license": "MIT",
            "api": "Independent scalar scan counting word ends with explicit ASCII whitespace",
          },
        ]
      } else if package_dir == "memchr" {
        [
          {
            "label": "core",
            "package": "moonbitlang/core/bytes",
            "version": bundled_core_version(toolchain),
            "license": "Apache-2.0",
            "api": "BytesView.find / rev_find, identical prepared byte and needle views",
          },
          {
            "label": "reference",
            "package": "justjavac/benchmarks/memchr",
            "version": "0.1.0",
            "license": "MIT",
            "api": "Independent per-byte search, counts, and non-overlapping substring iteration",
          },
        ]
      } else if package_dir == "ryu" {
        [
          {
            "label": "core-format",
            "package": "moonbitlang/core/builtin",
            "version": bundled_core_version(toolchain),
            "license": "Apache-2.0",
            "api": "Double/Float.to_string with timed Ryu scientific-layout conversion and negative-zero restoration",
          },
          {
            "label": "core-parse",
            "package": "moonbitlang/core/string",
            "version": bundled_core_version(toolchain),
            "license": "Apache-2.0",
            "api": "parse_double(StringView), including Float narrowing for the measured binary32 corpus",
          },
        ]
      } else if package_dir == "uuid" {
        [
          {
            "label": "bobzhang",
            "package": "bobzhang/uuidm",
            "version": "0.2.0",
            "license": "ISC",
            "api": "from_string/from_urn(String), Uuid::to_string/to_string_simple",
          },
          {
            "label": "f4ah6o",
            "package": "f4ah6o/uuidm",
            "version": "0.2.1",
            "license": "ISC",
            "api": "from_string/from_urn(String), Uuid::to_string/to_string_simple; bobzhang fork",
          },
          {
            "label": "moonbitstack",
            "package": "moonbitstack/moonuuid",
            "version": "0.2.1",
            "license": "Apache-2.0",
            "api": "parse(StringView), Uuid::to_string/hex",
          },
          {
            "label": "wulisususu",
            "package": "wulisususu/moonuuid",
            "version": "0.1.0",
            "license": "Apache-2.0",
            "api": "parse_permissive(String), to_string; no compact formatter",
          },
        ]
      } else if package_dir == "base64" {
        [
          {
            "label": "core",
            "package": "moonbitlang/core/encoding/base64",
            "version": "toolchain-bundled",
            "license": "Apache-2.0",
            "api": "encode(BytesView), decode(StringView)",
          },
          {
            "label": "gmlewis",
            "package": "gmlewis/base64",
            "version": "0.16.15",
            "license": "Apache-2.0",
            "api": "std/url_encode2str(FixedArray), std/url_decode2bytes(String)",
          },
          {
            "label": "kujirahand",
            "package": "kujirahand/base64",
            "version": "0.1.1",
            "license": "Apache-2.0",
            "api": "encode_bytes(Bytes), decode_bytes(String)",
          },
          {
            "label": "moonbase",
            "package": "moonbitstack/moonbase/base64",
            "version": "0.5.1",
            "license": "Apache-2.0",
            "api": "encode(BytesView), decode(StringView)/decode_bytes(BytesView), strict=true",
          },
        ]
      } else if package_dir == "argminmax" {
        [
          {
            "label": "baseline",
            "package": "justjavac/benchmarks/argminmax",
            "version": "0.1.0",
            "core_version": bundled_core_version(toolchain),
            "license": "MIT",
            "api": "Independent linear numeric reference; identical prepared typed views and NaN/bitmap semantics",
          },
        ]
      } else if package_dir == "atoi" {
        [
          {
            "label": "core",
            "package": "moonbitlang/core/string",
            "version": bundled_core_version(toolchain),
            "license": "Apache-2.0",
            "api": "parse_uint64 / parse_int64(radix=10), parse_bigint with exact 128-bit range checks",
          },
          {
            "label": "core-conversion",
            "package": "moonbitlang/core/encoding/utf8",
            "version": bundled_core_version(toolchain),
            "license": "Apache-2.0",
            "api": "decode(BytesView, ignore_bom=false), including UTF-16 allocation",
          },
          {
            "label": "core-wide",
            "package": "moonbitlang/core/bigint",
            "version": bundled_core_version(toolchain),
            "license": "Apache-2.0",
            "api": "BigInt comparisons against signed / unsigned 128-bit bounds",
          },
        ]
      } else if package_dir == "url" {
        [
          {
            "label": "tonyfettes",
            "package": "tonyfettes/url",
            "version": "0.3.5",
            "license": "Apache-2.0",
            "api": "Url::parse(StringView), href",
          },
          {
            "label": "moonbitstack",
            "package": "moonbitstack/moonurl",
            "version": "0.3.1",
            "license": "Apache-2.0",
            "api": "Url::decode(syntax=Whatwg), encode",
          },
          {
            "label": "connect0459",
            "package": "connect0459/urllib/url",
            "version": "0.6.0",
            "license": "Apache-2.0",
            "api": "parse(String), parse_with_base, href",
          },
        ]
      } else if package_dir == "utf8" {
        [
          {
            "label": "tonyfettes",
            "package": "tonyfettes/utf8",
            "version": "0.2.4",
            "license": "Apache-2.0",
            "api": "Utf8::of_bytesview, decode",
            "compatibility_copy": "benchmarks/vendor/tonyfettes-utf8",
            "original_source_sha256": "b1e652c7b968cb86ac38b9f9960b11b4b2736803a4f91082ae4d6287e3604690",
          },
          {
            "label": "core",
            "package": "moonbitlang/core/encoding/utf8",
            "version": bundled_core_version(toolchain),
            "license": "Apache-2.0",
            "api": "decode(BytesView, ignore_bom=false), including UTF-16 allocation",
          },
        ]
      } else {
        [
          {
            "label": "gaato",
            "package": "gaato/crc",
            "version": "0.1.1",
            "license": "Apache-2.0",
            "api": "crc32_update(0, data)",
          },
          {
            "label": "gmlewis",
            "package": "gmlewis/crc32",
            "version": "0.9.3",
            "license": "Apache-2.0",
            "api": "Digest::new, write(Byte), digest",
          },
          {
            "label": "kujirahand",
            "package": "kujirahand/crc32",
            "version": "0.1.1",
            "license": "MIT",
            "api": "checksum(Bytes), CRC32Stream",
          },
          {
            "label": "mooncrypt",
            "package": "moonbitstack/mooncrypt/sum/crc32",
            "version": "0.5.2",
            "license": "Apache-2.0",
            "api": "crc32(data, kind=Ieee), Crc32",
          },
        ]
      },
      "ported_upstream": if package_dir == "wc" {
        {
          "package": "fastlwc",
          "repository": "https://github.com/expr-fi/fastlwc",
          "revision": "b8d3a3839161d0487a25610d65a077d8431de1f0",
          "license": "MIT",
          "timed": false,
        }
      } else if package_dir == "memchr" {
        {
          "package": "memchr",
          "version": "2.8.3",
          "revision": "5fdb40c054e1fff359a2f7bdf7f87a13b34b465d",
          "crate_sha256": "cf8baf1c55e62ffcace7a9f06f4bd9cd3f0c4beb022d3b367256b91b87513d98",
          "license": "MIT",
          "timed": false,
        }
      } else if package_dir == "ryu" {
        {
          "package": "ryu",
          "repository": "https://github.com/ulfjack/ryu",
          "revision": "4c0618b0e44f7ef027ebae05d2cc7812048f7c8f",
          "license": "BSL-1.0",
          "timed": false,
        }
      } else if package_dir == "atoi" {
        {
          "package": "atoi_simd",
          "version": "0.18.1",
          "revision": "f0952f7bb71ee581dcc2871841f9b2dbd241bd7e",
          "crate_sha256": "f3cdb3708a128e559a30fb830e8a77a5022ee6902806925c216658652b452a44",
          "license": "MIT",
          "timed": false,
        }
      } else if package_dir == "argminmax" {
        {
          "package": "argminmax",
          "version": "0.7.1",
          "revision": "f68aba5c251e9dc093f3939c0f9607c942228311",
          "crate_sha256": "088a9c28ca36500c581f9f54b63460492d2b4f71e1e61d176e8fb79565109b01",
          "license": "MIT",
          "timed": false,
        }
      } else {
        Json::null()
      },
      "workload_metadata": if package_dir == "wc" {
        {
          "cases_per_backend": 18,
          "prepared": "Immutable repeated ASCII text or deterministic binary bytes, views, and streaming chunks",
          "timed": "Public calls, streaming construction and snapshot, result adaptation, callback dispatch, and keep barriers",
          "measurement_order": if reversed {
            "reversed"
          } else {
            "forward"
          },
        }
      } else if package_dir == "memchr" {
        memchr_workload_metadata()
      } else if package_dir == "argminmax" {
        {
          "cases_per_backend": 162,
          "elements": [0, 33, 4096, 131105, 1048576],
          "name_fields": [
            "operation-and-kind", "implementation", "numeric-bytes", "element-offset",
          ],
          "validity_bit_offset": 3,
          "widths": {
            "u8": 1,
            "i8": 1,
            "u16": 2,
            "i16": 2,
            "u32": 4,
            "i32": 4,
            "u64": 8,
            "i64": 8,
            "f32": 4,
            "f64": 8,
            "f16": 2,
            "bf16": 2,
            "u128": 16,
            "i128": 16,
          },
          "input_storage": "Prepared typed arrays and offset-one views; wrapper construction and bitmap generation are outside timing",
          "timed": "Public calls or the independent reference, callback dispatch, optional-result adapters, bitmap validation, and bench.keep",
        }
      } else if package_dir == "ryu" {
        {
          "cases_per_backend": 85,
          "name_fields": [
            "operation-and-precision", "implementation", "input-bytes", "UTF-16-view-offset",
          ],
          "format_input_widths": { "Double": 8, "Float": 4 },
          "parse_offsets": [0, 1, 3, 15],
          "printf_precisions": [0, 1, 2, 6, 17, 100, 324, 1000, 1074],
          "input_storage": "Prepared numeric values and ASCII StringViews; Float construction and offset backing strings are outside timing",
          "timed": "Public formatting/allocation or parsing, core layout/narrowing adaptations, optional-bit results, callback dispatch, and bench.keep",
          "simd": false,
        }
      } else {
        Json::null()
      },
      "backends": Json(backends),
    }
    let record_name = if package_dir == "wc" && run_id == "" {
      os +
      (if targets.length() == 1 { "-" + targets[0] } else { "" }) +
      (if reversed { "-reversed" } else { "" })
    } else if package_dir == "memchr" && run_id == "" && targets.length() == 1 {
      os + "-" + targets[0]
    } else {
      os
    }
    @fs.write_text(
      "\{directory}/\{record_name}.json",
      result.stringify(indent=2),
    )
    println("Saved \{directory}/\{record_name}.json")
  }
}

///|
/// Defines every extrema workload with numeric byte widths and element offsets.
fn expected_argminmax_names() -> Map[String, Unit] {
  let workloads : Array[(String, Int32, Int32)] = []
  for
    (kind, width) in [
      ("u8", 1),
      ("i8", 1),
      ("u16", 2),
      ("i16", 2),
      ("u32", 4),
      ("i32", 4),
      ("u64", 8),
      ("i64", 8),
      ("f32", 4),
      ("f64", 8),
      ("f16", 2),
      ("bf16", 2),
      ("u128", 16),
      ("i128", 16),
    ] {
    for length in [33, 4096] {
      workloads.push(("argminmax-" + kind, length * width, 0))
    }
  }
  for (kind, width) in [("i32", 4), ("f64", 8)] {
    workloads.push(("argminmax-" + kind, 0, 0))
    for (length, offset) in [(4096, 1), (1048576, 0), (1048576, 1)] {
      workloads.push(("argminmax-" + kind, length * width, offset))
    }
    for operation in ["min", "max"] {
      workloads.push(("arg" + operation + "-" + kind, 4096 * width, 0))
    }
  }
  for (kind, width) in [("f32", 4), ("f64", 8)] {
    for position in ["first", "last"] {
      for policy in ["ignore", "propagate"] {
        workloads.push(
          (policy + "-nan-" + position + "-" + kind, 4096 * width, 0),
        )
      }
    }
  }
  for pattern in ["dense", "sparse", "all-null", "nan-null"] {
    workloads.push(("masked-" + pattern + "-f64", 32768, 0))
  }
  for (kind, width) in [("u8", 1), ("u16", 2)] {
    workloads.push(("index-boundary-" + kind, 131105 * width, 0))
  }
  let expected : Map[String, Unit] = Map([])
  for (label, bytes, offset) in workloads {
    for implementation in ["own-scalar", "own-simd", "baseline"] {
      expected[label +
      ":" +
      implementation +
      ":" +
      bytes.to_string() +
      ":" +
      offset.to_string()] = ()
    }
  }
  expected
}

///|
/// Rejects missing, substituted, or duplicate extrema cases before saving artifacts.
fn validate_argminmax_inventory(records : Array[Json]) -> Unit raise {
  let expected = expected_argminmax_names()
  guard records.length() == expected.length() else {
    fail("Expected 162 extrema cases")
  }
  for record in records {
    guard record is { "name": String(name), .. } && expected.contains(name) else {
      fail("Unexpected or duplicate extrema case")
    }
    let _ = expected.remove(name)
  }
  guard expected.is_empty() else { fail("Missing extrema cases") }
}

///|
/// Lists every word-count operation, view offset, and prepared chunk size.
fn wc_inventory() -> Map[String, Json] {
  let cases : Map[String, Json] = Map([])
  for
    (workload, bytes, offset, chunk) in [
      ("short", 13, 0, 0),
      ("offset", 33, 3, 0),
      ("text", 4096, 0, 0),
      ("binary", 65539, 1, 0),
      ("stream63", 4096, 0, 63),
      ("stream8k", 1048576, 0, 8192),
    ] {
    for implementation in ["reference", "own-scalar", "own-simd"] {
      cases["\{workload}:\{implementation}:\{bytes}:\{offset}"] = {
        "input_bytes": bytes,
        "input_offset": offset,
        "stream_chunk_bytes": chunk,
      }
    }
  }
  cases
}

///|
/// Validates and records the exact word-count workload metadata.
fn annotate_wc(records : Array[Json]) -> Unit raise {
  let expected = wc_inventory()
  guard records.length() == expected.length() else {
    fail("Expected the complete 18-case word-count inventory")
  }
  for record in records {
    guard record is Object(fields) &&
      fields.get("name") is Some(String(name)) &&
      expected.get(name) is Some(Object(metadata)) else {
      fail("Unexpected or duplicate word-count benchmark")
    }
    expected.remove(name)
    for (key, value) in metadata {
      guard fields.get(key) is None || fields.get(key) == Some(value) else {
        fail("Changed word-count metadata: " + name + "/" + key)
      }
      fields[key] = value
    }
  }
}

///|
/// Requires the collector to reject invalid word-count inputs.
fn wc_must_reject(action : () -> Unit raise) -> Unit raise {
  try action() catch {
    _ => ()
  } noraise {
    _ => fail("Invalid word-count inventory was accepted")
  }
}

///|
/// Verifies that the word-count collector rejects missing and substituted inputs.
fn wc_inventory_self_test() -> Unit raise {
  let cases : Array[Json] = []
  for (name, _) in wc_inventory() {
    cases.push({ "name": name })
  }
  assert_eq(cases.length(), 18)
  annotate_wc(cases)
  wc_must_reject(() => annotate_wc(cases[:17].to_owned()))
  let changed = cases.copy()
  changed[0] = { "name": "text:own-simd:4096:1" }
  wc_must_reject(() => annotate_wc(changed))
  changed[0] = cases[1]
  wc_must_reject(() => annotate_wc(changed))
}
