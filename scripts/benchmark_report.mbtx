----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}
----

///|
/// Retrieves a required JSON field with a useful schema error.
fn field(value : Json, key : String) -> Json raise {
  match value {
    Object(fields) =>
      fields.get(key).unwrap_or_else(() => fail("Missing field: \{key}"))
    _ => fail("Expected an object for field \{key}")
  }
}

///|
/// Retrieves a required JSON string without silently coercing its type.
fn text(value : Json, key : String) -> String raise {
  match field(value, key) {
    String(contents) => contents
    _ => fail("Expected a string: \{key}")
  }
}

///|
/// Retrieves a finite numeric statistic from a benchmark summary.
fn number(value : Json, key : String) -> Double raise {
  match field(value, key) {
    Number(contents, ..) => {
      guard contents.is_finite() else { fail("Non-finite statistic: \{key}") }
      contents
    }
    _ => fail("Expected a number: \{key}")
  }
}

///|
/// Retrieves a required JSON array from the input schema.
fn array(value : Json, key : String) -> Array[Json] raise {
  match field(value, key) {
    Array(contents) => contents
    _ => fail("Expected an array: \{key}")
  }
}

///|
/// Rounds display numbers to three decimal places while preserving original JSON.
fn decimal(value : Double) -> String {
  ((value * 1000).round() / 1000).to_string()
}

///|
/// Quotes untrusted runner metadata safely inside a Markdown table cell.
fn cell(value : String) -> String {
  value
  .replace_all(old="|", new="\\|")
  .replace_all(old="\r", new=" ")
  .replace_all(old="\n", new=" ")
}

///|
/// Parses the benchmark case contract without rounding UInt64 suffix lengths.
fn case_parts(summary : Json) -> Array[String] raise {
  let pieces = text(summary, "name")
    .split(":")
    .map(part => part.to_owned())
    .to_array()
  guard pieces.length() == 4 else { fail("Invalid benchmark case name") }
  pieces
}

///|
/// Computes GiB per second only for workloads that actually read input bytes.
fn throughput(workload : String, bytes : String, mean : Double) -> String raise {
  if workload == "combine" || bytes == "0" {
    "n/a"
  } else {
    let length = @string.parse_int(bytes)
    decimal(length.to_double() * 1000000 / mean / 1073741824)
  }
}

///|
/// Validates nonempty unique cases and complete timing statistics before reporting.
fn validate_backend(value : Json, package_dir : String) -> Unit raise {
  let backend = text(value, "backend")
  guard ["native", "wasm", "wasm-gc", "js"].contains(backend) else {
    fail("Unexpected backend: \{backend}")
  }
  guard text(value, "time_unit") == "microseconds" else {
    fail("Unexpected timing unit")
  }
  let summaries = array(value, "summaries")
  guard !summaries.is_empty() &&
    (package_dir != "crc32" || summaries.length() == 207) else {
    fail("Expected 69 library and 138 comparison cases")
  }
  if package_dir == "url" {
    validate_url_inventory(summaries)
  }
  if package_dir == "uuid" {
    validate_uuid_inventory(summaries)
  }
  let names : Map[String, Unit] = Map([])
  for summary in summaries {
    let name = text(summary, "name")
    let _ = case_parts(summary)
    guard !names.contains(name) else { fail("Duplicate benchmark: \{name}") }
    names[name] = ()
    let mean = number(summary, "mean")
    let minimum = number(summary, "min")
    let maximum = number(summary, "max")
    let median = number(summary, "median")
    let tolerance = maximum.abs() * 0.000000000001 + 0.000000000001
    guard mean > 0 &&
      minimum >= 0 &&
      minimum <= mean + tolerance &&
      mean <= maximum + tolerance &&
      minimum <= median + tolerance &&
      median <= maximum + tolerance else {
      fail("Invalid timing range: \{name}")
    }
    guard number(summary, "std_dev") >= 0 &&
      number(summary, "std_dev_pct") >= 0 &&
      number(summary, "runs") == 10 &&
      number(summary, "batch_size") >= 1 else {
      fail("Invalid sample metadata: \{name}")
    }
    if package_dir == "uuid" {
      validate_uuid_statistics(summary)
    }
  }
}

///|
/// Defines every URL workload, library mode, and view offset expected in a complete run.
fn expected_url_keys() -> Map[String, Unit] {
  let keys : Map[String, Unit] = Map([])
  let implementations = [
    "justjavac-scalar", "justjavac-simd", "tonyfettes", "moonbitstack", "connect0459",
  ]
  for
    label in [
      "short", "ascii", "long", "normalize", "unicode", "ipv4", "ipv6", "file", "credentials",
    ] {
    let offsets = if label == "short" || label == "long" {
      ["0", "1"]
    } else {
      ["0"]
    }
    for workload in ["parse-" + label, "roundtrip-" + label] {
      for implementation in implementations {
        for offset in offsets {
          keys["\{workload}:\{implementation}:\{offset}"] = ()
        }
      }
    }
  }
  for label in ["path", "query", "authority"] {
    for workload in ["resolve-" + label, "resolve-roundtrip-" + label] {
      for implementation in implementations {
        keys["\{workload}:\{implementation}:0"] = ()
      }
    }
  }
  for
    implementation in ["justjavac", "tonyfettes", "moonbitstack", "connect0459"] {
    keys["form-roundtrip:\{implementation}:0"] = ()
  }
  keys
}

///|
/// Rejects missing or substituted URL cases even when the total count is correct.
fn validate_url_inventory(summaries : Array[Json]) -> Unit raise {
  let expected = expected_url_keys()
  guard summaries.length() == expected.length() else {
    fail("Expected 144 URL benchmark cases")
  }
  let lengths : Map[String, String] = Map([])
  for summary in summaries {
    let parts = case_parts(summary)
    let key = "\{parts[0]}:\{parts[1]}:\{parts[3]}"
    guard expected.contains(key) && @string.parse_int(parts[2]) > 0 else {
      fail("Unexpected URL benchmark: \{key}")
    }
    let _ = expected.remove(key)
    if lengths.get(parts[0]) is Some(length) {
      guard length == parts[2] else { fail("Mismatched URL input lengths") }
    } else {
      lengths[parts[0]] = parts[2]
    }
  }
  guard expected.is_empty() else { fail("Incomplete URL benchmark inventory") }
}

///|
/// Defines every UUID case independently of counts for the other libraries.
fn expected_uuid_names() -> Map[String, Unit] {
  let names : Map[String, Unit] = Map([])
  let implementations = [
    "own-scalar", "own-simd", "bobzhang", "f4ah6o", "moonbitstack", "wulisususu",
  ]
  for
    (label, length) in [
      ("simple", 32),
      ("hyphenated", 36),
      ("mixed", 36),
      ("nil", 36),
      ("max", 36),
      ("braced", 38),
      ("urn", 45),
    ] {
    let offsets = if label == "simple" || label == "hyphenated" {
      [0, 1]
    } else {
      [0]
    }
    for implementation in implementations {
      if label == "braced" &&
        (implementation == "bobzhang" || implementation == "f4ah6o") {
        continue
      }
      for offset in offsets {
        for operation in ["parse", "roundtrip"] {
          names["\{operation}-\{label}:\{implementation}:\{length}:\{offset}"] = ()
        }
      }
    }
  }
  for implementation in implementations {
    names["format-hyphenated:\{implementation}:16:0"] = ()
    if implementation != "wulisususu" {
      names["format-simple:\{implementation}:16:0"] = ()
    }
    for
      (label, length) in [
        ("empty", 0),
        ("short", 31),
        ("start", 36),
        ("end", 36),
      ] {
      names["invalid-\{label}:\{implementation}:\{length}:0"] = ()
    }
    for
      (operation, length) in [
        ("parse", 36864),
        ("roundtrip", 36864),
        ("format", 16384),
      ] {
      names["\{operation}-batch1024:\{implementation}:\{length}:0"] = ()
    }
  }
  for implementation in ["own-scalar", "own-simd"] {
    for spelling in ["simple", "hyphenated"] {
      names["format-\{spelling}-upper:\{implementation}:16:0"] = ()
      for case in ["lower", "upper"] {
        for offset in [0, 1] {
          names["write-\{spelling}-\{case}:\{implementation}:16:\{offset}"] = ()
        }
      }
    }
    for
      (label, length) in [
        ("simple", 32),
        ("hyphenated", 36),
        ("braced", 38),
        ("urn", 45),
      ] {
      for offset in [0, 1] {
        names["parse-bytes-\{label}:\{implementation}:\{length}:\{offset}"] = ()
      }
    }
  }
  names
}

///|
/// Defines exact byte, UTF-16, output, count, and offset metadata for one UUID case.
fn uuid_case_metadata(name : String) -> Map[String, Json] raise {
  let pieces = name.split(":").map(view => view.to_owned()).to_array()
  guard pieces.length() == 4 else { fail("Invalid UUID case name") }
  let operation = pieces[0]
  let length = @string.parse_int(pieces[2])
  let offset = @string.parse_int(pieces[3])
  let count = if operation.find("batch1024") is Some(_) { 1024 } else { 1 }
  let writing = operation.find("write-") is Some(0)
  let byte_input = operation.find("parse-bytes-") is Some(0)
  let text_input = !byte_input &&
    (
      operation.find("parse-") is Some(0) ||
      operation.find("roundtrip-") is Some(0) ||
      operation.find("invalid-") is Some(0)
    )
  let output = if operation.find("invalid-") is Some(0) {
    0
  } else if operation.find("simple") is Some(_) &&
    (operation.find("format-") is Some(0) || writing) {
    32 * count
  } else if operation.find("roundtrip-") is Some(0) ||
    operation.find("format-") is Some(0) ||
    writing {
    36 * count
  } else {
    16 * count
  }
  {
    "input_bytes": Json(length),
    "input_code_units": if text_input {
      Json(length)
    } else {
      null
    },
    "uuid_count": Json(count),
    "output_bytes": Json(output),
    "input_offset": Json(if writing { 0 } else { offset }),
    "output_offset": Json(if writing { offset } else { 0 }),
    "offset_unit": Json(
      if writing {
        "output-bytes"
      } else if text_input {
        "utf16-code-units"
      } else {
        "input-bytes"
      },
    ),
  }
}

///|
/// Rejects missing, duplicate, substituted, or mislabelled UUID measurements.
fn validate_uuid_inventory(summaries : Array[Json]) -> Unit raise {
  let expected = expected_uuid_names()
  guard expected.length() == 193 && summaries.length() == 193 else {
    fail("Expected exactly 193 UUID cases")
  }
  for summary in summaries {
    let name = text(summary, "name")
    guard expected.contains(name) else {
      fail("Unexpected UUID benchmark: \{name}")
    }
    let _ = expected.remove(name)
    for (key, value) in uuid_case_metadata(name) {
      guard field(summary, key) == value else {
        fail("Incorrect UUID \{key}: \{name}")
      }
    }
  }
  guard expected.is_empty() else { fail("Incomplete UUID inventory") }
}

///|
/// Verifies every distribution statistic and the benchmark runner's sample metadata.
fn validate_uuid_statistics(summary : Json) -> Unit raise {
  let quartiles = array(summary, "quartiles")
  guard quartiles is [Number(low, ..), Number(middle, ..), Number(high, ..)] else {
    fail("UUID quartiles require three numeric values")
  }
  let minimum = number(summary, "min")
  let maximum = number(summary, "max")
  let tolerance = maximum.abs() * 0.000000001 + 0.000000001
  guard low.is_finite() &&
    middle.is_finite() &&
    high.is_finite() &&
    minimum <= low + tolerance &&
    low <= middle + tolerance &&
    middle <= high + tolerance &&
    high <= maximum + tolerance &&
    (middle - number(summary, "median")).abs() <= tolerance else {
    fail("Invalid UUID quartile range")
  }
  for
    statistic in [
      "sum", "variance", "median_abs_dev", "median_abs_dev_pct", "iqr",
    ] {
    guard number(summary, statistic) >= 0 else {
      fail("Invalid UUID statistic: \{statistic}")
    }
  }
  let batch = number(summary, "batch_size")
  guard batch >= 1 && batch.floor() == batch else {
    fail("UUID batch size must be integral")
  }
  guard (number(summary, "iqr") - (high - low)).abs() <= tolerance &&
    (number(summary, "sum") - number(summary, "mean") * number(summary, "runs")).abs() <=
    tolerance * 10 else {
    fail("Inconsistent UUID distribution statistics")
  }
}

///|
/// Extracts comparable toolchain versions while ignoring platform-specific paths.
fn toolchain_versions(value : String) -> String raise {
  let versions : Array[String] = []
  for line in value.split("\n") {
    if line.find(")") is Some(end) &&
      (
        line.find("moon ") is Some(0) ||
        line.find("moonc ") is Some(0) ||
        line.find("moonrun ") is Some(0)
      ) {
      versions.push(line[:end + 1].to_owned())
    }
  }
  guard versions.length() == 3 else {
    fail("Missing recorded toolchain versions")
  }
  versions.join("\n")
}

///|
/// Verifies UUID dependency pins, source provenance, and complete runner metadata.
fn validate_uuid_provenance(record : Json, first : Json) -> Unit raise {
  let dependencies = array(record, "comparison_dependencies")
  let expected = [
    ("bobzhang", "bobzhang/uuidm", "0.2.0", "ISC"),
    ("f4ah6o", "f4ah6o/uuidm", "0.2.1", "ISC"),
    ("moonbitstack", "moonbitstack/moonuuid", "0.2.1", "Apache-2.0"),
    ("wulisususu", "wulisususu/moonuuid", "0.1.0", "Apache-2.0"),
  ]
  guard dependencies.length() == expected.length() else {
    fail("Missing UUID comparison dependencies")
  }
  for i in 0..<expected.length() {
    let (label, package_name, version, license) = expected[i]
    let dependency = dependencies[i]
    guard text(dependency, "label") == label &&
      text(dependency, "package") == package_name &&
      text(dependency, "version") == version &&
      text(dependency, "license") == license &&
      text(dependency, "api") != "" else {
      fail("Incorrect UUID comparison dependency: \{label}")
    }
    guard text(record, "comparison_manifest").find("\{package_name}@\{version}")
      is Some(_) else {
      fail("UUID dependency is not pinned in the recorded manifest")
    }
  }
  guard text(record, "source_commit").iter().all(c => c.is_ascii_hexdigit()) &&
    text(record, "run_id").iter().all(c => c.is_ascii_digit()) &&
    @string.parse_int(text(record, "run_attempt")) >= 1 &&
    field(record, "working_tree_dirty") == Json(false) else {
    fail("Invalid UUID source provenance")
  }
  guard text(record, "module_manifest") == text(first, "module_manifest") &&
    text(record, "comparison_manifest") == text(first, "comparison_manifest") &&
    toolchain_versions(text(record, "toolchain")) ==
    toolchain_versions(text(first, "toolchain")) &&
    text(record, "node") == text(first, "node") else {
    fail("Mixed UUID manifests or runtime versions")
  }
  guard text(record, "module_manifest").find("name = \"justjavac/uuid\"")
    is Some(_) &&
    text(record, "module_manifest").find("license = \"MIT\"") is Some(_) else {
    fail("Incorrect UUID module metadata")
  }
  for
    key in [
      "runner_label", "image_os", "image_version", "node", "dependency_tree",
    ] {
    guard text(record, key) != "" else {
      fail("Missing UUID runner metadata: \{key}")
    }
  }
  let cpu = field(record, "cpu")
  guard text(cpu, "architecture") != "" else {
    fail("Missing UUID CPU architecture")
  }
  match field(cpu, "logical_cpus") {
    Number(count, ..) => {
      guard count.is_finite() && count >= 1 else { fail("Invalid CPU count") }
    }
    String(count) => {
      guard @string.parse_int(count) >= 1 else { fail("Invalid CPU count") }
    }
    _ => fail("Missing CPU count")
  }
  for backend in array(record, "backends") {
    let started = text(backend, "started_at_utc")
    let finished = text(backend, "finished_at_utc")
    guard started.length() == 20 &&
      finished.length() == 20 &&
      started <= finished &&
      started[19] == 'Z' &&
      finished[19] == 'Z' else {
      fail("Invalid UUID measurement timestamps")
    }
    let command = text(backend, "command")
    guard command.find("--release") is Some(_) &&
      command.find("--no-parallelize") is Some(_) &&
      command.find("justjavac/benchmarks/uuid") is Some(_) &&
      command.find("--target " + text(backend, "backend")) is Some(_) else {
      fail("Missing UUID benchmark command")
    }
  }
}

///|
/// Rejects local measurements and mixed CI revisions or attempts in a published snapshot.
fn validate_snapshot(records : Array[Json], package_dir : String) -> Unit raise {
  guard records.length() == 3 else {
    fail("A snapshot requires all three operating systems")
  }
  let first = records[0]
  let revision = text(first, "source_commit")
  let run = text(first, "run_id")
  guard revision.length() == 40 && run != "" else {
    fail("Missing CI provenance")
  }
  let operating_systems : Map[String, Unit] = Map([])
  let canonical_cases : Map[String, Unit] = Map([])
  for record in records {
    let os = text(record, "os")
    guard ["linux", "macos", "windows"].contains(os) &&
      !operating_systems.contains(os) else {
      fail("Invalid or duplicate operating system: \{os}")
    }
    operating_systems[os] = ()
    guard text(record, "repository") == text(first, "repository") else {
      fail("Mixed benchmark repositories")
    }
    guard text(record, "source") == "github-actions" &&
      text(record, "module") == "justjavac/\{package_dir}" &&
      text(record, "source_commit") == revision &&
      text(record, "run_id") == run &&
      text(record, "run_attempt") == text(first, "run_attempt") else {
      fail("Mixed or non-CI benchmark provenance")
    }
    let expected_url = "https://github.com/\{text(record, "repository")}/actions/runs/\{run}"
    guard text(record, "run_url") == expected_url else {
      fail("Unexpected CI run URL")
    }
    guard array(record, "comparison_dependencies") ==
      array(first, "comparison_dependencies") else {
      fail("Mixed comparison dependency versions")
    }
    if package_dir == "uuid" {
      validate_uuid_provenance(record, first)
    }
    let backends = array(record, "backends")
    guard backends.length() == 4 else { fail("Missing backend results") }
    let backend_names : Map[String, Unit] = Map([])
    for backend in backends {
      let name = text(backend, "backend")
      guard !backend_names.contains(name) else { fail("Duplicate backend") }
      backend_names[name] = ()
      validate_backend(backend, package_dir)
      if package_dir == "url" {
        let summaries = array(backend, "summaries")
        if canonical_cases.is_empty() {
          for summary in summaries {
            canonical_cases[text(summary, "name")] = ()
          }
        } else {
          for summary in summaries {
            guard canonical_cases.contains(text(summary, "name")) else {
              fail("Mixed URL case inventories")
            }
          }
        }
      }
    }
    guard text(field(record, "cpu"), "model") != "" else {
      fail("Missing CPU model")
    }
  }
}

///|
/// Displays string and numeric runner metadata without JSON quotation marks.
fn display(value : Json) -> String {
  match value {
    String(contents) => cell(contents)
    Number(contents, ..) => decimal(contents)
    _ => cell(value.stringify())
  }
}

///|
/// Indexes named cases for focused public API comparison tables.
fn index(backend : Json) -> Map[String, Json] raise {
  let values : Map[String, Json] = Map([])
  for summary in array(backend, "summaries") {
    values[text(summary, "name")] = summary
  }
  values
}

///|
/// Formats a measured mean and marks cases with substantial sample variation.
fn metric(summary : Json, units : String, bytes : Double) -> String raise {
  let mean = number(summary, "mean")
  let value = match units {
    "ns" => mean * 1000
    "us" => mean
    "GiB/s" => bytes * 1000000 / mean / 1073741824
    _ => fail("Unknown report unit")
  }
  let variability = if number(summary, "std_dev_pct") >= 5 { "*" } else { "" }
  decimal(value) + variability
}

///|
/// Renders one key comparison for all twelve runner/backend environments.
fn results_table(
  builder : StringBuilder,
  records : Array[Json],
  title : String,
  workload : String,
  bytes : String,
  parameter : String,
  units : String,
  byte_count : Double,
  implementations~ : Array[String] = [
    "own-scalar", "own-simd", "gaato", "gmlewis", "kujirahand", "mooncrypt",
  ],
  labels~ : Array[String] = [
    "ours scalar", "ours SIMD request", "gaato", "gmlewis", "kujirahand", "mooncrypt",
  ],
) -> Unit raise {
  builder.write_string("## \{title}\n\n")
  builder.write_string(
    "| OS / backend | " +
    labels.join(" | ") +
    " |\n| --- | " +
    labels.map(_ => "---").join(" | ") +
    " |\n",
  )
  for record in records {
    for backend in array(record, "backends") {
      let values = index(backend)
      let mut fastest = number(
        values["\{workload}:\{implementations[0]}:\{bytes}:\{parameter}"],
        "mean",
      )
      for implementation in implementations {
        let name = "\{workload}:\{implementation}:\{bytes}:\{parameter}"
        let value = values
          .get(name)
          .unwrap_or_else(() => fail("Missing comparison: \{name}"))
        fastest = fastest.min(number(value, "mean"))
      }
      builder.write_string(
        "| \{text(record, "os")} / \{text(backend, "backend")} ",
      )
      for implementation in implementations {
        let name = "\{workload}:\{implementation}:\{bytes}:\{parameter}"
        let value = values
          .get(name)
          .unwrap_or_else(() => fail("Missing comparison: \{name}"))
        let measured = metric(value, units, byte_count)
        let formatted = if number(value, "mean") == fastest {
          "**\{measured}**"
        } else {
          measured
        }
        builder.write_string("| \{formatted} ")
      }
      builder.write_string("|\n")
    }
  }
  builder.write_string("\n")
}

///|
/// Summarizes native throughput ratios against the fastest external library and the scalar path.
fn highlights(builder : StringBuilder, records : Array[Json]) -> Unit raise {
  builder.write_string(
    "## At a glance\n\nNative, 1 MiB owned input; ratios compare throughput:\n\n",
  )
  for record in records {
    let backends = array(record, "backends")
    let native_index = backends
      .search_by(backend => text(backend, "backend") == "native")
      .unwrap_or_else(() => fail("Missing native results"))
    let values = index(backends[native_index])
    let scalar = number(values["compare:own-scalar:1048576:0"], "mean")
    let simd = number(values["compare:own-simd:1048576:0"], "mean")
    let mut fastest = "gaato"
    let mut external_mean = number(values["compare:gaato:1048576:0"], "mean")
    for implementation in ["gmlewis", "kujirahand", "mooncrypt"] {
      let mean = number(values["compare:\{implementation}:1048576:0"], "mean")
      if mean < external_mean {
        fastest = implementation
        external_mean = mean
      }
    }
    builder.write_string(
      "- **\{text(record, "os")}:** scalar \{decimal(1048576 * 1000000 / scalar / 1073741824)} GiB/s, **\{decimal(external_mean / scalar)}x** the fastest external library (\{fastest}); SIMD **\{decimal(scalar / simd)}x** scalar.\n",
    )
  }
  builder.write_string(
    "\nRatios below 1 mean lower throughput. Hosted measurements are workload-specific; consult variation marks in the tables.\n\n",
  )
}

///|
/// Builds a concise, information-rich report backed by a complete JSON snapshot.
fn report(package_dir : String, records : Array[Json]) -> String raise {
  validate_snapshot(records, package_dir)
  if package_dir == "url" {
    return url_report(records)
  }
  if package_dir == "uuid" {
    return uuid_report(records)
  }
  let first = records[0]
  let revision = text(first, "source_commit")
  let repository = text(first, "repository")
  let builder = StringBuilder()
  builder.write_string("# CRC32 performance comparison\n\n")
  builder.write_string(
    "[CI run \{text(first, "run_id")}](\{text(first, "run_url")}) | [source \{revision[:7]}](https://github.com/\{repository}/commit/\{revision}) | attempt \{text(first, "run_attempt")}\n\n",
  )
  builder.write_string(
    "**Scope:** 3 operating systems x 4 backends x 207 cases = **2484 measurements**. Key comparisons are below; [BENCHMARK-DATA.json](BENCHMARK-DATA.json) preserves every case, mean, median, range, standard deviation, quartile, sample count, command, timestamp, and environment.\n\n",
  )
  highlights(builder, records)
  builder.write_string(
    "## Implementations\n\n| Label | Package / pinned version | Public API measured |\n| --- | --- | --- |\n| ours scalar | justjavac/crc32 / source above | hash and Hasher, simd=false |\n| ours SIMD request | justjavac/crc32 / source above | hash and Hasher, simd=true |\n",
  )
  for dependency in array(first, "comparison_dependencies") {
    builder.write_string(
      "| \{cell(text(dependency, "label"))} | \{cell(text(dependency, "package"))} / \{cell(text(dependency, "version"))} | \{cell(text(dependency, "api"))} |\n",
    )
  }
  builder.write_string(
    "\n## Reading the results\n\n- All libraries pass identical IEEE CRC-32 vectors and an independent bitwise oracle.\n- Owned inputs and stream chunks are prepared before timing; state creation, public API calls, byte-wise adapter loops, and finalization are timed. gmlewis uses a byte-at-a-time API.\n- The offset-1 view workload includes input materialization for kujirahand, whose API requires owned Bytes. Other adapters accept views or iterate their bytes.\n- The SIMD request uses scalar fallback on Wasm GC/JS and inputs shorter than 16 bytes.\n- **Bold** marks the best measured mean in a row; `*` marks CV >= 5% and possible noise. Lower latency and higher GiB/s are better. Compare within an OS/backend; hosted hardware differs.\n- Release mode, deterministic binary inputs, 10 batch samples, and 5% winsorization. Calibration targets about 100 ms; fast cases use 100000 iterations per batch. Timings include the bench.keep barrier.\n\n",
  )
  builder.write_string(
    "## Runner context\n\n| OS | CPU | Architecture / logical CPUs | Image | Node.js |\n| --- | --- | --- | --- | --- |\n",
  )
  for record in records {
    let cpu = field(record, "cpu")
    builder.write_string(
      "| \{text(record, "os")} | \{cell(text(cpu, "model"))} | \{cell(text(cpu, "architecture"))} / \{display(field(cpu, "logical_cpus"))} | \{cell(text(record, "image_os"))} / \{cell(text(record, "image_version"))} | \{cell(text(record, "node"))} |\n",
    )
  }
  builder.write_string("\n")
  results_table(
    builder, records, "1 MiB owned input: throughput (GiB/s)", "compare", "1048576",
    "0", "GiB/s", 1048576,
  )
  results_table(
    builder, records, "4 KiB owned input: latency (us)", "compare", "4096", "0",
    "us", 4096,
  )
  results_table(
    builder, records, "64-byte owned input: latency (ns)", "compare", "64", "0",
    "ns", 64,
  )
  results_table(
    builder, records, "64 KiB stream, 4 KiB chunks: latency (us)", "compare-stream",
    "65536", "4096", "us", 65536,
  )
  results_table(
    builder, records, "1 MiB offset-1 view: end-to-end latency (us)", "view", "1048576",
    "1", "us", 1048576,
  )
  builder.write_string(
    "<details>\n<summary>Toolchain and reproduction</summary>\n\n",
  )
  for record in records {
    builder.write_string(
      "**\{text(record, "os")}:**\n\n~~~text\n\{text(record, "toolchain")}\n~~~\n\n",
    )
  }
  builder.write_string(
    "Run `moon -C benchmarks test --target all` before local measurements, then `moon run scripts/benchmark.mbtx crc32`. CI measures backends sequentially per OS. Raw artifacts are retained for 90 days; committed JSON preserves the full snapshot. Reports retain their measured source commit.\n\n</details>\n",
  )
  builder.to_string()
}

///|
/// Finds a workload's validated input byte count for a focused URL comparison table.
fn url_table(
  builder : StringBuilder,
  records : Array[Json],
  title : String,
  workload : String,
  offset : String,
  units : String,
) -> Unit raise {
  let first = array(array(records[0], "backends")[0], "summaries")
  let mut bytes = ""
  for summary in first {
    let parts = case_parts(summary)
    if parts[0] == workload && parts[3] == offset {
      bytes = parts[2]
      break
    }
  }
  guard bytes != "" else { fail("Missing URL workload: \{workload}") }
  let form = workload == "form-roundtrip"
  results_table(
    builder,
    records,
    title + " (\{bytes} UTF-8 bytes)",
    workload,
    bytes,
    offset,
    units,
    @string.parse_int(bytes).to_double(),
    implementations=if form {
      ["justjavac", "tonyfettes", "moonbitstack", "connect0459"]
    } else {
      [
        "justjavac-scalar", "justjavac-simd", "tonyfettes", "moonbitstack", "connect0459",
      ]
    },
    labels=if form {
      ["justjavac", "tonyfettes", "moonbitstack", "connect0459"]
    } else {
      [
        "ours scalar", "ours SIMD request", "tonyfettes", "moonbitstack", "connect0459",
      ]
    },
  )
}

///|
/// Renders a concise URL report with full provenance and an exhaustive JSON companion.
fn url_report(records : Array[Json]) -> String raise {
  let first = records[0]
  let revision = text(first, "source_commit")
  let repository = text(first, "repository")
  let builder = StringBuilder()
  builder.write_string("# URL performance comparison\n\n")
  builder.write_string(
    "[CI run \{text(first, "run_id")}](\{text(first, "run_url")}) | [source \{revision[:7]}](https://github.com/\{repository}/commit/\{revision}) | attempt \{text(first, "run_attempt")}\n\n",
  )
  builder.write_string(
    "**Scope:** 3 operating systems x 4 backends x 144 cases = **1728 measurements**. [BENCHMARK-DATA.json](BENCHMARK-DATA.json) preserves all workloads, input lengths, UTF-16 view offsets, means, medians, ranges, variability, throughput inputs, sample counts, compiler versions, commands, timestamps, and dependency manifests.\n\n",
  )
  builder.write_string(
    "## Implementations\n\n| Label | Package / pinned version | API |\n| --- | --- | --- |\n| ours scalar / SIMD request | justjavac/url / source above | parse(StringView, simd=false/true), href |\n",
  )
  for dependency in array(first, "comparison_dependencies") {
    builder.write_string(
      "| \{cell(text(dependency, "label"))} | \{cell(text(dependency, "package"))} / \{cell(text(dependency, "version"))} | \{cell(text(dependency, "api"))} |\n",
    )
  }
  builder.write_string(
    "\n## Method\n\n- All adapters pass identical canonical results before timing; moonurl explicitly uses WHATWG mode. Each library runs in a separate binary on the same runner, sequentially per backend.\n- Nine absolute inputs cover short/long ASCII, normalization, Unicode/IDNA, IPv4, IPv6, file URLs, and credentials. Separate cases measure parse only and parse plus canonical serialization. Short/long inputs additionally use UTF-16 view offset 1. Three relative inputs use pre-parsed bases. Form-query cases include decoding and serialization.\n- Data construction is outside timing. Required public API adapters are timed, including StringView-to-String for urllib and UTF-8 conversion for moonurl's form decoder. Generic adapter callbacks and bench.keep optimizer barriers are included for every library. Getter allocation and eager/lazy serialization choices therefore affect roundtrip measurements.\n- The SIMD request uses checked V128 scans on native/Wasm and scalar fallback on Wasm GC/JS. Its canonical UTF-16 guard stays scalar below 64 code units; general UTF-8 scans use 16-byte blocks. This port does not use Ada's architecture-specific AVX-512 IP kernels or optional simdutf dependency.\n- Release mode, 10 batch samples, and 5% winsorization. Calibration targets about 100 ms; fast cases use 100000 iterations per batch. **Bold** marks the smallest measured mean in a row; `*` marks CV >= 5%. Compare within a runner/backend; these are workload-specific hosted measurements.\n\n",
  )
  builder.write_string(
    "## Runner context\n\n| OS | CPU | Architecture / logical CPUs | Runner / image | Node.js |\n| --- | --- | --- | --- | --- |\n",
  )
  for record in records {
    let cpu = field(record, "cpu")
    builder.write_string(
      "| \{text(record, "os")} | \{cell(text(cpu, "model"))} | \{cell(text(cpu, "architecture"))} / \{display(field(cpu, "logical_cpus"))} | \{cell(text(record, "runner_label"))} / \{cell(text(record, "image_os"))} / \{cell(text(record, "image_version"))} | \{cell(text(record, "node"))} |\n",
    )
  }
  builder.write_string("\n")
  url_table(
    builder, records, "Short absolute URL: parse latency (ns)", "parse-short", "0",
    "ns",
  )
  url_table(
    builder, records, "ASCII path/query/fragment: parse latency (ns)", "parse-ascii",
    "0", "ns",
  )
  url_table(
    builder, records, "Long ASCII URL: parse latency (us)", "parse-long", "0", "us",
  )
  url_table(
    builder, records, "Long ASCII URL: UTF-8-equivalent throughput (GiB/s)", "parse-long",
    "0", "GiB/s",
  )
  url_table(
    builder, records, "Unicode URL with IDNA: parse latency (us)", "parse-unicode",
    "0", "us",
  )
  url_table(
    builder, records, "Normalization and serialization: latency (us)", "roundtrip-normalize",
    "0", "us",
  )
  url_table(
    builder, records, "Relative path resolution and serialization: latency (us)",
    "resolve-roundtrip-path", "0", "us",
  )
  url_table(
    builder, records, "Long offset-1 view and serialization: latency (us)", "roundtrip-long",
    "1", "us",
  )
  url_table(
    builder, records, "Decoded form query and serialization: latency (us)", "form-roundtrip",
    "0", "us",
  )
  builder.write_string(
    "<details>\n<summary>Toolchain, commands, and reproduction</summary>\n\n",
  )
  for record in records {
    builder.write_string(
      "**\{text(record, "os")}:**\n\n~~~text\n\{text(record, "toolchain")}\n~~~\n\n",
    )
    for backend in array(record, "backends") {
      builder.write_string(
        "\{text(backend, "backend")}: \{text(backend, "started_at_utc")} to \{text(backend, "finished_at_utc")} (UTC).\n\n~~~text\n\{text(backend, "command")}\n~~~\n\n",
      )
    }
  }
  builder.write_string(
    "Run `moon -C benchmarks test --target all`, then `moon run scripts/benchmark.mbtx url` for local measurements. CI uses the same release commands sequentially. The report generator rejects local data, incomplete case sets, mixed revisions/runs/attempts, and changed dependency versions. Raw logs are retained for 90 days; the committed JSON preserves the complete snapshot.\n\n</details>\n",
  )
  builder.to_string()
}

///|
/// Renders one UUID public-operation comparison for all twelve environments.
fn uuid_table(
  builder : StringBuilder,
  records : Array[Json],
  title : String,
  workload : String,
  bytes : String,
  offset : String,
  units : String,
  implementations~ : Array[String] = [
    "own-scalar", "own-simd", "bobzhang", "f4ah6o", "moonbitstack", "wulisususu",
  ],
) -> Unit raise {
  results_table(
    builder,
    records,
    title,
    workload,
    bytes,
    offset,
    units,
    @string.parse_int(bytes).to_double(),
    implementations~,
    labels=implementations.map(label => {
      if label == "own-scalar" {
        "ours scalar"
      } else if label == "own-simd" {
        "ours SIMD request"
      } else {
        label
      }
    }),
  )
}

///|
/// Renders a concise UUID comparison with every case preserved in the JSON snapshot.
fn uuid_report(records : Array[Json]) -> String raise {
  let first = records[0]
  let revision = text(first, "source_commit")
  let repository = text(first, "repository")
  let builder = StringBuilder()
  builder.write_string("# UUID performance comparison\n\n")
  builder.write_string(
    "[CI run \{text(first, "run_id")}](\{text(first, "run_url")}) | [source \{revision[:7]}](https://github.com/\{repository}/commit/\{revision}) | attempt \{text(first, "run_attempt")}\n\n",
  )
  builder.write_string(
    "**Scope:** 3 operating systems x 4 backends x 193 cases = **2316 measurements**. [BENCHMARK-DATA.json](BENCHMARK-DATA.json) retains every unrounded statistic, UUID count, byte/code-unit length, view/output offset, command, timestamp, dependency, and runner detail.\n\n## At a glance\n\nNative hyphenated parsing, 36 ASCII code units per UUID:\n\n",
  )
  for record in records {
    let backends = array(record, "backends")
    let position = backends
      .search_by(backend => text(backend, "backend") == "native")
      .unwrap_or_else(() => fail("Missing native UUID results"))
    let values = index(backends[position])
    let scalar = number(values["parse-hyphenated:own-scalar:36:0"], "mean")
    let vector = number(values["parse-hyphenated:own-simd:36:0"], "mean")
    let mut fastest = "bobzhang"
    let mut external = number(values["parse-hyphenated:bobzhang:36:0"], "mean")
    for label in ["f4ah6o", "moonbitstack", "wulisususu"] {
      let mean = number(values["parse-hyphenated:\{label}:36:0"], "mean")
      if mean < external {
        fastest = label
        external = mean
      }
    }
    builder.write_string(
      "- **\{text(record, "os")}:** SIMD request \{metric(values["parse-hyphenated:own-simd:36:0"], "ns", 36)} ns; **\{decimal(scalar / vector)}x** scalar and **\{decimal(external / vector)}x** the fastest external mean (\{fastest}).\n",
    )
  }
  builder.write_string(
    "\nRatios below 1 mean slower execution. These are workload-specific measured means; variability marks and the full distributions qualify the comparisons.\n\n## Implementations\n\n| Label | Package / pinned version | Public API measured |\n| --- | --- | --- |\n| ours scalar | justjavac/uuid / source above | parse and format with Scalar |\n| ours SIMD request | justjavac/uuid / source above | parse and format with Simd |\n",
  )
  for dependency in array(first, "comparison_dependencies") {
    builder.write_string(
      "| \{cell(text(dependency, "label"))} | \{cell(text(dependency, "package"))} / \{cell(text(dependency, "version"))} | \{cell(text(dependency, "api"))} |\n",
    )
  }
  builder.write_string(
    "\n## Method\n\n- Every adapter matches independent binary values and arithmetic formatting oracles, including a deterministic 1024-UUID corpus. f4ah6o is a bobzhang fork; agreement is not independent proof of complete grammar conformance.\n- Parse-only and parse-plus-canonical-formatting are separate. Formatting starts from UUID values prepared outside the timer. Batch callbacks include public calls, adapter logic, and a keep barrier for each of 1024 distinct UUIDs.\n- Input construction and subview selection are outside timing. Required StringView-to-String conversions for bobzhang, f4ah6o, and wulisususu stay inside timing. Full views can reuse their String; offset-1 views materialize their contents. bobzhang/f4ah6o use from_urn for the URN case.\n- bobzhang/f4ah6o expose no braced parser; those cases are omitted. wulisususu exposes no compact formatter; it is omitted from that comparison. Uppercase formatting, arbitrary-byte parsing, and reusable-buffer writes compare our scalar and SIMD paths separately.\n- The SIMD request executes checked portable V128 kernels on native and linear-memory Wasm, with scalar fallback on Wasm GC/JS. UTF-16 loads account for the view's code-unit start; byte loads and output stores stay inside their ranges. Output-string allocation and ASCII decoding are timed; write_* reuses a prepared buffer.\n- Release mode, sequential backends, 10 batch samples, and 5% winsorization. Calibration targets about 100 ms; submicrosecond cases use 100000 calls per batch. Timings include bench.keep. **Bold** marks the smallest mean in a row; `*` marks CV >= 5% and possible noise, not statistical significance.\n\n## Runner context\n\n| OS | CPU | Architecture / logical CPUs | Runner / image | Node.js |\n| --- | --- | --- | --- | --- |\n",
  )
  for record in records {
    let cpu = field(record, "cpu")
    builder.write_string(
      "| \{text(record, "os")} | \{cell(text(cpu, "model"))} | \{cell(text(cpu, "architecture"))} / \{display(field(cpu, "logical_cpus"))} | \{cell(text(record, "runner_label"))} / \{cell(text(record, "image_os"))} / \{cell(text(record, "image_version"))} | \{cell(text(record, "node"))} |\n",
    )
  }
  builder.write_string("\n")
  uuid_table(
    builder, records, "Hyphenated UUID: parse latency (ns)", "parse-hyphenated",
    "36", "0", "ns",
  )
  uuid_table(
    builder, records, "Compact UUID: parse latency (ns)", "parse-simple", "32", "0",
    "ns",
  )
  uuid_table(
    builder, records, "Hyphenated UUID: parse and canonical output (ns)", "roundtrip-hyphenated",
    "36", "0", "ns",
  )
  uuid_table(
    builder, records, "Prepared UUID: hyphenated formatting (ns)", "format-hyphenated",
    "16", "0", "ns",
  )
  uuid_table(
    builder,
    records,
    "Prepared UUID: compact formatting (ns)",
    "format-simple",
    "16",
    "0",
    "ns",
    implementations=[
      "own-scalar", "own-simd", "bobzhang", "f4ah6o", "moonbitstack",
    ],
  )
  uuid_table(
    builder, records, "Hyphenated UUID: offset-1 StringView parsing (ns)", "parse-hyphenated",
    "36", "1", "ns",
  )
  uuid_table(
    builder, records, "1024 distinct UUIDs: batch parse latency (us)", "parse-batch1024",
    "36864", "0", "us",
  )
  uuid_table(
    builder,
    records,
    "Hyphenated bytes: offset-1 parsing (ns)",
    "parse-bytes-hyphenated",
    "36",
    "1",
    "ns",
    implementations=["own-scalar", "own-simd"],
  )
  uuid_table(
    builder,
    records,
    "Reusable output buffer: offset-1 hyphenated write (ns)",
    "write-hyphenated-lower",
    "16",
    "1",
    "ns",
    implementations=["own-scalar", "own-simd"],
  )
  builder.write_string(
    "<details>\n<summary>Toolchain, commands, and reproduction</summary>\n\n",
  )
  for record in records {
    builder.write_string(
      "**\{text(record, "os")}:**\n\n~~~text\n\{text(record, "toolchain")}\n~~~\n\n",
    )
  }
  builder.write_string(
    "Run `moon -C benchmarks test --target all`, then `moon run scripts/benchmark.mbtx uuid` for local measurements. Select uuid in the Benchmarks workflow for a complete CI snapshot. The collector and report validator require the exact 193-case inventory; the report also rejects local data, incomplete matrices, mixed runs/attempts/source revisions, changed dependency pins, invalid statistics, and mismatched length metadata. Raw logs are retained for 90 days. Reports retain the measured source commit when committed later.\n\n</details>\n",
  )
  builder.to_string()
}

///|
/// Builds a complete synthetic UUID summary exclusively for validator regression tests.
fn uuid_test_summary(name : String) -> Json raise {
  let values = uuid_case_metadata(name)
  for
    (key, value) in [
      ("name", Json(name)),
      ("mean", Json(1)),
      ("min", Json(1)),
      ("max", Json(1)),
      ("median", Json(1)),
      ("std_dev", Json(0)),
      ("std_dev_pct", Json(0)),
      ("sum", Json(10)),
      ("variance", Json(0)),
      ("median_abs_dev", Json(0)),
      ("median_abs_dev_pct", Json(0)),
      ("iqr", Json(0)),
      ("runs", Json(10)),
      ("batch_size", Json(100000)),
      ("quartiles", Json([1, 1, 1])),
    ] {
    values[key] = value
  }
  Json(values)
}

///|
/// Builds a complete synthetic CI record exclusively for publication-validator tests.
fn uuid_test_record(os : String, summaries : Array[Json]) -> Json {
  let backends : Array[Json] = []
  for backend in ["native", "wasm", "wasm-gc", "js"] {
    backends.push({
      "backend": backend,
      "time_unit": "microseconds",
      "command": "moon -C benchmarks bench --target \{backend} --release --no-parallelize -p justjavac/benchmarks/uuid",
      "started_at_utc": "2026-11-25T00:00:00Z",
      "finished_at_utc": "2026-11-25T00:01:00Z",
      "summaries": Json(summaries),
    })
  }
  {
    "source": "github-actions",
    "source_commit": String::make(40, 'a'),
    "repository": "test/validator-only",
    "module": "justjavac/uuid",
    "os": os,
    "run_id": "42",
    "run_attempt": "1",
    "run_url": "https://github.com/test/validator-only/actions/runs/42",
    "working_tree_dirty": false,
    "module_manifest": "name = \"justjavac/uuid\"\nlicense = \"MIT\"\n",
    "comparison_manifest": "bobzhang/uuidm@0.2.0\nf4ah6o/uuidm@0.2.1\nmoonbitstack/moonuuid@0.2.1\nwulisususu/moonuuid@0.1.0\n",
    "dependency_tree": "Synthetic validator test fixture",
    "runner_label": os,
    "image_os": os,
    "image_version": "test-image",
    "node": "v24.0.0",
    "toolchain": "moon test (abc 2026-11-25) /tool/moon\nmoonc test (abc 2026-11-25) /tool/moonc\nmoonrun test (abc 2026-11-25) /tool/moonrun",
    "cpu": {
      "model": "Validator test CPU",
      "architecture": "test64",
      "logical_cpus": 4,
    },
    "comparison_dependencies": [
      {
        "label": "bobzhang",
        "package": "bobzhang/uuidm",
        "version": "0.2.0",
        "license": "ISC",
        "api": "test",
      },
      {
        "label": "f4ah6o",
        "package": "f4ah6o/uuidm",
        "version": "0.2.1",
        "license": "ISC",
        "api": "test",
      },
      {
        "label": "moonbitstack",
        "package": "moonbitstack/moonuuid",
        "version": "0.2.1",
        "license": "Apache-2.0",
        "api": "test",
      },
      {
        "label": "wulisususu",
        "package": "wulisususu/moonuuid",
        "version": "0.1.0",
        "license": "Apache-2.0",
        "api": "test",
      },
    ],
    "backends": Json(backends),
  }
}

///|
/// Checks exact inventories, metadata, distributions, and publication safeguards.
fn uuid_self_test() -> Unit raise {
  assert_eq(expected_uuid_names().length(), 193)
  let summaries : Array[Json] = []
  for (name, _) in expected_uuid_names() {
    summaries.push(uuid_test_summary(name))
  }
  validate_uuid_inventory(summaries)
  for summary in summaries {
    validate_uuid_statistics(summary)
  }
  let substituted = summaries.copy()
  substituted[0] = uuid_test_summary("parse-hyphenated:unrequested:36:0")
  try validate_uuid_inventory(substituted) catch {
    _ => ()
  } noraise {
    _ => fail("A substituted UUID case must fail")
  }
  let duplicate = summaries.copy()
  duplicate[0] = duplicate[1]
  try validate_uuid_inventory(duplicate) catch {
    _ => ()
  } noraise {
    _ => fail("Duplicate UUID cases must fail")
  }
  try validate_uuid_inventory(summaries[:192].to_owned()) catch {
    _ => ()
  } noraise {
    _ => fail("Missing UUID cases must fail")
  }
  let incorrect = uuid_test_summary("parse-hyphenated:own-simd:36:0")
  guard incorrect is Object(fields) else { fail("Expected a test object") }
  fields["input_code_units"] = Json(32)
  let wrong_metadata = summaries.copy()
  let metadata_index = summaries
    .search_by(summary => {
      text(summary, "name") == "parse-hyphenated:own-simd:36:0"
    })
    .unwrap_or_else(() => fail("Missing metadata test case"))
  wrong_metadata[metadata_index] = incorrect
  try validate_uuid_inventory(wrong_metadata) catch {
    _ => ()
  } noraise {
    _ => fail("Incorrect UTF-16 length must fail")
  }
  for
    (key, bad_value) in [
      ("batch_size", Json(1.5)),
      ("sum", Json(11)),
      ("variance", Json(-1)),
      ("quartiles", Json([1, 2, 1])),
    ] {
    let invalid = uuid_test_summary("parse-simple:own-scalar:32:0")
    guard invalid is Object(values) else { fail("Expected a test summary") }
    values[key] = bad_value
    try validate_uuid_statistics(invalid) catch {
      _ => ()
    } noraise {
      _ => fail("Invalid UUID statistics must fail")
    }
  }
  assert_eq(
    number(
      uuid_test_summary("write-simple-upper:own-simd:16:1"),
      "output_offset",
    ),
    1,
  )
  assert_eq(
    number(uuid_test_summary("parse-batch1024:own-simd:36864:0"), "uuid_count"),
    1024,
  )
  let records = ["linux", "macos", "windows"].map(os => {
    uuid_test_record(os, summaries)
  })
  validate_snapshot(records, "uuid")
  assert_true(report("uuid", records).find("2316 measurements") is Some(_))
  for
    (key, value) in [
      ("source", Json("local")),
      ("source_commit", Json(String::make(40, 'b'))),
      ("run_attempt", Json("2")),
      ("working_tree_dirty", Json(true)),
      ("comparison_manifest", Json("unpinned")),
      ("module_manifest", Json("wrong module")),
      ("node", Json("v25.0.0")),
      ("runner_label", Json("")),
    ] {
    let changed = @json.parse(records[1].stringify())
    guard changed is Object(values) else { fail("Expected a test record") }
    values[key] = value
    let invalid = records.copy()
    invalid[1] = changed
    try validate_snapshot(invalid, "uuid") catch {
      _ => ()
    } noraise {
      _ => fail("Invalid UUID provenance must fail")
    }
  }
  try validate_snapshot(records[:2].to_owned(), "uuid") catch {
    _ => ()
  } noraise {
    _ => fail("A missing UUID OS must fail")
  }
  let invalid_backend = @json.parse(
    array(records[0], "backends")[0].stringify(),
  )
  guard invalid_backend is Object(backend_fields) else {
    fail("Expected a backend")
  }
  let invalid_summary = uuid_test_summary(text(summaries[0], "name"))
  guard invalid_summary is Object(summary_fields) else {
    fail("Expected a summary")
  }
  summary_fields["mean"] = Json(0)
  let wrong_range = summaries.copy()
  wrong_range[0] = invalid_summary
  backend_fields["summaries"] = Json(wrong_range)
  try validate_backend(invalid_backend, "uuid") catch {
    _ => ()
  } noraise {
    _ => fail("A zero UUID timing must fail")
  }
}

///|
/// Tests report parsing, precise suffix labels, and rejection of fabricated provenance.
fn self_test() -> Unit raise {
  uuid_self_test()
  let valid : Json = {
    "name": "combine:gf2:18446744073709551615:0",
    "mean": 1.0,
  }
  assert_eq(case_parts(valid)[2], "18446744073709551615")
  assert_eq(throughput("combine", "18446744073709551615", 1.0), "n/a")
  assert_eq(throughput("hash", "0", 1.0), "n/a")
  assert_eq(cell("a|b\nc"), "a\\|b c")
  assert_eq(cell("a|b|c\nd\ne"), "a\\|b\\|c d e")
  assert_eq(expected_url_keys().length(), 144)
  let url_cases : Array[Json] = []
  for (key, _) in expected_url_keys() {
    let parts = key.split(":").map(view => view.to_owned()).to_array()
    url_cases.push({ "name": "\{parts[0]}:\{parts[1]}:1:\{parts[2]}" })
  }
  validate_url_inventory(url_cases)
  let substituted = url_cases.copy()
  substituted[0] = { "name": "parse-short:unrequested-library:1:0" }
  try validate_url_inventory(substituted) catch {
    _ => ()
  } noraise {
    _ => fail("A substituted URL case must fail even with 144 entries")
  }
  try validate_url_inventory([]) catch {
    _ => ()
  } noraise {
    _ => fail("Incomplete URL cases must fail")
  }
  assert_eq(metric({ "mean": 1.25, "std_dev_pct": 4.9 }, "ns", 64), "1250")
  assert_eq(metric({ "mean": 1.25, "std_dev_pct": 5 }, "us", 64), "1.25*")
  assert_eq(
    metric({ "mean": 976.5625, "std_dev_pct": 0 }, "GiB/s", 1048576),
    "1",
  )
  try validate_snapshot([], "crc32") catch {
    _ => ()
  } noraise {
    _ => fail("An incomplete snapshot must fail")
  }
  try number({ "mean": "invalid" }, "mean") catch {
    _ => ()
  } noraise {
    _ => fail("A malformed numeric statistic must fail")
  }
}

///|
/// Writes one uppercase BENCHMARK.md and its complete JSON snapshot per module.
async fn main {
  let arguments = @env.args()
  if arguments.length() == 2 && arguments[1] == "--self-test" {
    self_test()
    println("Benchmark report self-test passed")
    return
  }
  guard arguments.length() == 3 else {
    fail(
      "Usage: moon run scripts/benchmark_report.mbtx <input-directory> <output-directory>",
    )
  }
  let input = arguments[1]
  let output = arguments[2]
  let members = @fs.readdir(input, sort=true)
  guard !members.is_empty() else { fail("No module artifacts were found") }
  for package_dir in members {
    guard package_dir != "." &&
      package_dir != ".." &&
      package_dir.find("/") is None &&
      package_dir.find("\\") is None else {
      fail("Invalid module directory")
    }
    let records : Array[Json] = []
    for os in ["linux", "macos", "windows"] {
      records.push(
        @json.parse(@fs.read_text("\{input}/\{package_dir}/\{os}.json")),
      )
    }
    let markdown = report(package_dir, records)
    let directory = "\{output}/\{package_dir}"
    @fs.mkdir(directory, recursive=true, allow_existing=true)
    @fs.write_text("\{directory}/BENCHMARK.md", markdown)
    @fs.write_text(
      "\{directory}/BENCHMARK-DATA.json",
      Json(records).stringify(indent=2),
    )
    println("Generated \{directory}/BENCHMARK.md")
  }
}
