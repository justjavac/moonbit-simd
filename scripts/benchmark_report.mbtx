      "finished_at_utc": "2026-11-25T00:01:00Z",
      "summaries": Json(summaries),
    })
  }
  {
    "source": "github-actions",
    "source_commit": String::make(40, 'a'),
    "repository": "test/validator-only",
    "module": "justjavac/uuid",
    "os": os,
    "run_id": "42",
    "run_attempt": "1",
    "run_url": "https://github.com/test/validator-only/actions/runs/42",
    "working_tree_dirty": false,
    "module_manifest": "name = \"justjavac/uuid\"\nlicense = \"MIT\"\n",
    "comparison_manifest": "bobzhang/uuidm@0.2.0\nf4ah6o/uuidm@0.2.1\nmoonbitstack/moonuuid@0.2.1\nwulisususu/moonuuid@0.1.0\n",
    "dependency_tree": "Synthetic validator test fixture",
    "runner_label": os,
    "image_os": os,
    "image_version": "test-image",
    "node": "v24.0.0",
    "toolchain": "moon test (abc 2026-11-25) /tool/moon\nmoonc test (abc 2026-11-25) /tool/moonc\nmoonrun test (abc 2026-11-25) /tool/moonrun",
    "cpu": {
      "model": "Validator test CPU",
      "architecture": "test64",
      "logical_cpus": 4,
    },
    "comparison_dependencies": [
      {
        "label": "bobzhang",
        "package": "bobzhang/uuidm",
        "version": "0.2.0",
        "license": "ISC",
        "api": "test",
      },
      {
        "label": "f4ah6o",
        "package": "f4ah6o/uuidm",
        "version": "0.2.1",
        "license": "ISC",
        "api": "test",
      },
      {
        "label": "moonbitstack",
        "package": "moonbitstack/moonuuid",
        "version": "0.2.1",
        "license": "Apache-2.0",
        "api": "test",
      },
      {
        "label": "wulisususu",
        "package": "wulisususu/moonuuid",
        "version": "0.1.0",
        "license": "Apache-2.0",
        "api": "test",
      },
    ],
    "backends": Json(backends),
  }
}

///|
/// Checks exact inventories, metadata, distributions, and publication safeguards.
fn uuid_self_test() -> Unit raise {
  assert_eq(expected_uuid_names().length(), 193)
  let summaries : Array[Json] = []
  for (name, _) in expected_uuid_names() {
    summaries.push(uuid_test_summary(name))
  }
  validate_uuid_inventory(summaries)
  for summary in summaries {
    validate_uuid_statistics(summary)
  }
  let substituted = summaries.copy()
  substituted[0] = uuid_test_summary("parse-hyphenated:unrequested:36:0")
  try validate_uuid_inventory(substituted) catch {
    _ => ()
  } noraise {
    _ => fail("A substituted UUID case must fail")
  }
  let duplicate = summaries.copy()
  duplicate[0] = duplicate[1]
  try validate_uuid_inventory(duplicate) catch {
    _ => ()
  } noraise {
    _ => fail("Duplicate UUID cases must fail")
  }
  try validate_uuid_inventory(summaries[:192].to_owned()) catch {
    _ => ()
  } noraise {
    _ => fail("Missing UUID cases must fail")
  }
  let incorrect = uuid_test_summary("parse-hyphenated:own-simd:36:0")
  guard incorrect is Object(fields) else { fail("Expected a test object") }
  fields["input_code_units"] = Json(32)
  let wrong_metadata = summaries.copy()
  let metadata_index = summaries
    .search_by(summary => {
      text(summary, "name") == "parse-hyphenated:own-simd:36:0"
    })
    .unwrap_or_else(() => fail("Missing metadata test case"))
  wrong_metadata[metadata_index] = incorrect
  try validate_uuid_inventory(wrong_metadata) catch {
    _ => ()
  } noraise {
    _ => fail("Incorrect UTF-16 length must fail")
  }
  for
    (key, bad_value) in [
      ("batch_size", Json(1.5)),
      ("sum", Json(11)),
      ("variance", Json(-1)),
      ("quartiles", Json([1, 2, 1])),
    ] {
    let invalid = uuid_test_summary("parse-simple:own-scalar:32:0")
    guard invalid is Object(values) else { fail("Expected a test summary") }
    values[key] = bad_value
    try validate_uuid_statistics(invalid) catch {
      _ => ()
    } noraise {
      _ => fail("Invalid UUID statistics must fail")
    }
  }
  assert_eq(
    number(
      uuid_test_summary("write-simple-upper:own-simd:16:1"),
      "output_offset",
    ),
    1,
  )
  assert_eq(
    number(uuid_test_summary("parse-batch1024:own-simd:36864:0"), "uuid_count"),
    1024,
  )
  let records = ["linux", "macos", "windows"].map(os => {
    uuid_test_record(os, summaries)
  })
  validate_snapshot(records, "uuid")
  assert_true(report("uuid", records).find("2316 measurements") is Some(_))
  for
    (key, value) in [
      ("source", Json("local")),
      ("source_commit", Json(String::make(40, 'b'))),
      ("run_attempt", Json("2")),
      ("working_tree_dirty", Json(true)),
      ("comparison_manifest", Json("unpinned")),
      ("module_manifest", Json("wrong module")),
      ("node", Json("v25.0.0")),
      ("runner_label", Json("")),
    ] {
    let changed = @json.parse(records[1].stringify())
    guard changed is Object(values) else { fail("Expected a test record") }
    values[key] = value
    let invalid = records.copy()
    invalid[1] = changed
    try validate_snapshot(invalid, "uuid") catch {
      _ => ()
    } noraise {
      _ => fail("Invalid UUID provenance must fail")
    }
  }
  try validate_snapshot(records[:2].to_owned(), "uuid") catch {
    _ => ()
  } noraise {
    _ => fail("A missing UUID OS must fail")
  }
  let invalid_backend = @json.parse(
    array(records[0], "backends")[0].stringify(),
  )
  guard invalid_backend is Object(backend_fields) else {
    fail("Expected a backend")
  }
  let invalid_summary = uuid_test_summary(text(summaries[0], "name"))
  guard invalid_summary is Object(summary_fields) else {
    fail("Expected a summary")
  }
  summary_fields["mean"] = Json(0)
  let wrong_range = summaries.copy()
  wrong_range[0] = invalid_summary
  backend_fields["summaries"] = Json(wrong_range)
  try validate_backend(invalid_backend, "uuid") catch {
    _ => ()
  } noraise {
    _ => fail("A zero UUID timing must fail")
  }
}

///|
/// Validates every UTF-8 distribution statistic and integral sample batch size.
fn validate_utf8_statistics(summary : Json) -> Unit raise {
  let quartiles = array(summary, "quartiles")
  guard quartiles is [Number(low, ..), Number(middle, ..), Number(high, ..)] else {
    fail("UTF-8 quartiles require three numeric values")
  }
  let minimum = number(summary, "min")
  let maximum = number(summary, "max")
  let tolerance = maximum.abs() * 0.000000000001 + 0.000000000001
  guard low.is_finite() &&
    middle.is_finite() &&
    high.is_finite() &&
    minimum <= low + tolerance &&
    low <= middle + tolerance &&
    middle <= high + tolerance &&
    high <= maximum + tolerance &&
    (middle - number(summary, "median")).abs() <= tolerance else {
    fail("Invalid UTF-8 quartile range")
  }
  for
    statistic in [
      "sum", "variance", "median_abs_dev", "median_abs_dev_pct", "iqr",
    ] {
    guard number(summary, statistic) >= 0 else {
      fail("Invalid UTF-8 statistic: \{statistic}")
    }
  }
  let batch = number(summary, "batch_size")
  guard batch >= 1 && batch.floor() == batch else {
    fail("UTF-8 batch size must be integral")
  }
  guard (number(summary, "iqr") - (high - low)).abs() <= tolerance &&
    (number(summary, "sum") - number(summary, "mean") * number(summary, "runs")).abs() <=
    tolerance * 10 else {
    fail("Inconsistent UTF-8 distribution statistics")
  }
}

///|
/// Defines every UTF-8 workload, byte count, API mode, view offset, and stream size.
fn expected_utf8_names() -> Map[String, Unit] {
  let expected : Map[String, Unit] = Map([])
  for
    (label, length) in [
      ("empty", 0),
      ("ascii-15", 15),
      ("ascii-64", 64),
      ("ascii-4k", 4096),
      ("ascii-1m", 1048576),
      ("latin-4k", 4096),
      ("cjk-4k", 4095),
      ("emoji-4k", 4096),
      ("mixed-4k", 4096),
      ("cjk-1m", 1048575),
      ("emoji-1m", 1048576),
    ] {
    let offsets = if ["ascii-4k", "cjk-4k", "emoji-4k"].contains(label) {
      [0, 1]
    } else {
      [0]
    }
    for prefix in ["validate-", "decode-"] {
      let implementations = if prefix == "validate-" {
        [
          "own-basic-scalar", "own-basic-simd", "own-compat", "tonyfettes", "core",
        ]
      } else {
        ["own-scalar", "own-simd", "tonyfettes", "core"]
      }
      for implementation in implementations {
        for offset in offsets {
          expected["\{prefix}\{label}:\{implementation}:\{length}:\{offset}"] = ()
        }
      }
    }
  }
  for
    label in [
      "invalid-start", "invalid-end", "invalid-overlong", "invalid-truncated",
    ] {
    for
      implementation in [
        "own-basic-scalar", "own-basic-simd", "own-compat", "tonyfettes", "core",
      ] {
      expected["\{label}:\{implementation}:65536:0"] = ()
    }
  }
  for label in ["ascii", "mixed"] {
    for implementation in ["own-scalar", "own-simd"] {
      for chunk in [1, 64, 4096] {
        expected["stream-\{label}:\{implementation}:65536:\{chunk}"] = ()
      }
    }
  }
  expected
}

///|
/// Rejects missing, duplicate, or substituted UTF-8 cases using complete names.
fn validate_utf8_inventory(summaries : Array[Json]) -> Unit raise {
  let expected = expected_utf8_names()
  guard summaries.length() == expected.length() else {
    fail("Expected 158 UTF-8 cases")
  }
  for summary in summaries {
    let name = text(summary, "name")
    guard expected.contains(name) else {
      fail("Unexpected UTF-8 benchmark: \{name}")
    }
    let _ = expected.remove(name)
  }
  guard expected.is_empty() else { fail("Incomplete UTF-8 inventory") }
}

///|
/// Validates an explicitly local UTF-8 record without authorizing it as a CI snapshot.
fn validate_local_utf8(record : Json) -> Unit raise {
  guard text(record, "module") == "justjavac/utf8" &&
    text(record, "source") == "local" &&
    text(record, "run_id") == "" &&
    text(record, "run_url") == "" &&
    text(record, "run_attempt") == "" else {
    fail("The local renderer requires a local UTF-8 collector artifact")
  }
  guard ["linux", "macos", "windows"].contains(text(record, "os")) &&
    text(field(record, "cpu"), "model") != "" else {
    fail("Missing local runner identity")
  }
  let backends = array(record, "backends")
  guard backends.length() == 4 else {
    fail("Local reports require all four backends")
  }
  let names : Map[String, Unit] = Map([])
  for backend in backends {
    let name = text(backend, "backend")
    guard !names.contains(name) else { fail("Duplicate local backend") }
    names[name] = ()
    validate_backend(backend, "utf8")
  }
}

///|
/// Renders a UTF-8 comparison with the correct public API variants and adaptation labels.
fn utf8_table(
  builder : StringBuilder,
  records : Array[Json],
  title : String,
  workload : String,
  bytes : String,
  parameter : String,
  units : String,
) -> Unit raise {
  let decoding = workload.find("decode-") is Some(0)
  let streaming = workload.find("stream-") is Some(0)
  results_table(
    builder,
    records,
    title,
    workload,
    bytes,
    parameter,
    units,
    @string.parse_int(bytes).to_double(),
    implementations=if streaming {
      ["own-scalar", "own-simd"]
    } else if decoding {
      ["own-scalar", "own-simd", "tonyfettes", "core"]
    } else {
      ["own-basic-scalar", "own-basic-simd", "own-compat", "tonyfettes", "core"]
    },
    labels=if streaming {
      ["ours scalar", "ours SIMD request"]
    } else if decoding {
      ["ours scalar", "ours SIMD request", "tonyfettes decode", "core decode"]
    } else {
      [
        "ours basic scalar", "ours basic SIMD request", "ours compat", "tonyfettes wrapper",
        "core decode",
      ]
    },
  )
}

///|
/// Builds a UTF-8 report while visibly distinguishing local data from a complete CI run.
fn utf8_report(records : Array[Json], is_local~ : Bool = false) -> String raise {
  let first = records[0]
  let builder = StringBuilder()
  builder.write_string("# UTF-8 performance comparison\n\n")
  if is_local {
    builder.write_string(
      "**Local \{text(first, "os")} measurement; not a published CI snapshot.** Source HEAD `\{text(first, "source_commit")}`; working tree dirty: \{display(field(first, "working_tree_dirty"))}.\n\n",
    )
  } else {
    let revision = text(first, "source_commit")
    builder.write_string(
      "[CI run \{text(first, "run_id")}](\{text(first, "run_url")}) | [source \{revision[:7]}](https://github.com/\{text(first, "repository")}/commit/\{revision}) | attempt \{text(first, "run_attempt")}\n\n",
    )
  }
  let data_file = if is_local {
    "LOCAL-BENCHMARK-DATA.json"
  } else {
    "BENCHMARK-DATA.json"
  }
  builder.write_string(
    "**Scope:** \{records.length()} OS x 4 backends x 158 cases = **\{records.length() * 632} measurements**. [\{data_file}](\{data_file}) preserves every case and unrounded statistic, sample metadata, commands, timestamps, manifests, dependencies, CPU, and toolchain.\n\n",
  )
  builder.write_string(
    "## APIs and adaptation\n\n| Label | Public API measured |\n| --- | --- |\n| ours basic scalar / SIMD request | is_valid(BytesView, simd=false/true); no UTF-16 decoding |\n| ours compat | validate(BytesView, simd=true), including exact error recovery |\n| tonyfettes wrapper | Utf8.of_bytesview; wrapper allocation and partial-view materialization |\n| core decode acceptance | Strict decode(ignore_bom=false), including UTF-16 allocation |\n| ours scalar / SIMD decoding | from_utf8, including validation and UTF-16 decoding |\n| tonyfettes / core decoding | Strict decode with identical final UTF-16 output |\n\n",
  )
  builder.write_string(
    "| Dependency | Pinned version | License |\n| --- | --- | --- |\n",
  )
  for dependency in array(first, "comparison_dependencies") {
    builder.write_string(
      "| \{cell(text(dependency, "package"))} | \{cell(text(dependency, "version"))} | \{cell(text(dependency, "license"))} |\n",
    )
  }
  builder.write_string(
    "\nThe tonyfettes 0.2.4 copy has manifest/syntax compatibility edits for this toolchain; its original source hash and exact changes are recorded in benchmarks/vendor/tonyfettes-utf8/UPSTREAM.md and JSON metadata. Range checks and decoding formulas are preserved. Core lacks a standalone validation API, so its acceptance baseline necessarily includes decoding. Read the separate decoding tables for equivalent returned-string operations.\n\n",
  )
  builder.write_string(
    "## Method\n\n- All adapters pass the same acceptance and decoded-text corpus before timing. Inputs cover ASCII, Latin, CJK, emoji, mixed text, invalid first/last bytes, a middle overlong sequence, and a truncated suffix. Selected 4 KiB inputs have offset-one views with rejected sentinels outside the view.\n- Input construction and owned stream chunks are prepared outside timing. Public API calls, conversions, error adaptation, state creation/finalization, generic callbacks, and bench.keep barriers are timed. All implementations run in the same binary and on the same runner.\n- SIMD requests use native V128 range masks with sign-flipped comparisons and UInt64 predecessor assembly, or the pinned lookup3 algorithm on linear-memory Wasm. Inputs below 64 bytes and Wasm GC/JS use scalar fallback. Native avoids byte permutation and unsigned-compare emulation on the validated x86 toolchain. The basic vector path aggregates errors; compat and scalar paths can stop early. Invalid-input cases report latency, not whole-buffer throughput.\n- Release mode and sequential backends, with --no-parallelize. The core runner records 10 batch samples and 5% winsorization after calibration around 100 ms; fast cases use 100000 iterations per batch. **Bold** marks the best measured mean; `*` marks CV >= 5% and possible noise. Compare within an OS/backend; a best mean is not evidence of significance.\n\n",
  )
  builder.write_string(
    "## Runner context\n\n| OS | CPU | Architecture / logical CPUs | Node.js |\n| --- | --- | --- | --- |\n",
  )
  for record in records {
    let cpu = field(record, "cpu")
    builder.write_string(
      "| \{text(record, "os")} | \{cell(text(cpu, "model"))} | \{cell(text(cpu, "architecture"))} / \{display(field(cpu, "logical_cpus"))} | \{cell(text(record, "node"))} |\n",
    )
  }
  builder.write_string("\n")
  utf8_table(
    builder, records, "1 MiB ASCII validation: throughput (GiB/s)", "validate-ascii-1m",
    "1048576", "0", "GiB/s",
  )
  utf8_table(
    builder, records, "1 MiB CJK validation: throughput (GiB/s)", "validate-cjk-1m",
    "1048575", "0", "GiB/s",
  )
  utf8_table(
    builder, records, "1 MiB emoji validation: throughput (GiB/s)", "validate-emoji-1m",
    "1048576", "0", "GiB/s",
  )
  utf8_table(
    builder, records, "64-byte ASCII validation: latency (ns)", "validate-ascii-64",
    "64", "0", "ns",
  )
  utf8_table(
    builder, records, "4 KiB offset-one CJK validation: latency (us)", "validate-cjk-4k",
    "4095", "1", "us",
  )
  utf8_table(
    builder, records, "Invalid first byte in 64 KiB: latency (ns)", "invalid-start",
    "65536", "0", "ns",
  )
  utf8_table(
    builder, records, "Invalid last byte in 64 KiB: latency (us)", "invalid-end",
    "65536", "0", "us",
  )
  utf8_table(
    builder, records, "Truncated 64 KiB UTF-8 suffix: latency (us)", "invalid-truncated",
    "65536", "0", "us",
  )
  utf8_table(
    builder, records, "4 KiB mixed text: validation and decoding (us)", "decode-mixed-4k",
    "4096", "0", "us",
  )
  utf8_table(
    builder, records, "1 MiB CJK: validation and decoding (us)", "decode-cjk-1m",
    "1048575", "0", "us",
  )
  utf8_table(
    builder, records, "4 KiB offset-one CJK: validation and decoding (us)", "decode-cjk-4k",
    "4095", "1", "us",
  )
  utf8_table(
    builder, records, "64 KiB mixed stream, 4 KiB chunks: latency (us)", "stream-mixed",
    "65536", "4096", "us",
  )
  builder.write_string(
    "<details>\n<summary>Toolchain and reproduction</summary>\n\n",
  )
  for record in records {
    builder.write_string(
      "**\{text(record, "os")}:**\n\n~~~text\n\{text(record, "toolchain")}\n~~~\n\n",
    )
    for backend in array(record, "backends") {
      builder.write_string(
        "**\{text(backend, "backend")}:** \{text(backend, "started_at_utc")} to \{text(backend, "finished_at_utc")}\n\n~~~text\n\{text(backend, "command")}\n~~~\n\n",
      )
    }
  }
  builder.write_string(
    "Run `moon -C benchmarks test utf8 --target all`, then `moon run scripts/benchmark.mbtx utf8`. A complete CI snapshot requires all three systems and all four backends with identical source/run/attempt/dependencies. Local rendering uses `moon run scripts/benchmark_report.mbtx --local utf8 _build/benchmarks/utf8/windows.json _build/utf8-report` and writes explicitly LOCAL-named artifacts. Raw CI logs are retained for 90 days.\n\n</details>\n",
  )
  builder.to_string()
}

///|
/// Checks exact UTF-8 inventories and malformed distribution metadata.
fn utf8_self_test() -> Unit raise {
  assert_eq(expected_utf8_names().length(), 158)
  let statistics : Json = {
    "min": 0.5,
    "max": 1.5,
    "mean": 1,
    "median": 1,
    "sum": 10,
    "variance": 0.01,
    "median_abs_dev": 0.1,
    "median_abs_dev_pct": 10,
    "quartiles": [0.75, 1, 1.25],
    "iqr": 0.5,
    "batch_size": 100,
    "runs": 10,
  }
  validate_utf8_statistics(statistics)
  let changes : Array[(String, Json)] = [
    ("batch_size", 1.5),
    ("quartiles", [0.75, 1]),
    ("quartiles", [1.25, 1, 0.75]),
    ("quartiles", [0.75, 1, "invalid"]),
    ("variance", -0.01),
    ("sum", "invalid"),
    ("sum", 11),
    ("iqr", 0.75),
  ]
  for (key, value) in changes {
    let malformed = match statistics {
      Object(fields) => {
        let changed = fields.copy()
        changed[key] = value
        Json(changed)
      }
      _ => fail("Expected a test statistic object")
    }
    try validate_utf8_statistics(malformed) catch {
      _ => ()
    } noraise {
      _ => fail("Malformed UTF-8 sample metadata must fail")
    }
  }
  let cases : Array[Json] = []
  for (name, _) in expected_utf8_names() {
    cases.push({ "name": name })
  }
  validate_utf8_inventory(cases)
  for
    changed in [
      "validate-cjk-4k:own-basic-simd:4096:0", "validate-ascii-4k:own-basic-simd:4096:2",
      "decode-ascii-4k:own-compat:4096:0", "stream-mixed:own-simd:65536:65",
    ] {
    let substituted = cases.copy()
    substituted[0] = { "name": changed }
    try validate_utf8_inventory(substituted) catch {
      _ => ()
    } noraise {
      _ => fail("Substituted UTF-8 cases must fail")
    }
  }
  let duplicate = cases.copy()
  duplicate[0] = duplicate[1]
  try validate_utf8_inventory(duplicate) catch {
    _ => ()
  } noraise {
    _ => fail("Duplicate UTF-8 cases must fail")
  }
  try validate_utf8_inventory([]) catch {
    _ => ()
  } noraise {
    _ => fail("An incomplete UTF-8 inventory must fail")
  }
}

///|
/// Tests report parsing, precise suffix labels, and rejection of fabricated provenance.
fn self_test() -> Unit raise {
  utf8_self_test()
  base64_self_test()
  uuid_self_test()
  assert_eq(expected_atoi_names().length(), 176)
  let statistics : Json = {
    "min": 0.5,
    "max": 1.5,
    "mean": 1,
    "median": 1,
    "sum": 10,
    "variance": 0.01,
    "median_abs_dev": 0.1,
    "median_abs_dev_pct": 10,
    "quartiles": [0.75, 1, 1.25],
    "iqr": 0.5,
    "batch_size": 100,
    "runs": 10,
  }
  argminmax_self_test(statistics)
  validate_atoi_statistics(statistics)
  let snapshots = atoi_snapshot_fixture(statistics)
  validate_snapshot(snapshots, "atoi")
  let crlf = snapshots.copy()
  crlf[1] = test_field(
    crlf[1],
    "module_manifest",
    Json(text(crlf[1], "module_manifest").replace_all(old="\n", new="\r\n")),
  )
  validate_snapshot(crlf, "atoi")
  let wrong_upstream = test_field(
    field(snapshots[0], "ported_upstream"),
    "revision",
    "changed",
  )
  let original_backends = array(snapshots[0], "backends")
  for
    (key, replacement) in [
      ("source_commit", Json("1123456789012345678901234567890123456789")),
      ("run_attempt", Json("2")),
      ("module_manifest", Json("changed")),
      ("comparison_manifest", Json("changed")),
      ("ported_upstream", wrong_upstream),
      ("source", Json("local")),
      ("backends", Json(original_backends[:3].to_owned())),
      (
        "backends",
        Json([
          original_backends[0],
          original_backends[0],
          original_backends[2],
          original_backends[3],
        ]),
      ),
    ] {
    let changed = snapshots.copy()
    changed[1] = test_field(changed[1], key, replacement)
    try validate_snapshot(changed, "atoi") catch {
      _ => ()
    } noraise {
      _ => fail("Mixed or incomplete integer provenance must fail: " + key)
    }
  }
  try validate_snapshot(snapshots[:2].to_owned(), "atoi") catch {
    _ => ()
  } noraise {
    _ => fail("A partial integer OS matrix must fail")
  }
  let changes : Array[(String, Json)] = [
    ("batch_size", 1.5),
    ("quartiles", [0.75, 1]),
    ("quartiles", [1.25, 1, 0.75]),
    ("quartiles", [0.75, 1, "invalid"]),
    ("variance", -0.01),
    ("sum", "invalid"),
    ("sum", 11),
    ("iqr", 0.75),
  ]
  for (key, value) in changes {
    let malformed = match statistics {
      Object(fields) => {
        let changed = fields.copy()
        changed[key] = value
        Json(changed)
      }
      _ => fail("Expected a test statistic object")
    }
    try validate_atoi_statistics(malformed) catch {
      _ => ()
    } noraise {
      _ => fail("Malformed integer sample metadata must fail")
    }
  }
  let atoi_cases : Array[Json] = []
  for (name, _) in expected_atoi_names() {
    atoi_cases.push({ "name": name })
  }
  validate_atoi_inventory(atoi_cases)
  for
    changed in [
      "parse-u64-sixteen:own-simd:16:2", "parse-u128-max:own-scalar:38:0", "size-u64:core:64:0",
      "prefix-i64-min:own-simd:20:0",
    ] {
    let substituted = atoi_cases.copy()
    substituted[0] = { "name": changed }
    try validate_atoi_inventory(substituted) catch {
      _ => ()
    } noraise {
      _ => fail("A substituted integer case must fail even with 176 entries")
    }
  }
  let duplicate_atoi = atoi_cases.copy()
  duplicate_atoi[0] = duplicate_atoi[1]
  try validate_atoi_inventory(duplicate_atoi) catch {
    _ => ()
  } noraise {
    _ => fail("Duplicate integer cases must fail")
  }
  try validate_atoi_inventory([]) catch {
    _ => ()
  } noraise {
    _ => fail("An incomplete integer inventory must fail")
  }

  let valid : Json = {
    "name": "combine:gf2:18446744073709551615:0",
    "mean": 1.0,
  }
  assert_eq(case_parts(valid)[2], "18446744073709551615")
  assert_eq(throughput("combine", "18446744073709551615", 1.0), "n/a")
  assert_eq(throughput("hash", "0", 1.0), "n/a")
  assert_eq(cell("a|b\nc"), "a\\|b c")
  assert_eq(cell("a|b|c\nd\ne"), "a\\|b\\|c d e")
  assert_eq(expected_url_keys().length(), 144)
  let url_cases : Array[Json] = []
  for (key, _) in expected_url_keys() {
    let parts = key.split(":").map(view => view.to_owned()).to_array()
    url_cases.push({ "name": "\{parts[0]}:\{parts[1]}:1:\{parts[2]}" })
  }
  validate_url_inventory(url_cases)
  let substituted = url_cases.copy()
  substituted[0] = { "name": "parse-short:unrequested-library:1:0" }
  try validate_url_inventory(substituted) catch {
    _ => ()
  } noraise {
    _ => fail("A substituted URL case must fail even with 144 entries")
  }
  try validate_url_inventory([]) catch {
    _ => ()
  } noraise {
    _ => fail("Incomplete URL cases must fail")
  }
  assert_eq(metric({ "mean": 1.25, "std_dev_pct": 4.9 }, "ns", 64), "1250")
  assert_eq(metric({ "mean": 1.25, "std_dev_pct": 5 }, "us", 64), "1.25*")
  assert_eq(
    metric({ "mean": 976.5625, "std_dev_pct": 0 }, "GiB/s", 1048576),
    "1",
  )
  try validate_snapshot([], "crc32") catch {
    _ => ()
  } noraise {
    _ => fail("An incomplete snapshot must fail")
  }
  try number({ "mean": "invalid" }, "mean") catch {
    _ => ()
  } noraise {
    _ => fail("A malformed numeric statistic must fail")
  }
}

///|
/// Defines every integer case with its exact byte count, adapter, and view offset.
fn expected_atoi_names() -> Map[String, Unit] {
  let expected : Map[String, Unit] = Map([])
  for
    (label, length, partial, compare_core) in [
      ("parse-u32-short", 1, false, true),
      ("parse-u32-max", 10, false, true),
      ("parse-u64-short", 1, false, true),
      ("parse-u64-eight", 8, false, true),
      ("parse-u64-sixteen", 16, true, true),
      ("parse-u64-max", 20, true, true),
      ("parse-i64-short", 2, false, true),
      ("parse-i64-sixteen", 17, true, true),
      ("parse-i64-max", 19, false, true),
      ("parse-i64-min", 20, true, true),
      ("parse-u128-sixteen", 16, false, true),
      ("parse-u128-thirtytwo", 32, true, true),
      ("parse-u128-max", 39, true, true),
      ("parse-i128-short", 2, false, true),
      ("parse-i128-thirtytwo", 33, true, true),
      ("parse-i128-min", 40, true, true),
      ("parse-u64-plus-zeroes", 83, false, true),
      ("parse-i128-plus-zeroes", 83, false, true),
      ("parse-u64-zeroes-4k", 4096, false, true),
      ("parse-u64-zeroes-1m", 1048576, false, true),
      ("prefix-u64-sixteen", 21, true, true),
      ("prefix-i64-min", 25, false, true),
      ("prefix-u128-max", 44, false, true),
      ("prefix-i128-min", 45, false, true),
      ("invalid-u64-empty", 0, false, true),
      ("invalid-u64-start", 4, false, true),
      ("invalid-u64-end", 17, false, true),
      ("invalid-u64-byte", 17, false, true),
      ("overflow-u64", 20, false, true),
      ("overflow-u32-large", 65536, false, true),
      ("overflow-u128", 39, false, true),
      ("size-u64", 64, false, false),
    ] {
    let offsets = if partial { [0, 1, 3, 15] } else { [0] }
    let implementations = if compare_core {
      ["own-scalar", "own-simd", "core"]
    } else {
      ["own-scalar", "own-simd"]
    }
    for implementation in implementations {
      for offset in offsets {
        expected["\{label}:\{implementation}:\{length}:\{offset}"] = ()
      }
    }
  }
  expected
}

///|
/// Rejects incomplete, duplicated, or substituted integer benchmark contracts.
fn validate_atoi_inventory(summaries : Array[Json]) -> Unit raise {
  let expected = expected_atoi_names()
  guard summaries.length() == expected.length() else {
    fail("Expected 176 integer cases")
  }
  for summary in summaries {
    let name = text(summary, "name")
    guard expected.contains(name) else {
      fail("Unexpected integer benchmark: " + name)
    }
    let _ = expected.remove(name)
  }
  guard expected.is_empty() else { fail("Incomplete integer case inventory") }
}

///|
/// Checks all integer distribution statistics and integral sampling metadata.
fn validate_atoi_statistics(summary : Json) -> Unit raise {
  guard array(summary, "quartiles")
    is [Number(low, ..), Number(middle, ..), Number(high, ..)] else {
    fail("Integer quartiles require three numeric values")
  }
  let minimum = number(summary, "min")
  let maximum = number(summary, "max")
  let tolerance = maximum.abs() * 0.000000000001 + 0.000000000001
  guard low.is_finite() &&
    middle.is_finite() &&
    high.is_finite() &&
    minimum <= low + tolerance &&
    low <= middle + tolerance &&
    middle <= high + tolerance &&
    high <= maximum + tolerance &&
    (middle - number(summary, "median")).abs() <= tolerance else {
    fail("Invalid integer quartile range")
  }
  for
    statistic in [
      "sum", "variance", "median_abs_dev", "median_abs_dev_pct", "iqr",
    ] {
    guard number(summary, statistic) >= 0 else {
      fail("Invalid integer statistic: " + statistic)
    }
  }
  let batch = number(summary, "batch_size")
  guard batch >= 1 &&
    batch.floor() == batch &&
    (number(summary, "iqr") - (high - low)).abs() <= tolerance &&
    (number(summary, "sum") - number(summary, "mean") * number(summary, "runs")).abs() <=
    tolerance * 10 else {
    fail("Inconsistent integer distribution or batch metadata")
  }
}

///|
/// Verifies the pinned port and the three bundled core comparison packages.
fn validate_atoi_metadata(record : Json) -> Unit raise {
  let upstream = field(record, "ported_upstream")
  guard number(record, "schema_version") == 1 &&
    text(upstream, "package") == "atoi_simd" &&
    text(upstream, "version") == "0.18.1" &&
    text(upstream, "revision") == "f0952f7bb71ee581dcc2871841f9b2dbd241bd7e" &&
    text(upstream, "crate_sha256") ==
    "f3cdb3708a128e559a30fb830e8a77a5022ee6902806925c216658652b452a44" &&
    text(upstream, "license") == "MIT" &&
    field(upstream, "timed") == Json::boolean(false) else {
    fail("Missing or changed pinned atoi_simd provenance")
  }
  let expected : Map[String, Unit] = {
    "moonbitlang/core/string": (),
    "moonbitlang/core/encoding/utf8": (),
    "moonbitlang/core/bigint": (),
  }
  let dependencies = array(record, "comparison_dependencies")
  guard dependencies.length() == 3 else {
    fail("Expected the three core integer adapter dependencies")
  }
  let version = text(dependencies[0], "version")
  guard version != "" else { fail("Missing bundled core version") }
  for dependency in dependencies {
    let path = text(dependency, "package")
    guard expected.contains(path) &&
      text(dependency, "version") == version &&
      text(dependency, "license") == "Apache-2.0" &&
      text(dependency, "api") != "" else {
      fail("Invalid integer comparison dependency: " + path)
    }
    let _ = expected.remove(path)
  }
}

///|
/// Validates a complete local integer record without accepting it as CI data.
fn validate_local_atoi(record : Json) -> Unit raise {
  guard text(record, "module") == "justjavac/atoi" &&
    text(record, "source") == "local" &&
    text(record, "run_id") == "" &&
    text(record, "run_url") == "" &&
    text(record, "run_attempt") == "" &&
    ["linux", "macos", "windows"].contains(text(record, "os")) &&
    text(field(record, "cpu"), "model") != "" else {
    fail("The local renderer requires a local integer collector artifact")
  }
  validate_atoi_metadata(record)
  let backends = array(record, "backends")
  guard backends.length() == 4 else {
    fail("Local integer reports require all four backends")
  }
  let names : Map[String, Unit] = Map([])
  for backend in backends {
    let name = text(backend, "backend")
    guard !names.contains(name) else { fail("Duplicate local integer backend") }
    names[name] = ()
    validate_backend(backend, "atoi")
  }
}

///|
/// Renders an integer-specific comparison using its equivalent public adapters.
fn atoi_table(
  builder : StringBuilder,
  records : Array[Json],
  title : String,
  workload : String,
  bytes : String,
  units : String,
) -> Unit raise {
  results_table(
    builder,
    records,
    title,
    workload,
    bytes,
    "0",
    units,
    @string.parse_int(bytes).to_double(),
    implementations=["own-scalar", "own-simd", "core"],
    labels=[
      "ours scalar",
      "ours SIMD request",
      if workload.find("128") is Some(_) {
        "core bounded BigInt + UTF-8"
      } else {
        "core integer + UTF-8"
      },
    ],
  )
}

///|
/// Builds a decimal report with explicit local provenance and required adaptation costs.
fn atoi_report(records : Array[Json], is_local~ : Bool = false) -> String raise {
  let first = records[0]
  let builder = StringBuilder()
  builder.write_string("# Decimal integer performance comparison\n\n")
  if is_local {
    builder.write_string(
      "**Local " +
      text(first, "os") +
      " measurement; not a published CI snapshot.** Source HEAD `" +
      text(first, "source_commit") +
      "`; working tree dirty: " +
      display(field(first, "working_tree_dirty")) +
      ".\n\n",
    )
  } else {
    let revision = text(first, "source_commit")
    builder.write_string(
      "[CI run " +
      text(first, "run_id") +
      "](" +
      text(first, "run_url") +
      ") | [source " +
      revision[:7].to_owned() +
      "](https://github.com/" +
      text(first, "repository") +
      "/commit/" +
      revision +
      ") | attempt " +
      text(first, "run_attempt") +
      "\n\n",
    )
  }
  let data_file = if is_local {
    "LOCAL-BENCHMARK-DATA.json"
  } else {
    "BENCHMARK-DATA.json"
  }
  builder.write_string(
    "**Scope:** " +
    records.length().to_string() +
    " OS x 4 backends x 176 cases = **" +
    (records.length() * 704).to_string() +
    " measurements**. [" +
    data_file +
    "](" +
    data_file +
    ") preserves every unrounded statistic, case, offset, command, timestamp, source/run/attempt, dependency version, CPU, runner image, and toolchain.\n\n",
  )
  builder.write_string(
    "## Vector gains within this library\n\nRatios divide scalar latency by SIMD-request latency for the same public operation. Ratios above one favor the SIMD request.\n\n| OS / backend | UInt64, 16 digits | UInt128, maximum |\n| --- | --- | --- |\n",
  )
  for record in records {
    for backend in array(record, "backends") {
      let name = text(backend, "backend")
      if name == "native" || name == "wasm" {
        let values = index(backend)
        let word = number(values["parse-u64-sixteen:own-scalar:16:0"], "mean") /
          number(values["parse-u64-sixteen:own-simd:16:0"], "mean")
        let wide = number(values["parse-u128-max:own-scalar:39:0"], "mean") /
          number(values["parse-u128-max:own-simd:39:0"], "mean")
        builder.write_string(
          "| " +
          text(record, "os") +
          " / " +
          name +
          " | " +
          decimal(word) +
          "x | " +
          decimal(wide) +
          "x |\n",
        )
      }
    }
  }
  builder.write_string(
    "\nCore comparisons also include required UTF-8 conversion, different integer representation, prefix adaptation, and range checks. They do not isolate vector gains. **Bold** marks the best mean; `*` marks CV >= 5% and possible noise. A best mean does not establish statistical significance.\n\n",
  )
  atoi_table(
    builder, records, "One digit UInt64 (ns)", "parse-u64-short", "1", "ns",
  )
  atoi_table(
    builder, records, "Sixteen digit UInt64 (ns)", "parse-u64-sixteen", "16", "ns",
  )
  atoi_table(
    builder, records, "Minimum Int64 (ns)", "parse-i64-min", "20", "ns",
  )
  atoi_table(
    builder, records, "Maximum UInt128 (ns)", "parse-u128-max", "39", "ns",
  )
  atoi_table(
    builder, records, "UInt64 prefix with suffix (ns)", "prefix-u64-sixteen", "21",
    "ns",
  )
  atoi_table(
    builder, records, "Early rejection of 64 KiB nonzero UInt32 input (us)", "overflow-u32-large",
    "65536", "us",
  )
  atoi_table(
    builder, records, "One MiB leading zeroes, complete parse (GiB/s)", "parse-u64-zeroes-1m",
    "1048576", "GiB/s",
  )
  builder.write_string(
    "## APIs and method\n\n- Decimal base ten. Tests check identical returned values, consumed prefix sizes, and accepted/rejected corpus cases before timing. Full and prefix parsing are separate workloads. An excessive-size workload measures only this library because core has no matching digit budget.\n- Owned byte inputs, partial-view buffers, and rejected sentinels are prepared outside timing. Offsets 1, 3, and 15 exercise selected boundaries. Public calls, optional-result adaptation, generic callback dispatch, and bench.keep barriers are timed; decimal result formatting is confined to equivalence tests.\n- Core string parsers require strict UTF-8-to-UTF-16 conversion. Its missing prefix API uses a per-byte ASCII scan; an enabled leading plus is removed for the BigInt parser while preserving consumption. Core BigInt is explicitly range-checked for signed/unsigned 128-bit results. These required costs remain in the timer.\n- Scalar requests use upstream-derived eight-byte SWAR masks and decimal reduction, with byte-wise tails. SIMD requests use bounded V128 range masks and a 16-to-8-to-4-to-2-to-1 decimal reduction tree on native and linear-memory Wasm. Inputs below sixteen bytes and Wasm GC/JavaScript use scalar/SWAR fallback. Vector loads stay inside the input view.\n- Prefix, invalid-input, overflow, and size workloads report latency rather than whole-buffer throughput. The one MiB zero case reads the whole input before returning zero with skip_zeroes=true. UInt128/Int128 use exact private UInt64 word pairs and checked base-2^32 carries.\n- Release mode and --no-parallelize, with backends measured sequentially on each OS. The core runner calibrates around 100 ms, records 10 batch samples, and applies 5% winsorization; fast cases use 100000 iterations per batch. Every case retains runs and batch_size.\n\n",
  )
  builder.write_string(
    "Leading-zero removal uses the measured SWAR path for both requests; an all-zero input can remain entirely scalar/SWAR with simd=true. The earlier local vector zero scan was slower on native and Wasm. Wide core range bounds are initialized outside timed callbacks, while their comparisons remain timed.\n\n",
  )
  builder.write_string(
    "Port: [atoi_simd 0.18.1](https://crates.io/crates/atoi_simd/0.18.1), revision `f0952f7bb71ee581dcc2871841f9b2dbd241bd7e`, under its MIT option. Rust is an external correctness oracle and is not linked into or timed with the MoonBit library.\n\n<details>\n<summary>Dependencies, runners, commands, and reproduction</summary>\n\n| Package | Version | License |\n| --- | --- | --- |\n",
  )
  for dependency in array(first, "comparison_dependencies") {
    builder.write_string(
      "| " +
      cell(text(dependency, "package")) +
      " | " +
      cell(text(dependency, "version")) +
      " | " +
      cell(text(dependency, "license")) +
      " |\n",
    )
  }
  builder.write_string(
    "\n| OS | CPU | Architecture | Runner image |\n| --- | --- | --- | --- |\n",
  )
  for record in records {
    let cpu = field(record, "cpu")
    builder.write_string(
      "| " +
      text(record, "os") +
      " | " +
      cell(text(cpu, "model")) +
      " | " +
      display(field(cpu, "architecture")) +
      " | " +
      cell(text(record, "image_os") + " " + text(record, "image_version")) +
      " |\n",
    )
  }
  for record in records {
    builder.write_string(
      "\n**" +
      text(record, "os") +
      ":**\n\n~~~text\n" +
      text(record, "toolchain") +
      "\n~~~\n\n",
    )
    for backend in array(record, "backends") {
      builder.write_string(
        text(backend, "backend") +
        ": " +
        text(backend, "started_at_utc") +
        " to " +
        text(backend, "finished_at_utc") +
        " (UTC).\n\n~~~text\n" +
        text(backend, "command") +
        "\n~~~\n\n",
      )
    }
  }
  builder.write_string(
    "Run `moon -C benchmarks test atoi --target all`, then `moon run scripts/benchmark.mbtx atoi`. Local rendering uses `moon run scripts/benchmark_report.mbtx --local atoi _build/benchmarks/atoi/windows.json _build/atoi-report`. Publish only a complete three-OS/four-backend CI snapshot with identical source, run, attempt, manifests, and dependencies; the validator rejects mixed or partial data. Raw CI logs are retained for 90 days.\n\n</details>\n",
  )
  builder.to_string()
}

///|
/// Replaces one field in a schema-test object without mutating shared fixtures.
fn test_field(value : Json, key : String, replacement : Json) -> Json raise {
  match value {
    Object(fields) => {
      let copy = fields.copy()
      copy[key] = replacement
      Json(copy)
    }
    _ => fail("Expected a schema-test object")
  }
}

///|
/// Builds explicitly fabricated complete integer data to exercise publication guards.
fn atoi_snapshot_fixture(statistics : Json) -> Array[Json] raise {
  let summaries : Array[Json] = []
  let distribution = test_field(
    test_field(statistics, "std_dev", 0.1),
    "std_dev_pct",
    10,
  )
  for (name, _) in expected_atoi_names() {
    summaries.push(test_field(distribution, "name", Json(name)))
  }
  let backends : Array[Json] = []
  for name in ["native", "wasm", "wasm-gc", "js"] {
    backends.push({
      "backend": name,
      "time_unit": "microseconds",
      "command": "moon -C benchmarks bench --target " +
      name +
      " --release --no-parallelize -p justjavac/benchmarks/atoi",
      "started_at_utc": "2026-11-25T00:00:00Z",
      "finished_at_utc": "2026-11-25T00:01:00Z",
      "summaries": Json(summaries),
    })
  }
  let records : Array[Json] = []
  for os in ["linux", "macos", "windows"] {
    records.push({
      "schema_version": 1,
      "module": "justjavac/atoi",
      "source": "github-actions",
      "source_commit": "0123456789012345678901234567890123456789",
      "repository": "example/fixture",
      "run_id": "123",
      "run_attempt": "1",
      "run_url": "https://github.com/example/fixture/actions/runs/123",
      "os": os,
      "cpu": { "model": "schema fixture" },
      "module_manifest": "name = \"justjavac/atoi\"\nversion = \"0.1.0\"\n",
      "comparison_manifest": "justjavac/atoi@0.1.0\n",
      "comparison_dependencies": [
        {
          "package": "moonbitlang/core/string",
          "version": "fixture",
          "license": "Apache-2.0",
          "api": "fixture",
        },
        {
          "package": "moonbitlang/core/encoding/utf8",
          "version": "fixture",
          "license": "Apache-2.0",
          "api": "fixture",
        },
        {
          "package": "moonbitlang/core/bigint",
          "version": "fixture",
          "license": "Apache-2.0",
          "api": "fixture",
        },
      ],
      "ported_upstream": {
        "package": "atoi_simd",
        "version": "0.18.1",
        "revision": "f0952f7bb71ee581dcc2871841f9b2dbd241bd7e",
        "crate_sha256": "f3cdb3708a128e559a30fb830e8a77a5022ee6902806925c216658652b452a44",
        "license": "MIT",
        "timed": false,
      },
      "backends": Json(backends),
    })
  }
  records
}

///|
/// Writes one uppercase BENCHMARK.md and its complete JSON snapshot per module.
async fn main {
  let arguments = @env.args()
  if arguments.length() == 2 && arguments[1] == "--self-test" {
    self_test()
    println("Benchmark report self-test passed")
    return
  }
  if arguments.length() == 5 && arguments[1] == "--local" {
    guard ["atoi", "utf8", "argminmax"].contains(arguments[2]) else {
      fail("Local rendering supports integer, UTF-8, and extrema artifacts")
    }
    let record = @json.parse(@fs.read_text(arguments[3]))
    let markdown = if arguments[2] == "utf8" {
      validate_local_utf8(record)
      utf8_report([record], is_local=true)
    } else if arguments[2] == "argminmax" {
      validate_local_argminmax(record)
      argminmax_report([record], is_local=true)
    } else {
      validate_local_atoi(record)
      atoi_report([record], is_local=true)
    }
    let directory = arguments[4]
    @fs.mkdir(directory, recursive=true, allow_existing=true)
    @fs.write_text(directory + "/LOCAL-BENCHMARK.md", markdown)
    @fs.write_text(
      directory + "/LOCAL-BENCHMARK-DATA.json",
      Json([record]).stringify(indent=2),
    )
    println(
      "Generated explicitly local " + arguments[2] + " report in " + directory,
    )
    return
  }
  guard arguments.length() == 3 else {
    fail(
      "Usage: moon run scripts/benchmark_report.mbtx <input-directory> <output-directory>",
    )
  }
  let input = arguments[1]
  let output = arguments[2]
  let members = @fs.readdir(input, sort=true)
  guard !members.is_empty() else { fail("No module artifacts were found") }
  for package_dir in members {
    guard package_dir != "." &&
      package_dir != ".." &&
      package_dir.find("/") is None &&
      package_dir.find("\\") is None else {
      fail("Invalid module directory")
    }
    let records : Array[Json] = []
    for os in ["linux", "macos", "windows"] {
      records.push(
        @json.parse(@fs.read_text("\{input}/\{package_dir}/\{os}.json")),
      )
    }
    let markdown = report(package_dir, records)
    let directory = "\{output}/\{package_dir}"
    @fs.mkdir(directory, recursive=true, allow_existing=true)
    @fs.write_text("\{directory}/BENCHMARK.md", markdown)
    @fs.write_text(
      "\{directory}/BENCHMARK-DATA.json",
      Json(records).stringify(indent=2),
    )
    println("Generated \{directory}/BENCHMARK.md")
  }
}

///|
/// Defines the extrema inventory independently of the benchmark collector.
fn expected_argminmax_names() -> Map[String, Unit] {
  let workloads : Array[(String, Int32, Int32)] = []
  for
    (kind, width) in [
      ("u8", 1),
      ("i8", 1),
      ("u16", 2),
      ("i16", 2),
      ("u32", 4),
      ("i32", 4),
      ("u64", 8),
      ("i64", 8),
      ("f32", 4),
      ("f64", 8),
      ("f16", 2),
      ("bf16", 2),
      ("u128", 16),
      ("i128", 16),
    ] {
    for length in [33, 4096] {
      workloads.push(("argminmax-" + kind, length * width, 0))
    }
  }
  for (kind, width) in [("i32", 4), ("f64", 8)] {
    workloads.push(("argminmax-" + kind, 0, 0))
    for (length, offset) in [(4096, 1), (1048576, 0), (1048576, 1)] {
      workloads.push(("argminmax-" + kind, length * width, offset))
    }
    for operation in ["min", "max"] {
      workloads.push(("arg" + operation + "-" + kind, 4096 * width, 0))
    }
  }
  for (kind, width) in [("f32", 4), ("f64", 8)] {
    for position in ["first", "last"] {
      for policy in ["ignore", "propagate"] {
        workloads.push(
          (policy + "-nan-" + position + "-" + kind, 4096 * width, 0),
        )
      }
    }
  }
  for pattern in ["dense", "sparse", "all-null", "nan-null"] {
    workloads.push(("masked-" + pattern + "-f64", 32768, 0))
  }
  for (kind, width) in [("u8", 1), ("u16", 2)] {
    workloads.push(("index-boundary-" + kind, 131105 * width, 0))
  }
  let expected : Map[String, Unit] = Map([])
  for (label, bytes, offset) in workloads {
    for implementation in ["own-scalar", "own-simd", "baseline"] {
      expected[label +
      ":" +
      implementation +
      ":" +
      bytes.to_string() +
      ":" +
      offset.to_string()] = ()
    }
  }
  expected
}

///|
/// Rejects substituted lengths, kinds, operations, offsets, and duplicate extrema cases.
fn validate_argminmax_inventory(summaries : Array[Json]) -> Unit raise {
  let expected = expected_argminmax_names()
  guard summaries.length() == expected.length() else {
    fail("Expected 162 extrema cases")
  }
  for summary in summaries {
    let name = text(summary, "name")
    guard expected.contains(name) else {
      fail("Unexpected or duplicate extrema case: " + name)
    }
    let _ = expected.remove(name)
  }
  guard expected.is_empty() else { fail("Missing extrema cases") }
}

///|
/// Checks finite quartiles and integral batch sizes against the recorded distributions.
fn validate_argminmax_statistics(summary : Json) -> Unit raise {
  guard array(summary, "quartiles")
    is [Number(low, ..), Number(middle, ..), Number(high, ..)] else {
    fail("Extrema quartiles require three numeric values")
  }
  let minimum = number(summary, "min")
  let maximum = number(summary, "max")
  let tolerance = maximum.abs() * 0.000000000001 + 0.000000000001
  guard low.is_finite() &&
    middle.is_finite() &&
    high.is_finite() &&
    minimum <= low + tolerance &&
    low <= middle + tolerance &&
    middle <= high + tolerance &&
    high <= maximum + tolerance &&
    (middle - number(summary, "median")).abs() <= tolerance else {
    fail("Invalid extrema quartile range")
  }
  for
    statistic in [
      "sum", "variance", "median_abs_dev", "median_abs_dev_pct", "iqr",
    ] {
    guard number(summary, statistic) >= 0 else {
      fail("Invalid extrema statistic: " + statistic)
    }
  }
  let batch = number(summary, "batch_size")
  guard batch >= 1 &&
    batch.floor() == batch &&
    (number(summary, "iqr") - (high - low)).abs() <= tolerance &&
    (number(summary, "sum") - number(summary, "mean") * number(summary, "runs")).abs() <=
    tolerance * 10 else {
    fail("Inconsistent extrema distribution or batch metadata")
  }
}

///|
/// Specifies numeric widths and exact timer boundaries for the extrema port.
fn argminmax_workload_metadata() -> Json {
  {
    "cases_per_backend": 162,
    "elements": [0, 33, 4096, 131105, 1048576],
    "name_fields": [
      "operation-and-kind", "implementation", "numeric-bytes", "element-offset",
    ],
    "validity_bit_offset": 3,
    "widths": {
      "u8": 1,
      "i8": 1,
      "u16": 2,
      "i16": 2,
      "u32": 4,
      "i32": 4,
      "u64": 8,
      "i64": 8,
      "f32": 4,
      "f64": 8,
      "f16": 2,
      "bf16": 2,
      "u128": 16,
      "i128": 16,
    },
    "input_storage": "Prepared typed arrays and offset-one views; wrapper construction and bitmap generation are outside timing",
    "timed": "Public calls or the independent reference, callback dispatch, optional-result adapters, bitmap validation, and bench.keep",
  }
}

///|
/// Verifies pinned source provenance and the development-only linear baseline.
fn validate_argminmax_metadata(record : Json) -> Unit raise {
  if text(record, "source") == "github-actions" {
    let repository = text(record, "repository").split("/").to_array()
    guard repository is [owner, project] &&
      !owner.is_empty() &&
      !project.is_empty() else {
      fail("Missing extrema CI repository identity")
    }
  }
  let upstream = field(record, "ported_upstream")
  guard number(record, "schema_version") == 1 &&
    text(upstream, "package") == "argminmax" &&
    text(upstream, "version") == "0.7.1" &&
    text(upstream, "revision") == "f68aba5c251e9dc093f3939c0f9607c942228311" &&
    text(upstream, "crate_sha256") ==
    "088a9c28ca36500c581f9f54b63460492d2b4f71e1e61d176e8fb79565109b01" &&
    text(upstream, "license") == "MIT" &&
    field(upstream, "timed") == Json::boolean(false) &&
    field(record, "workload_metadata") == argminmax_workload_metadata() &&
    text(record, "module_manifest").has_prefix("name = \"justjavac/argminmax\"") &&
    text(record, "comparison_manifest").find("justjavac/argminmax@0.1.0")
    is Some(_) else {
    fail("Missing or changed argminmax source or workload provenance")
  }
  let dependencies = array(record, "comparison_dependencies")
  guard dependencies.length() == 1 else {
    fail("Expected one independent extrema baseline")
  }
  let baseline = dependencies[0]
  guard text(baseline, "label") == "baseline" &&
    text(baseline, "package") == "justjavac/benchmarks/argminmax" &&
    text(baseline, "version") == "0.1.0" &&
    text(baseline, "core_version") != "" &&
    text(baseline, "license") == "MIT" &&
    text(baseline, "api") != "" else {
    fail("Invalid extrema baseline metadata")
  }
}

///|
/// Validates four local backends without admitting their results as a CI snapshot.
fn validate_local_argminmax(record : Json) -> Unit raise {
  guard text(record, "module") == "justjavac/argminmax" &&
    text(record, "source") == "local" &&
    text(record, "run_id") == "" &&
    text(record, "run_url") == "" &&
    text(record, "run_attempt") == "" &&
    ["linux", "macos", "windows"].contains(text(record, "os")) &&
    text(field(record, "cpu"), "model") != "" else {
    fail("The local renderer requires a local extrema collector artifact")
  }
  validate_argminmax_metadata(record)
  let backends = array(record, "backends")
  guard backends.length() == 4 else {
    fail("Local extrema reports require all four backends")
  }
  let names : Map[String, Unit] = Map([])
  for backend in backends {
    let name = text(backend, "backend")
    guard !names.contains(name) else { fail("Duplicate local extrema backend") }
    names[name] = ()
    validate_backend(backend, "argminmax")
  }
}

///|
/// Renders three comparable extrema adapters using numeric bytes and element offsets.
fn argminmax_table(
  builder : StringBuilder,
  records : Array[Json],
  title : String,
  workload : String,
  bytes : String,
  offset : String,
  units : String,
) -> Unit raise {
  results_table(
    builder,
    records,
    title,
    workload,
    bytes,
    offset,
    units,
    @string.parse_int(bytes).to_double(),
    implementations=["own-scalar", "own-simd", "baseline"],
    labels=["ours scalar", "ours SIMD request", "linear reference"],
  )
}

///|
/// Builds focused extrema tables while retaining all 162 cases in the companion JSON.
fn argminmax_report(
  records : Array[Json],
  is_local~ : Bool = false,
) -> String raise {
  let first = records[0]
  let builder = StringBuilder()
  builder.write_string("# ArgMinMax performance comparison\n\n")
  if is_local {
    builder.write_string(
      "**Local measurements.** CPU: " +
      cell(text(field(first, "cpu"), "model")) +
      ". Recorded checkout: `" +
      text(first, "source_commit") +
      "`; working tree dirty: " +
      field(first, "working_tree_dirty").stringify() +
      ".\n\n",
    )
  } else {
    let revision = text(first, "source_commit")
    builder.write_string(
      "[CI run " +
      text(first, "run_id") +
      "](" +
      text(first, "run_url") +
      ") | [source " +
      revision[:7].to_owned() +
      "](https://github.com/" +
      text(first, "repository") +
      "/commit/" +
      revision +
      ") | attempt " +
      text(first, "run_attempt") +
      "\n\n",
    )
  }
  let count = records.length() * 4 * 162
  builder.write_string(
    "**Scope:** " +
    records.length().to_string() +
    " operating system(s) × 4 backends × 162 cases = **" +
    count.to_string() +
    " measurements**. Every unrounded distribution and its provenance is preserved in the companion " +
    (if is_local {
      "`LOCAL-BENCHMARK-DATA.json`"
    } else {
      "[BENCHMARK-DATA.json](BENCHMARK-DATA.json)"
    }) +
    ".\n\n",
  )
  builder.write_string(
    "The port follows `argminmax@0.7.1`, revision `f68aba5c251e9dc093f3939c0f9607c942228311`. The Rust crate is source provenance and is not timed here. The independent MoonBit linear reference and this library consume the same prepared values and return identical indices before timing. Correctness tests additionally use a sort-based oracle and exhaustive IEEE half-float formulas.\n\n" +
    "## Timer and dispatch\n\n" +
    "Typed arrays, half/wide wrappers, and offset-three validity bitmaps are prepared outside the timer. Public calls, bitmap validation, callback dispatch, single-index result adapters, and `bench.keep` are timed. Offset-one cases reuse a partial typed view without materialization. Numeric bytes describe element width; wrapper objects and bitmap storage are additional memory.\n\n" +
    "Automatic searches use scalar code, with unmasked NaN-ignoring `argminmax` calls for `Float` and `Double` (at least 4096 elements) using vectors on linear-memory Wasm. The tables explicitly request scalar or SIMD. SIMD requests use gathered typed lanes on native/Wasm, scalar tails, and overflow-bounded indices; 128-bit elements, Wasm GC, and JavaScript use scalar fallback. Masked defaults and scalar-only backends use a direct scalar scan with overflow-safe byte/bit positioning; explicit native/Wasm vector requests use valid runs. Leading NaNs are skipped scalarly.\n\n" +
    "Times are microseconds per invocation; nanoseconds multiply by 1000. **Bold** marks the smallest measured mean; `*` marks CV >= 5% and possible noise. A smaller mean does not establish statistical significance. Compare implementations within the same OS/backend. NaN propagation and all-null inputs can stop early or read only metadata, so these tables report latency rather than nominal throughput.\n\n" +
    "The core runner calibrates for about 100 ms, records ten batch samples, and applies 5% winsorization. Submicrosecond cases use 100000 iterations per batch. Every record preserves `runs`, `batch_size`, quartiles, variance, mean, median, range, commands, UTC timestamps, CPU, toolchain, and dependencies.\n\n",
  )
  builder.write_string(
    "## Measured tradeoffs\n\nFor 4096 elements, these ratios divide the SIMD request's mean latency by the scalar mean. Values below 1 favor the SIMD request; the detailed tables mark possible noise.\n\n",
  )
  for record in records {
    let backends = array(record, "backends")
    let native_position = backends
      .search_by(backend => text(backend, "backend") == "native")
      .unwrap_or_else(() => fail("Missing native extrema results"))
    let wasm_position = backends
      .search_by(backend => text(backend, "backend") == "wasm")
      .unwrap_or_else(() => fail("Missing Wasm extrema results"))
    let native_values = index(backends[native_position])
    let wasm_values = index(backends[wasm_position])
    let native_double = number(
        native_values["argminmax-f64:own-simd:32768:0"],
        "mean",
      ) /
      number(native_values["argminmax-f64:own-scalar:32768:0"], "mean")
    let wasm_float = number(
        wasm_values["argminmax-f32:own-simd:16384:0"],
        "mean",
      ) /
      number(wasm_values["argminmax-f32:own-scalar:16384:0"], "mean")
    let wasm_double = number(
        wasm_values["argminmax-f64:own-simd:32768:0"],
        "mean",
      ) /
      number(wasm_values["argminmax-f64:own-scalar:32768:0"], "mean")
    builder.write_string(
      "- **\{text(record, "os")}:** native Double \{decimal(native_double)}x; Wasm Float \{decimal(wasm_float)}x; Wasm Double \{decimal(wasm_double)}x.\n",
    )
  }
  builder.write_string(
    "\n## Runner context\n\n| OS | CPU | Architecture / logical CPUs | Runner / image | Node.js |\n| --- | --- | --- | --- | --- |\n",
  )
  for record in records {
    let cpu = field(record, "cpu")
    builder.write_string(
      "| \{text(record, "os")} | \{cell(text(cpu, "model"))} | \{cell(text(cpu, "architecture"))} / \{display(field(cpu, "logical_cpus"))} | \{cell(text(record, "runner_label"))} / \{cell(text(record, "image_os"))} / \{cell(text(record, "image_version"))} | \{cell(text(record, "node"))} |\n",
    )
  }
  builder.write_string("\n")
  for
    (title, workload, bytes, offset, units) in [
      ("4096 Int32 elements: latency (us)", "argminmax-i32", "16384", "0", "us"),
      ("4096 Float elements: latency (us)", "argminmax-f32", "16384", "0", "us"),
      (
        "4096 Double elements: latency (us)", "argminmax-f64", "32768", "0", "us",
      ),
      ("33 Byte elements: latency (ns)", "argminmax-u8", "33", "0", "ns"),
      (
        "1,048,576 Int32 elements at offset one: latency (us)", "argminmax-i32",
        "4194304", "1", "us",
      ),
      (
        "Dense validity bitmap, 4096 Double elements: latency (us)", "masked-dense-f64",
        "32768", "0", "us",
      ),
      (
        "Last NaN propagation, 4096 Double elements: latency (us)", "propagate-nan-last-f64",
        "32768", "0", "us",
      ),
    ] {
    argminmax_table(builder, records, title, workload, bytes, offset, units)
  }
  builder.write_string(
    "## Reproduction and toolchain\n\n```text\nmoon -C benchmarks test argminmax --target all\nmoon run scripts/benchmark.mbtx argminmax\nmoon run scripts/benchmark_report.mbtx --self-test\n```\n\n",
  )
  for record in records {
    builder.write_string(
      "**" +
      text(record, "os") +
      ":**\n\n~~~text\n" +
      text(record, "toolchain") +
      "\n~~~\n\n",
    )
  }
  builder.write_string(
    "Publish a snapshot from one complete CI run and attempt covering three systems and four backends. Raw artifacts remain available for 90 days. Local outputs retain their local label and dirty-checkout state.\n",
  )
  builder.to_string()
}

///|
/// Builds complete, isolated extrema artifacts for report validation regressions.
fn argminmax_snapshot_fixture(statistics : Json) -> Array[Json] raise {
  let distribution = test_field(
    test_field(statistics, "std_dev", 0.1),
    "std_dev_pct",
    10,
  )
  let summaries : Array[Json] = []
  for (name, _) in expected_argminmax_names() {
    summaries.push(test_field(distribution, "name", Json(name)))
  }
  let backends : Array[Json] = []
  for name in ["native", "wasm", "wasm-gc", "js"] {
    backends.push({
      "backend": name,
      "time_unit": "microseconds",
      "command": "moon -C benchmarks bench --target " +
      name +
      " --release --no-parallelize -p justjavac/benchmarks/argminmax",
      "started_at_utc": "2026-11-25T00:00:00Z",
      "finished_at_utc": "2026-11-25T00:01:00Z",
      "summaries": Json(summaries),
    })
  }
  let output : Array[Json] = []
  for os in ["linux", "macos", "windows"] {
    output.push({
      "schema_version": 1,
      "module": "justjavac/argminmax",
      "source": "github-actions",
      "source_commit": "0123456789012345678901234567890123456789",
      "repository": "example/fixture",
      "run_id": "123",
      "run_attempt": "1",
      "run_url": "https://github.com/example/fixture/actions/runs/123",
      "os": os,
      "cpu": {
        "model": "schema fixture",
        "architecture": "fixture",
        "logical_cpus": 1,
      },
      "runner_label": "fixture",
      "image_os": "fixture",
      "image_version": "fixture",
      "node": "fixture",
      "toolchain": "moonc fixture",
      "working_tree_dirty": false,
      "module_manifest": "name = \"justjavac/argminmax\"\nversion = \"0.1.0\"\n",
      "comparison_manifest": "justjavac/argminmax@0.1.0\n",
      "comparison_dependencies": [
        {
          "label": "baseline",
          "package": "justjavac/benchmarks/argminmax",
          "version": "0.1.0",
          "core_version": "fixture",
          "license": "MIT",
          "api": "independent linear reference",
        },
      ],
      "ported_upstream": {
        "package": "argminmax",
        "version": "0.7.1",
        "revision": "f68aba5c251e9dc093f3939c0f9607c942228311",
        "crate_sha256": "088a9c28ca36500c581f9f54b63460492d2b4f71e1e61d176e8fb79565109b01",
        "license": "MIT",
        "timed": false,
      },
      "workload_metadata": argminmax_workload_metadata(),
      "backends": Json(backends),
    })
  }
  output
}

///|
/// Protects extrema inventories, distribution metadata, provenance, and local/CI separation.
fn argminmax_self_test(statistics : Json) -> Unit raise {
  assert_eq(expected_argminmax_names().length(), 162)
  validate_argminmax_statistics(statistics)
  let snapshots = argminmax_snapshot_fixture(statistics)
  validate_snapshot(snapshots, "argminmax")
  let rendered = argminmax_report(snapshots)
  assert_true(rendered.find("1944 measurements") is Some(_))
  assert_true(rendered.find("4096 Float elements") is Some(_))
  assert_true(
    rendered.find("native Double 1x; Wasm Float 1x; Wasm Double 1x") is Some(_),
  )
  assert_true(rendered.find("Runner context") is Some(_))
  let crlf = snapshots.copy()
  crlf[1] = test_field(
    crlf[1],
    "module_manifest",
    Json(text(crlf[1], "module_manifest").replace_all(old="\n", new="\r\n")),
  )
  validate_snapshot(crlf, "argminmax")
  for
    (key, replacement) in [
      ("source_commit", Json("1123456789012345678901234567890123456789")),
      ("run_attempt", Json("2")),
      ("run_attempt", Json("")),
      ("source", Json("local")),
      ("repository", Json("")),
      ("working_tree_dirty", Json::boolean(true)),
      ("module_manifest", Json("name = \"justjavac/argminmax\"\nchanged\n")),
      ("comparison_manifest", Json("changed")),
      (
        "ported_upstream",
        test_field(
          field(snapshots[0], "ported_upstream"),
          "revision",
          "changed",
        ),
      ),
      (
        "workload_metadata",
        test_field(
          field(snapshots[0], "workload_metadata"),
          "cases_per_backend",
          161,
        ),
      ),
      ("comparison_dependencies", Json(([] : Array[Json]))),
      ("backends", Json(array(snapshots[0], "backends")[:3].to_owned())),
    ] {
    let changed = snapshots.copy()
    changed[1] = test_field(changed[1], key, replacement)
    try validate_snapshot(changed, "argminmax") catch {
      _ => ()
    } noraise {
      _ => fail("Malformed extrema snapshot accepted: " + key)
    }
  }
  try validate_snapshot(snapshots[:2].to_owned(), "argminmax") catch {
    _ => ()
  } noraise {
    _ => fail("Partial extrema OS matrix accepted")
  }
  let original = array(array(snapshots[0], "backends")[0], "summaries")
  for
    replacement in [
      test_field(original[0], "name", "argminmax-i32:own-scalar:16383:0"),
      original[1],
    ] {
    let changed = original.copy()
    changed[0] = replacement
    try validate_argminmax_inventory(changed) catch {
      _ => ()
    } noraise {
      _ => fail("Substituted extrema inventory accepted")
    }
  }
  for
    replacement in [
      test_field(original[0], "batch_size", 1.5),
      test_field(original[0], "quartiles", Json([2, 1, 0])),
    ] {
    try validate_argminmax_statistics(replacement) catch {
      _ => ()
    } noraise {
      _ => fail("Malformed extrema distribution accepted")
    }
  }
  let local_record = test_field(
    test_field(
      test_field(test_field(snapshots[0], "source", "local"), "run_id", ""),
      "run_attempt",
      "",
    ),
    "run_url",
    "",
  )
  validate_local_argminmax(local_record)
  assert_true(
    argminmax_report([local_record], is_local=true).find("Local measurements")
    is Some(_),
  )
  try
    validate_snapshot([local_record, snapshots[1], snapshots[2]], "argminmax")
  catch {
    _ => ()
  } noraise {
    _ => fail("Local extrema measurements accepted as CI")
  }
}
