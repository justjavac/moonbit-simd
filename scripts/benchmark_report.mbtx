----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}
----

///|
/// Retrieves a required JSON field with a useful schema error.
fn field(value : Json, key : String) -> Json raise {
  match value {
    Object(fields) =>
      fields.get(key).unwrap_or_else(() => fail("Missing field: \{key}"))
    _ => fail("Expected an object for field \{key}")
  }
}

///|
/// Retrieves a required JSON string without silently coercing its type.
fn text(value : Json, key : String) -> String raise {
  match field(value, key) {
    String(contents) => contents
    _ => fail("Expected a string: \{key}")
  }
}

///|
/// Retrieves a finite numeric statistic from a benchmark summary.
fn number(value : Json, key : String) -> Double raise {
  match field(value, key) {
    Number(contents, ..) => {
      guard contents.is_finite() else { fail("Non-finite statistic: \{key}") }
      contents
    }
    _ => fail("Expected a number: \{key}")
  }
}

///|
/// Retrieves a required JSON array from the input schema.
fn array(value : Json, key : String) -> Array[Json] raise {
  match field(value, key) {
    Array(contents) => contents
    _ => fail("Expected an array: \{key}")
  }
}

///|
/// Rounds display numbers to three decimal places while preserving original JSON.
fn decimal(value : Double) -> String {
  ((value * 1000).round() / 1000).to_string()
}

///|
/// Quotes untrusted runner metadata safely inside a Markdown table cell.
fn cell(value : String) -> String {
  value
  .replace_all(old="|", new="\\|")
  .replace_all(old="\r", new=" ")
  .replace_all(old="\n", new=" ")
}

///|
/// Parses the benchmark case contract without rounding UInt64 suffix lengths.
fn case_parts(summary : Json) -> Array[String] raise {
  let pieces = text(summary, "name")
    .split(":")
    .map(part => part.to_owned())
    .to_array()
  guard pieces.length() == 4 else { fail("Invalid benchmark case name") }
  pieces
}

///|
/// Computes GiB per second only for workloads that actually read input bytes.
fn throughput(workload : String, bytes : String, mean : Double) -> String raise {
  if workload == "combine" || bytes == "0" {
    "n/a"
  } else {
    let length = @string.parse_int(bytes)
    decimal(length.to_double() * 1000000 / mean / 1073741824)
  }
}

///|
/// Defines every Base64 case and the actual input/output lengths behind its binary-size label.
fn expected_base64_cases() -> Map[String, Json] {
  let cases : Map[String, Json] = Map([])
  fn add(
    workload : String,
    implementation : String,
    variant : String,
    length : Int32,
    padding : Bool,
    offset : Int32,
  ) -> Unit {
    let tail = length % 3
    let encoded = length / 3 * 4 +
      (if tail == 0 { 0 } else if padding { 4 } else { tail + 1 })
    let encoding = workload.has_prefix("encode-")
    let text_input = workload == "decode-" + variant
    cases["\{workload}:\{implementation}:\{length}:\{offset}"] = {
      "binary_bytes": length,
      "input_bytes": if encoding {
        length
      } else {
        encoded
      },
      "input_code_units": if text_input {
        encoded
      } else {
        0
      },
      "output_bytes": if encoding {
        encoded
      } else if workload.has_prefix("check-") {
        0
      } else {
        length
      },
      "input_offset": offset,
      "offset_unit": if text_input {
        "utf16-code-units"
      } else {
        "bytes"
      },
      "variant": variant,
    }
  }
  for variant in ["standard", "standard-no-pad", "url-safe", "url-safe-no-pad"] {
    let padding = variant == "standard" || variant == "url-safe"
    let sizes = if variant == "standard" {
      [0, 1, 2, 3, 16, 64, 4096, 1048576]
    } else {
      [2, 4096]
    }
    for length in sizes {
      for
        implementation in [
          "own-scalar", "own-simd", "core", "gmlewis", "kujirahand", "moonbase",
        ] {
        if implementation != "kujirahand" || variant == "standard" {
          if implementation != "kujirahand" || length <= 4096 {
            add(
              "encode-" + variant,
              implementation,
              variant,
              length,
              padding,
              0,
            )
          }
          add("decode-" + variant, implementation, variant, length, padding, 0)
        }
      }
    }
  }
  for length in [64, 1048576] {
    for
      implementation in [
        "own-scalar", "own-simd", "core", "gmlewis", "kujirahand", "moonbase",
      ] {
      if implementation != "kujirahand" || length <= 4096 {
        add("encode-standard", implementation, "standard", length, true, 1)
      }
      add("decode-standard", implementation, "standard", length, true, 1)
    }
    for implementation in ["own-scalar", "own-simd", "moonbase"] {
      add("decode-bytes-standard", implementation, "standard", length, true, 0)
    }
    for implementation in ["own-scalar", "own-simd"] {
      for
        workload in [
          "encode-into-standard", "decode-into-standard", "decode-inplace-standard",
          "check-standard",
        ] {
        add(workload, implementation, "standard", length, true, 0)
      }
    }
  }
  cases
}

///|
/// Validates nonempty unique cases and complete timing statistics before reporting.
fn validate_backend(value : Json, package_dir : String) -> Unit raise {
  let backend = text(value, "backend")
  guard ["native", "wasm", "wasm-gc", "js"].contains(backend) else {
    fail("Unexpected backend: \{backend}")
  }
  guard text(value, "time_unit") == "microseconds" else {
    fail("Unexpected timing unit")
  }
  let summaries = array(value, "summaries")
  guard !summaries.is_empty() &&
    (package_dir != "crc32" || summaries.length() == 207) else {
    fail("Expected 69 library and 138 comparison cases")
  }
  if package_dir == "url" {
    validate_url_inventory(summaries)
  }
  if package_dir == "base64" {
    validate_base64_inventory(summaries)
  }
  let names : Map[String, Unit] = Map([])
  for summary in summaries {
    let name = text(summary, "name")
    let _ = case_parts(summary)
    guard !names.contains(name) else { fail("Duplicate benchmark: \{name}") }
    names[name] = ()
    let mean = number(summary, "mean")
    let minimum = number(summary, "min")
    let maximum = number(summary, "max")
    let median = number(summary, "median")
    let tolerance = maximum.abs() * 0.000000000001 + 0.000000000001
    guard mean > 0 &&
      minimum >= 0 &&
      minimum <= mean + tolerance &&
      mean <= maximum + tolerance &&
      minimum <= median + tolerance &&
      median <= maximum + tolerance else {
      fail("Invalid timing range: \{name}")
    }
    guard number(summary, "std_dev") >= 0 &&
      number(summary, "std_dev_pct") >= 0 &&
      number(summary, "runs") == 10 &&
      number(summary, "batch_size") >= 1 else {
      fail("Invalid sample metadata: \{name}")
    }
  }
}

///|
/// Defines every URL workload, library mode, and view offset expected in a complete run.
fn expected_url_keys() -> Map[String, Unit] {
  let keys : Map[String, Unit] = Map([])
  let implementations = [
    "justjavac-scalar", "justjavac-simd", "tonyfettes", "moonbitstack", "connect0459",
  ]
  for
    label in [
      "short", "ascii", "long", "normalize", "unicode", "ipv4", "ipv6", "file", "credentials",
    ] {
    let offsets = if label == "short" || label == "long" {
      ["0", "1"]
    } else {
      ["0"]
    }
    for workload in ["parse-" + label, "roundtrip-" + label] {
      for implementation in implementations {
        for offset in offsets {
          keys["\{workload}:\{implementation}:\{offset}"] = ()
        }
      }
    }
  }
  for label in ["path", "query", "authority"] {
    for workload in ["resolve-" + label, "resolve-roundtrip-" + label] {
      for implementation in implementations {
        keys["\{workload}:\{implementation}:0"] = ()
      }
    }
  }
  for
    implementation in ["justjavac", "tonyfettes", "moonbitstack", "connect0459"] {
    keys["form-roundtrip:\{implementation}:0"] = ()
  }
  keys
}

///|
/// Rejects missing or substituted URL cases even when the total count is correct.
fn validate_url_inventory(summaries : Array[Json]) -> Unit raise {
  let expected = expected_url_keys()
  guard summaries.length() == expected.length() else {
    fail("Expected 144 URL benchmark cases")
  }
  let lengths : Map[String, String] = Map([])
  for summary in summaries {
    let parts = case_parts(summary)
    let key = "\{parts[0]}:\{parts[1]}:\{parts[3]}"
    guard expected.contains(key) && @string.parse_int(parts[2]) > 0 else {
      fail("Unexpected URL benchmark: \{key}")
    }
    let _ = expected.remove(key)
    if lengths.get(parts[0]) is Some(length) {
      guard length == parts[2] else { fail("Mismatched URL input lengths") }
    } else {
      lengths[parts[0]] = parts[2]
    }
  }
  guard expected.is_empty() else { fail("Incomplete URL benchmark inventory") }
}

///|
/// Rejects missing, substituted, or incorrectly sized Base64 cases.
fn validate_base64_inventory(summaries : Array[Json]) -> Unit raise {
  let expected = expected_base64_cases()
  guard summaries.length() == expected.length() && expected.length() == 200 else {
    fail("Expected 200 Base64 benchmark cases")
  }
  for summary in summaries {
    let name = text(summary, "name")
    guard expected.get(name) is Some(Object(metadata)) else {
      fail("Unexpected or duplicate Base64 case: \{name}")
    }
    expected.remove(name)
    for (key, value) in metadata {
      guard field(summary, key) == value else {
        fail("Incorrect Base64 metadata: \{name}/\{key}")
      }
    }
  }
  guard expected.is_empty() else { fail("Incomplete Base64 case inventory") }
}

///|
/// Identifies the bundled core revision through its compiler build, excluding host paths.
fn compiler_build(record : Json) -> String raise {
  for line in text(record, "toolchain").split("\n") {
    if line.has_prefix("moonc ") {
      let pieces = line
        .split(" ")
        .filter(part => part != "")
        .map(part => part.to_owned())
        .to_array()
      guard pieces.length() >= 3 else { fail("Missing compiler build") }
      return pieces[:3].to_owned().join(" ")
    }
  }
  fail("Missing MoonBit compiler provenance")
}

///|
/// Pins the Base64 comparison APIs and licenses expected by this report revision.
fn base64_dependencies() -> Array[Json] {
  [
    {
      "label": "core",
      "package": "moonbitlang/core/encoding/base64",
      "version": "toolchain-bundled",
      "license": "Apache-2.0",
      "api": "encode(BytesView), decode(StringView)",
    },
    {
      "label": "gmlewis",
      "package": "gmlewis/base64",
      "version": "0.16.15",
      "license": "Apache-2.0",
      "api": "std/url_encode2str(FixedArray), std/url_decode2bytes(String)",
    },
    {
      "label": "kujirahand",
      "package": "kujirahand/base64",
      "version": "0.1.1",
      "license": "Apache-2.0",
      "api": "encode_bytes(Bytes), decode_bytes(String)",
    },
    {
      "label": "moonbase",
      "package": "moonbitstack/moonbase/base64",
      "version": "0.5.1",
      "license": "Apache-2.0",
      "api": "encode(BytesView), decode(StringView)/decode_bytes(BytesView), strict=true",
    },
  ]
}

///|
/// Rejects local measurements and mixed CI revisions or attempts in a published snapshot.
fn validate_snapshot(records : Array[Json], package_dir : String) -> Unit raise {
  guard records.length() == 3 else {
    fail("A snapshot requires all three operating systems")
  }
  let first = records[0]
  let revision = text(first, "source_commit")
  let run = text(first, "run_id")
  guard revision.length() == 40 && run != "" else {
    fail("Missing CI provenance")
  }
  let operating_systems : Map[String, Unit] = Map([])
  let canonical_cases : Map[String, Unit] = Map([])
  for record in records {
    let os = text(record, "os")
    guard ["linux", "macos", "windows"].contains(os) &&
      !operating_systems.contains(os) else {
      fail("Invalid or duplicate operating system: \{os}")
    }
    operating_systems[os] = ()
    guard text(record, "repository") == text(first, "repository") else {
      fail("Mixed benchmark repositories")
    }
    guard text(record, "source") == "github-actions" &&
      text(record, "module") == "justjavac/\{package_dir}" &&
      text(record, "source_commit") == revision &&
      text(record, "run_id") == run &&
      text(record, "run_attempt") == text(first, "run_attempt") else {
      fail("Mixed or non-CI benchmark provenance")
    }
    let expected_url = "https://github.com/\{text(record, "repository")}/actions/runs/\{run}"
    guard text(record, "run_url") == expected_url else {
      fail("Unexpected CI run URL")
    }
    guard array(record, "comparison_dependencies") ==
      array(first, "comparison_dependencies") else {
      fail("Mixed comparison dependency versions")
    }
    if package_dir == "base64" {
      guard array(record, "comparison_dependencies") == base64_dependencies() else {
        fail("Unexpected Base64 comparison dependencies")
      }
      guard compiler_build(record) == compiler_build(first) &&
        text(record, "module_manifest").replace_all(old="\r", new="") ==
        text(first, "module_manifest").replace_all(old="\r", new="") &&
        text(record, "comparison_manifest").replace_all(old="\r", new="") ==
        text(first, "comparison_manifest").replace_all(old="\r", new="") else {
        fail("Mixed Base64 toolchains or manifests")
      }
    }
    let backends = array(record, "backends")
    guard backends.length() == 4 else { fail("Missing backend results") }
    let backend_names : Map[String, Unit] = Map([])
    for backend in backends {
      let name = text(backend, "backend")
      guard !backend_names.contains(name) else { fail("Duplicate backend") }
      backend_names[name] = ()
      validate_backend(backend, package_dir)
      if package_dir == "url" || package_dir == "base64" {
        let summaries = array(backend, "summaries")
        if canonical_cases.is_empty() {
          for summary in summaries {
            canonical_cases[text(summary, "name")] = ()
          }
        } else {
          for summary in summaries {
            guard canonical_cases.contains(text(summary, "name")) else {
              fail("Mixed benchmark case inventories")
            }
          }
        }
      }
    }
    guard text(field(record, "cpu"), "model") != "" else {
      fail("Missing CPU model")
    }
  }
}

///|
/// Displays string and numeric runner metadata without JSON quotation marks.
fn display(value : Json) -> String {
  match value {
    String(contents) => cell(contents)
    Number(contents, ..) => decimal(contents)
    _ => cell(value.stringify())
  }
}

///|
/// Indexes named cases for focused public API comparison tables.
fn index(backend : Json) -> Map[String, Json] raise {
  let values : Map[String, Json] = Map([])
  for summary in array(backend, "summaries") {
    values[text(summary, "name")] = summary
  }
  values
}

///|
/// Formats a measured mean and marks cases with substantial sample variation.
fn metric(summary : Json, units : String, bytes : Double) -> String raise {
  let mean = number(summary, "mean")
  let value = match units {
    "ns" => mean * 1000
    "us" => mean
    "GiB/s" => bytes * 1000000 / mean / 1073741824
    _ => fail("Unknown report unit")
  }
  let variability = if number(summary, "std_dev_pct") >= 5 { "*" } else { "" }
  decimal(value) + variability
}

///|
/// Renders one key comparison for all twelve runner/backend environments.
fn results_table(
  builder : StringBuilder,
  records : Array[Json],
  title : String,
  workload : String,
  bytes : String,
  parameter : String,
  units : String,
  byte_count : Double,
  implementations~ : Array[String] = [
    "own-scalar", "own-simd", "gaato", "gmlewis", "kujirahand", "mooncrypt",
  ],
  labels~ : Array[String] = [
    "ours scalar", "ours SIMD request", "gaato", "gmlewis", "kujirahand", "mooncrypt",
  ],
) -> Unit raise {
  builder.write_string("## \{title}\n\n")
  builder.write_string(
    "| OS / backend | " +
    labels.join(" | ") +
    " |\n| --- | " +
    labels.map(_ => "---").join(" | ") +
    " |\n",
  )
  for record in records {
    for backend in array(record, "backends") {
      let values = index(backend)
      let mut fastest = number(
        values["\{workload}:\{implementations[0]}:\{bytes}:\{parameter}"],
        "mean",
      )
      for implementation in implementations {
        let name = "\{workload}:\{implementation}:\{bytes}:\{parameter}"
        let value = values
          .get(name)
          .unwrap_or_else(() => fail("Missing comparison: \{name}"))
        fastest = fastest.min(number(value, "mean"))
      }
      builder.write_string(
        "| \{text(record, "os")} / \{text(backend, "backend")} ",
      )
      for implementation in implementations {
        let name = "\{workload}:\{implementation}:\{bytes}:\{parameter}"
        let value = values
          .get(name)
          .unwrap_or_else(() => fail("Missing comparison: \{name}"))
        let measured = metric(value, units, byte_count)
        let formatted = if number(value, "mean") == fastest {
          "**\{measured}**"
        } else {
          measured
        }
        builder.write_string("| \{formatted} ")
      }
      builder.write_string("|\n")
    }
  }
  builder.write_string("\n")
}

///|
/// Summarizes native throughput ratios against the fastest external library and the scalar path.
fn highlights(builder : StringBuilder, records : Array[Json]) -> Unit raise {
  builder.write_string(
    "## At a glance\n\nNative, 1 MiB owned input; ratios compare throughput:\n\n",
  )
  for record in records {
    let backends = array(record, "backends")
    let native_index = backends
      .search_by(backend => text(backend, "backend") == "native")
      .unwrap_or_else(() => fail("Missing native results"))
    let values = index(backends[native_index])
    let scalar = number(values["compare:own-scalar:1048576:0"], "mean")
    let simd = number(values["compare:own-simd:1048576:0"], "mean")
    let mut fastest = "gaato"
    let mut external_mean = number(values["compare:gaato:1048576:0"], "mean")
    for implementation in ["gmlewis", "kujirahand", "mooncrypt"] {
      let mean = number(values["compare:\{implementation}:1048576:0"], "mean")
      if mean < external_mean {
        fastest = implementation
        external_mean = mean
      }
    }
    builder.write_string(
      "- **\{text(record, "os")}:** scalar \{decimal(1048576 * 1000000 / scalar / 1073741824)} GiB/s, **\{decimal(external_mean / scalar)}x** the fastest external library (\{fastest}); SIMD **\{decimal(scalar / simd)}x** scalar.\n",
    )
  }
  builder.write_string(
    "\nRatios below 1 mean lower throughput. Hosted measurements are workload-specific; consult variation marks in the tables.\n\n",
  )
}

///|
/// Builds a concise, information-rich report backed by a complete JSON snapshot.
fn report(package_dir : String, records : Array[Json]) -> String raise {
  validate_snapshot(records, package_dir)
  if package_dir == "url" {
    return url_report(records)
  }
  if package_dir == "base64" {
    return base64_report(records)
  }
  let first = records[0]
  let revision = text(first, "source_commit")
  let repository = text(first, "repository")
  let builder = StringBuilder()
  builder.write_string("# CRC32 performance comparison\n\n")
  builder.write_string(
    "[CI run \{text(first, "run_id")}](\{text(first, "run_url")}) | [source \{revision[:7]}](https://github.com/\{repository}/commit/\{revision}) | attempt \{text(first, "run_attempt")}\n\n",
  )
  builder.write_string(
    "**Scope:** 3 operating systems x 4 backends x 207 cases = **2484 measurements**. Key comparisons are below; [BENCHMARK-DATA.json](BENCHMARK-DATA.json) preserves every case, mean, median, range, standard deviation, quartile, sample count, command, timestamp, and environment.\n\n",
  )
  highlights(builder, records)
  builder.write_string(
    "## Implementations\n\n| Label | Package / pinned version | Public API measured |\n| --- | --- | --- |\n| ours scalar | justjavac/crc32 / source above | hash and Hasher, simd=false |\n| ours SIMD request | justjavac/crc32 / source above | hash and Hasher, simd=true |\n",
  )
  for dependency in array(first, "comparison_dependencies") {
    builder.write_string(
      "| \{cell(text(dependency, "label"))} | \{cell(text(dependency, "package"))} / \{cell(text(dependency, "version"))} | \{cell(text(dependency, "api"))} |\n",
    )
  }
  builder.write_string(
    "\n## Reading the results\n\n- All libraries pass identical IEEE CRC-32 vectors and an independent bitwise oracle.\n- Owned inputs and stream chunks are prepared before timing; state creation, public API calls, byte-wise adapter loops, and finalization are timed. gmlewis uses a byte-at-a-time API.\n- The offset-1 view workload includes input materialization for kujirahand, whose API requires owned Bytes. Other adapters accept views or iterate their bytes.\n- The SIMD request uses scalar fallback on Wasm GC/JS and inputs shorter than 16 bytes.\n- **Bold** marks the best measured mean in a row; `*` marks CV >= 5% and possible noise. Lower latency and higher GiB/s are better. Compare within an OS/backend; hosted hardware differs.\n- Release mode, deterministic binary inputs, 10 batch samples, and 5% winsorization. Calibration targets about 100 ms; fast cases use 100000 iterations per batch. Timings include the bench.keep barrier.\n\n",
  )
  builder.write_string(
    "## Runner context\n\n| OS | CPU | Architecture / logical CPUs | Image | Node.js |\n| --- | --- | --- | --- | --- |\n",
  )
  for record in records {
    let cpu = field(record, "cpu")
    builder.write_string(
      "| \{text(record, "os")} | \{cell(text(cpu, "model"))} | \{cell(text(cpu, "architecture"))} / \{display(field(cpu, "logical_cpus"))} | \{cell(text(record, "image_os"))} / \{cell(text(record, "image_version"))} | \{cell(text(record, "node"))} |\n",
    )
  }
  builder.write_string("\n")
  results_table(
    builder, records, "1 MiB owned input: throughput (GiB/s)", "compare", "1048576",
    "0", "GiB/s", 1048576,
  )
  results_table(
    builder, records, "4 KiB owned input: latency (us)", "compare", "4096", "0",
    "us", 4096,
  )
  results_table(
    builder, records, "64-byte owned input: latency (ns)", "compare", "64", "0",
    "ns", 64,
  )
  results_table(
    builder, records, "64 KiB stream, 4 KiB chunks: latency (us)", "compare-stream",
    "65536", "4096", "us", 65536,
  )
  results_table(
    builder, records, "1 MiB offset-1 view: end-to-end latency (us)", "view", "1048576",
    "1", "us", 1048576,
  )
  builder.write_string(
    "<details>\n<summary>Toolchain and reproduction</summary>\n\n",
  )
  for record in records {
    builder.write_string(
      "**\{text(record, "os")}:**\n\n~~~text\n\{text(record, "toolchain")}\n~~~\n\n",
    )
  }
  builder.write_string(
    "Run `moon -C benchmarks test --target all` before local measurements, then `moon run scripts/benchmark.mbtx crc32`. CI measures backends sequentially per OS. Raw artifacts are retained for 90 days; committed JSON preserves the full snapshot. Reports retain their measured source commit.\n\n</details>\n",
  )
  builder.to_string()
}

///|
/// Finds a workload's validated input byte count for a focused URL comparison table.
fn url_table(
  builder : StringBuilder,
  records : Array[Json],
  title : String,
  workload : String,
  offset : String,
  units : String,
) -> Unit raise {
  let first = array(array(records[0], "backends")[0], "summaries")
  let mut bytes = ""
  for summary in first {
    let parts = case_parts(summary)
    if parts[0] == workload && parts[3] == offset {
      bytes = parts[2]
      break
    }
  }
  guard bytes != "" else { fail("Missing URL workload: \{workload}") }
  let form = workload == "form-roundtrip"
  results_table(
    builder,
    records,
    title + " (\{bytes} UTF-8 bytes)",
    workload,
    bytes,
    offset,
    units,
    @string.parse_int(bytes).to_double(),
    implementations=if form {
      ["justjavac", "tonyfettes", "moonbitstack", "connect0459"]
    } else {
      [
        "justjavac-scalar", "justjavac-simd", "tonyfettes", "moonbitstack", "connect0459",
      ]
    },
    labels=if form {
      ["justjavac", "tonyfettes", "moonbitstack", "connect0459"]
    } else {
      [
        "ours scalar", "ours SIMD request", "tonyfettes", "moonbitstack", "connect0459",
      ]
    },
  )
}

///|
/// Renders a concise URL report with full provenance and an exhaustive JSON companion.
fn url_report(records : Array[Json]) -> String raise {
  let first = records[0]
  let revision = text(first, "source_commit")
  let repository = text(first, "repository")
  let builder = StringBuilder()
  builder.write_string("# URL performance comparison\n\n")
  builder.write_string(
    "[CI run \{text(first, "run_id")}](\{text(first, "run_url")}) | [source \{revision[:7]}](https://github.com/\{repository}/commit/\{revision}) | attempt \{text(first, "run_attempt")}\n\n",
  )
  builder.write_string(
    "**Scope:** 3 operating systems x 4 backends x 144 cases = **1728 measurements**. [BENCHMARK-DATA.json](BENCHMARK-DATA.json) preserves all workloads, input lengths, UTF-16 view offsets, means, medians, ranges, variability, throughput inputs, sample counts, compiler versions, commands, timestamps, and dependency manifests.\n\n",
  )
  builder.write_string(
    "## Implementations\n\n| Label | Package / pinned version | API |\n| --- | --- | --- |\n| ours scalar / SIMD request | justjavac/url / source above | parse(StringView, simd=false/true), href |\n",
  )
  for dependency in array(first, "comparison_dependencies") {
    builder.write_string(
      "| \{cell(text(dependency, "label"))} | \{cell(text(dependency, "package"))} / \{cell(text(dependency, "version"))} | \{cell(text(dependency, "api"))} |\n",
    )
  }
  builder.write_string(
    "\n## Method\n\n- All adapters pass identical canonical results before timing; moonurl explicitly uses WHATWG mode. Each library runs in a separate binary on the same runner, sequentially per backend.\n- Nine absolute inputs cover short/long ASCII, normalization, Unicode/IDNA, IPv4, IPv6, file URLs, and credentials. Separate cases measure parse only and parse plus canonical serialization. Short/long inputs additionally use UTF-16 view offset 1. Three relative inputs use pre-parsed bases. Form-query cases include decoding and serialization.\n- Data construction is outside timing. Required public API adapters are timed, including StringView-to-String for urllib and UTF-8 conversion for moonurl's form decoder. Generic adapter callbacks and bench.keep optimizer barriers are included for every library. Getter allocation and eager/lazy serialization choices therefore affect roundtrip measurements.\n- The SIMD request uses checked V128 scans on native/Wasm and scalar fallback on Wasm GC/JS. Its canonical UTF-16 guard stays scalar below 64 code units; general UTF-8 scans use 16-byte blocks. This port does not use Ada's architecture-specific AVX-512 IP kernels or optional simdutf dependency.\n- Release mode, 10 batch samples, and 5% winsorization. Calibration targets about 100 ms; fast cases use 100000 iterations per batch. **Bold** marks the smallest measured mean in a row; `*` marks CV >= 5%. Compare within a runner/backend; these are workload-specific hosted measurements.\n\n",
  )
  builder.write_string(
    "## Runner context\n\n| OS | CPU | Architecture / logical CPUs | Runner / image | Node.js |\n| --- | --- | --- | --- | --- |\n",
  )
  for record in records {
    let cpu = field(record, "cpu")
    builder.write_string(
      "| \{text(record, "os")} | \{cell(text(cpu, "model"))} | \{cell(text(cpu, "architecture"))} / \{display(field(cpu, "logical_cpus"))} | \{cell(text(record, "runner_label"))} / \{cell(text(record, "image_os"))} / \{cell(text(record, "image_version"))} | \{cell(text(record, "node"))} |\n",
    )
  }
  builder.write_string("\n")
  url_table(
    builder, records, "Short absolute URL: parse latency (ns)", "parse-short", "0",
    "ns",
  )
  url_table(
    builder, records, "ASCII path/query/fragment: parse latency (ns)", "parse-ascii",
    "0", "ns",
  )
  url_table(
    builder, records, "Long ASCII URL: parse latency (us)", "parse-long", "0", "us",
  )
  url_table(
    builder, records, "Long ASCII URL: UTF-8-equivalent throughput (GiB/s)", "parse-long",
    "0", "GiB/s",
  )
  url_table(
    builder, records, "Unicode URL with IDNA: parse latency (us)", "parse-unicode",
    "0", "us",
  )
  url_table(
    builder, records, "Normalization and serialization: latency (us)", "roundtrip-normalize",
    "0", "us",
  )
  url_table(
    builder, records, "Relative path resolution and serialization: latency (us)",
    "resolve-roundtrip-path", "0", "us",
  )
  url_table(
    builder, records, "Long offset-1 view and serialization: latency (us)", "roundtrip-long",
    "1", "us",
  )
  url_table(
    builder, records, "Decoded form query and serialization: latency (us)", "form-roundtrip",
    "0", "us",
  )
  builder.write_string(
    "<details>\n<summary>Toolchain, commands, and reproduction</summary>\n\n",
  )
  for record in records {
    builder.write_string(
      "**\{text(record, "os")}:**\n\n~~~text\n\{text(record, "toolchain")}\n~~~\n\n",
    )
    for backend in array(record, "backends") {
      builder.write_string(
        "\{text(backend, "backend")}: \{text(backend, "started_at_utc")} to \{text(backend, "finished_at_utc")} (UTC).\n\n~~~text\n\{text(backend, "command")}\n~~~\n\n",
      )
    }
  }
  builder.write_string(
    "Run `moon -C benchmarks test --target all`, then `moon run scripts/benchmark.mbtx url` for local measurements. CI uses the same release commands sequentially. The report generator rejects local data, incomplete case sets, mixed revisions/runs/attempts, and changed dependency versions. Raw logs are retained for 90 days; the committed JSON preserves the complete snapshot.\n\n</details>\n",
  )
  builder.to_string()
}

///|
/// Summarizes native scalar/vector ratios for the complete public Base64 operations.
fn base64_highlights(
  builder : StringBuilder,
  records : Array[Json],
) -> Unit raise {
  builder.write_string(
    "## Key findings\n\nOne MiB binary payload, native public allocating APIs; ratios are SIMD-request throughput divided by scalar throughput:\n\n",
  )
  for record in records {
    let native = array(record, "backends")
      .search_by(value => text(value, "backend") == "native")
      .unwrap()
    let values = index(array(record, "backends")[native])
    let encode_scalar = number(
      values["encode-standard:own-scalar:1048576:0"],
      "mean",
    )
    let encode_simd = number(
      values["encode-standard:own-simd:1048576:0"],
      "mean",
    )
    let decode_scalar = number(
      values["decode-standard:own-scalar:1048576:0"],
      "mean",
    )
    let decode_simd = number(
      values["decode-standard:own-simd:1048576:0"],
      "mean",
    )
    builder.write_string(
      "- **\{text(record, "os")}:** encoding \{decimal(encode_scalar / encode_simd)}x; string decoding \{decimal(decode_scalar / decode_simd)}x.\n",
    )
  }
  builder.write_string(
    "\nA ratio below one indicates lower SIMD-request throughput. Defaults select scalar on native/Wasm GC/JS and vectors on Wasm; explicit requests are preserved in every comparison. Native lowering of several V128 operations uses core scalar helpers on this toolchain. Revalidate this choice after compiler upgrades.\n\n",
  )
}

///|
/// Renders representative Base64 comparisons while retaining every case in the JSON snapshot.
fn base64_report(records : Array[Json]) -> String raise {
  let first = records[0]
  let revision = text(first, "source_commit")
  let repository = text(first, "repository")
  let builder = StringBuilder()
  builder.write_string("# Base64 cross-library performance\n\n")
  builder.write_string(
    "[CI run \{text(first, "run_id")}](\{text(first, "run_url")}) | [source \{revision[:7]}](https://github.com/\{repository}/commit/\{revision}) | attempt \{text(first, "run_attempt")}\n\n",
  )
  builder.write_string(
    "Complete snapshot: **3 operating systems x 4 backends x 200 cases = 2400 measurements**. [BENCHMARK-DATA.json](BENCHMARK-DATA.json) preserves every unrounded statistic, exact input/output length, and runner/toolchain record.\n\n",
  )
  base64_highlights(builder, records)
  builder.write_string(
    "## Implementations\n\n| Label | Package / version | Public API measured |\n| --- | --- | --- |\n| ours scalar / SIMD request | justjavac/base64 / source above | encode_to_string, decode_string; explicit simd=false/true |\n",
  )
  for dependency in array(first, "comparison_dependencies") {
    builder.write_string(
      "| \{cell(text(dependency, "label"))} | \{cell(text(dependency, "package"))} / \{cell(text(dependency, "version"))} | \{cell(text(dependency, "api"))} |\n",
    )
  }
  builder.write_string(
    "\n## Method and limits\n\n- Corpus construction and independent per-bit reference encoding are outside timed callbacks. All public adapters pass identical encoded strings and decoded bytes for every measured variant before timing. This establishes corpus agreement, including binary data, rather than full conformance of permissive competitors.\n- Standard padded encoding/decoding uses binary sizes 0, 1, 2, 3, 16, 64, 4096, and 1048576 bytes. Standard unpadded and both URL-safe policies use 2 and 4096 bytes. Kujirahand supplies only a padded standard binary encoder, so it participates only in that policy; its quadratic string-concatenation encoder is limited to 4096-byte inputs. Its linear decoder retains the large cases. Tonyfettes 0.1.0 is excluded because its legacy module metadata cannot be installed by the recorded toolchain.\n- Common encoding allocates a String; common decoding accepts StringView and allocates Bytes. Gmlewis requires BytesView-to-FixedArray conversion on encoding and StringView-to-String on decoding, both timed. Kujirahand's required owned Bytes/String conversion is timed. Full views can reuse their original owned value; offset-1 views require materialization where the API needs ownership. Moonbase decoding explicitly selects strict=true and the matching padding policy.\n- Our StringView decoder reads UTF-16 directly; it does not first allocate UTF-8. Our allocating encoder builds ASCII bytes then converts them to String. Byte-input decoding is reported separately. Buffer-reuse cases prepare destination arrays outside the timer; in-place decoding includes an encoded-input copy inside each invocation so every call receives Base64 input. Validation cases allocate no output. All calls retain bench.keep barriers.\n- Case names use workload:implementation:binary_payload_bytes:view_offset. Decoder throughput uses the actual encoded ASCII input length, including padding; each JSON summary records input_bytes, input_code_units, output_bytes, input_offset, and offset_unit. ASCII wire bytes and UTF-16 code-unit counts are distinguished; UTF-16 backing storage uses two bytes per code unit. Empty-input throughput is n/a.\n- The port adapts base64-simd/vsimd 0.8.0's scalar, ALSW lookup, and portable vector bit transforms to V128. Native and Wasm explicit requests process bounded 16-byte loads; other backends fall back to scalar. Encoding consumes twelve source bytes per vector, decoding writes exactly twelve output bytes per sixteen characters, and remainders stay scalar. Rust runtime CPU dispatch and AVX2/NEON-specific 256-bit kernels are outside this portable port.\n- Release mode and sequential backends on each runner. Core calibrates near 100 ms, takes 10 batch samples, and applies 5% winsorization; fast cases use 100000 iterations per batch. Bold marks the lowest observed mean in a row, and * marks CV >= 5% as possible noise. These hosted means describe the recorded workloads; variation must inform significance claims.\n\n",
  )
  let all = [
    "own-scalar", "own-simd", "core", "gmlewis", "kujirahand", "moonbase",
  ]
  let labels = [
    "ours scalar", "ours SIMD request", "core", "gmlewis", "kujirahand", "moonbase",
  ]
  let large_encoders = ["own-scalar", "own-simd", "core", "gmlewis", "moonbase"]
  let large_labels = [
    "ours scalar", "ours SIMD request", "core", "gmlewis", "moonbase",
  ]
  results_table(
    builder,
    records,
    "Encode 64 bytes to String (ns)",
    "encode-standard",
    "64",
    "0",
    "ns",
    64,
    implementations=all,
    labels~,
  )
  results_table(
    builder,
    records,
    "Decode 88 ASCII characters to 64 bytes (ns)",
    "decode-standard",
    "64",
    "0",
    "ns",
    88,
    implementations=all,
    labels~,
  )
  results_table(
    builder,
    records,
    "Encode 1 MiB to String (GiB/s of binary input)",
    "encode-standard",
    "1048576",
    "0",
    "GiB/s",
    1048576,
    implementations=large_encoders,
    labels=large_labels,
  )
  results_table(
    builder,
    records,
    "Decode a 1 MiB payload (GiB/s of 1398104 encoded bytes)",
    "decode-standard",
    "1048576",
    "0",
    "GiB/s",
    1398104,
    implementations=all,
    labels~,
  )
  builder.write_string(
    "<details>\n<summary>Other variants, partial views, buffer APIs, and runner context</summary>\n\n",
  )
  results_table(
    builder,
    records,
    "URL-safe unpadded encoding, 4 KiB (microseconds)",
    "encode-url-safe-no-pad",
    "4096",
    "0",
    "us",
    4096,
    implementations=large_encoders,
    labels=large_labels,
  )
  results_table(
    builder,
    records,
    "URL-safe unpadded decoding, 4 KiB (microseconds)",
    "decode-url-safe-no-pad",
    "4096",
    "0",
    "us",
    5462,
    implementations=large_encoders,
    labels=large_labels,
  )
  results_table(
    builder,
    records,
    "Encode 1 MiB from view offset 1 (GiB/s)",
    "encode-standard",
    "1048576",
    "1",
    "GiB/s",
    1048576,
    implementations=large_encoders,
    labels=large_labels,
  )
  results_table(
    builder,
    records,
    "Decode 1 MiB from UTF-16 view offset 1 (GiB/s of encoded bytes)",
    "decode-standard",
    "1048576",
    "1",
    "GiB/s",
    1398104,
    implementations=all,
    labels~,
  )
  results_table(
    builder,
    records,
    "Decode prepared ASCII bytes, 1 MiB payload (GiB/s)",
    "decode-bytes-standard",
    "1048576",
    "0",
    "GiB/s",
    1398104,
    implementations=["own-scalar", "own-simd", "moonbase"],
    labels=["ours scalar", "ours SIMD request", "moonbase"],
  )
  for
    workload in [
      "encode-into-standard", "decode-into-standard", "decode-inplace-standard",
      "check-standard",
    ] {
    results_table(
      builder,
      records,
      workload + ", 1 MiB payload (microseconds)",
      workload,
      "1048576",
      "0",
      "us",
      1048576,
      implementations=["own-scalar", "own-simd"],
      labels=["ours scalar", "ours SIMD request"],
    )
  }
  builder.write_string(
    "## Runner context\n\n| OS | Runner | CPU | Architecture | Image |\n| --- | --- | --- | --- | --- |\n",
  )
  for record in records {
    let cpu = field(record, "cpu")
    builder.write_string(
      "| \{text(record, "os")} | \{cell(text(record, "runner_label"))} | \{cell(text(cpu, "model"))} | \{display(field(cpu, "architecture"))} | \{cell(text(record, "image_os"))} / \{cell(text(record, "image_version"))} |\n",
    )
  }
  for record in records {
    builder.write_string(
      "\n### \{text(record, "os")}\n\n~~~text\n\{text(record, "toolchain")}\nNode \{text(record, "node")}\n~~~\n\n",
    )
    for backend in array(record, "backends") {
      builder.write_string(
        "- \{text(backend, "backend")}: \{text(backend, "started_at_utc")} to \{text(backend, "finished_at_utc")}\n",
      )
    }
    builder.write_string(
      "\n~~~text\n\{text(array(record, "backends")[0], "command")}\n~~~\n",
    )
  }
  builder.write_string(
    "\nRun moon -C benchmarks test --target all, then moon run scripts/benchmark.mbtx base64. Published reports reject local data, incomplete inventories or matrices, mismatched lengths, changed dependencies, and mixed source commits/runs/attempts/toolchains. Raw stdout/stderr logs are retained as CI artifacts for 90 days. The measured source revision remains unchanged when this report is committed later.\n\n</details>\n",
  )
  builder.to_string()
}

///|
/// Requires a validation failure for a deliberately corrupted report fixture.
fn must_reject(operation : () -> Unit raise) -> Unit raise {
  try operation() catch {
    _ => ()
  } noraise {
    _ => fail("Corrupted benchmark data was accepted")
  }
}

///|
/// Clones a JSON value before changing a field so rejection fixtures remain independent.
fn changed(value : Json, key : String, replacement : Json) -> Json raise {
  let copy = @json.parse(value.stringify())
  match copy {
    Object(fields) => {
      fields[key] = replacement
      copy
    }
    _ => fail("Expected an object fixture")
  }
}

///|
/// Exercises Base64 inventories, metadata, timing ranges, complete matrices, and provenance failures.
fn base64_self_test() -> Unit raise {
  let cases : Array[Json] = []
  for (name, value) in expected_base64_cases() {
    match value {
      Object(fields) => {
        fields["name"] = Json(name)
        fields["mean"] = 1.0
        fields["min"] = 0.5
        fields["max"] = 1.5
        fields["median"] = 1.0
        fields["std_dev"] = 0.01
        fields["std_dev_pct"] = 1.0
        fields["runs"] = 10
        fields["batch_size"] = 100000
        cases.push(value)
      }
      _ => fail("Invalid expected case metadata")
    }
  }
  assert_eq(cases.length(), 200)
  validate_base64_inventory(cases)
  let wrong = cases.copy()
  wrong[0] = changed(cases[0], "name", "encode-standard:unrequested:0:0")
  must_reject(() => validate_base64_inventory(wrong))
  wrong[0] = changed(cases[0], "input_bytes", -1)
  must_reject(() => validate_base64_inventory(wrong))
  wrong[0] = cases[1]
  must_reject(() => validate_base64_inventory(wrong))
  must_reject(() => validate_base64_inventory(cases[:199].to_owned()))
  let backends : Array[Json] = []
  for backend in ["native", "wasm", "wasm-gc", "js"] {
    backends.push({
      "backend": backend,
      "time_unit": "microseconds",
      "command": "moon -C benchmarks bench --release --no-parallelize",
      "started_at_utc": "2026-11-24T00:00:00Z",
      "finished_at_utc": "2026-11-24T00:10:00Z",
      "summaries": Json(cases),
    })
  }
  validate_backend(backends[0], "base64")
  wrong[0] = changed(cases[0], "mean", 2.0)
  must_reject(() => {
    validate_backend(changed(backends[0], "summaries", Json(wrong)), "base64")
  })
  let records : Array[Json] = []
  for os in ["linux", "macos", "windows"] {
    records.push({
      "os": os,
      "module": "justjavac/base64",
      "source": "github-actions",
      "source_commit": "0".repeat(40),
      "repository": "justjavac/moonbit-simd",
      "run_id": "1",
      "run_attempt": "1",
      "run_url": "https://github.com/justjavac/moonbit-simd/actions/runs/1",
      "cpu": { "model": "self-test CPU", "architecture": "x64" },
      "toolchain": "moon test\nmoonc test-build (2026-11-24) /host/moonc",
      "node": "v24.0.0",
      "runner_label": os,
      "image_os": os,
      "image_version": "1",
      "module_manifest": "base64 manifest",
      "comparison_manifest": "pinned comparisons",
      "comparison_dependencies": Json(base64_dependencies()),
      "backends": Json(backends),
    })
  }
  validate_snapshot(records, "base64")
  assert_true(base64_report(records).find("2400 measurements") is Some(_))
  let corrupt = records.copy()
  for
    (key, replacement) in [
      ("source", Json("local")),
      ("source_commit", Json("1".repeat(40))),
      ("run_id", Json("2")),
      ("run_attempt", Json("2")),
      ("repository", Json("other/repository")),
      ("run_url", Json("https://example.com")),
      ("toolchain", Json("moonc other-build (2026-11-24) /host/moonc")),
      ("comparison_manifest", Json("changed comparisons")),
      ("comparison_dependencies", Json(([] : Array[Json]))),
      ("backends", Json(backends[:3].to_owned())),
    ] {
    corrupt[1] = changed(records[1], key, replacement)
    must_reject(() => validate_snapshot(corrupt, "base64"))
  }
  corrupt[1] = records[0]
  must_reject(() => validate_snapshot(corrupt, "base64"))
}

///|
/// Tests report parsing, precise suffix labels, and rejection of fabricated provenance.
fn self_test() -> Unit raise {
  base64_self_test()
  let valid : Json = {
    "name": "combine:gf2:18446744073709551615:0",
    "mean": 1.0,
  }
  assert_eq(case_parts(valid)[2], "18446744073709551615")
  assert_eq(throughput("combine", "18446744073709551615", 1.0), "n/a")
  assert_eq(throughput("hash", "0", 1.0), "n/a")
  assert_eq(cell("a|b\nc"), "a\\|b c")
  assert_eq(cell("a|b|c\nd\ne"), "a\\|b\\|c d e")
  assert_eq(expected_url_keys().length(), 144)
  let url_cases : Array[Json] = []
  for (key, _) in expected_url_keys() {
    let parts = key.split(":").map(view => view.to_owned()).to_array()
    url_cases.push({ "name": "\{parts[0]}:\{parts[1]}:1:\{parts[2]}" })
  }
  validate_url_inventory(url_cases)
  let substituted = url_cases.copy()
  substituted[0] = { "name": "parse-short:unrequested-library:1:0" }
  try validate_url_inventory(substituted) catch {
    _ => ()
  } noraise {
    _ => fail("A substituted URL case must fail even with 144 entries")
  }
  try validate_url_inventory([]) catch {
    _ => ()
  } noraise {
    _ => fail("Incomplete URL cases must fail")
  }
  assert_eq(metric({ "mean": 1.25, "std_dev_pct": 4.9 }, "ns", 64), "1250")
  assert_eq(metric({ "mean": 1.25, "std_dev_pct": 5 }, "us", 64), "1.25*")
  assert_eq(
    metric({ "mean": 976.5625, "std_dev_pct": 0 }, "GiB/s", 1048576),
    "1",
  )
  try validate_snapshot([], "crc32") catch {
    _ => ()
  } noraise {
    _ => fail("An incomplete snapshot must fail")
  }
  try number({ "mean": "invalid" }, "mean") catch {
    _ => ()
  } noraise {
    _ => fail("A malformed numeric statistic must fail")
  }
}

///|
/// Writes one uppercase BENCHMARK.md and its complete JSON snapshot per module.
async fn main {
  let arguments = @env.args()
  if arguments.length() == 2 && arguments[1] == "--self-test" {
    self_test()
    println("Benchmark report self-test passed")
    return
  }
  guard arguments.length() == 3 else {
    fail(
      "Usage: moon run scripts/benchmark_report.mbtx <input-directory> <output-directory>",
    )
  }
  let input = arguments[1]
  let output = arguments[2]
  let members = @fs.readdir(input, sort=true)
  guard !members.is_empty() else { fail("No module artifacts were found") }
  for package_dir in members {
    guard package_dir != "." &&
      package_dir != ".." &&
      package_dir.find("/") is None &&
      package_dir.find("\\") is None else {
      fail("Invalid module directory")
    }
    let records : Array[Json] = []
    for os in ["linux", "macos", "windows"] {
      records.push(
        @json.parse(@fs.read_text("\{input}/\{package_dir}/\{os}.json")),
      )
    }
    let markdown = report(package_dir, records)
    let directory = "\{output}/\{package_dir}"
    @fs.mkdir(directory, recursive=true, allow_existing=true)
    @fs.write_text("\{directory}/BENCHMARK.md", markdown)
    @fs.write_text(
      "\{directory}/BENCHMARK-DATA.json",
      Json(records).stringify(indent=2),
    )
    println("Generated \{directory}/BENCHMARK.md")
  }
}
