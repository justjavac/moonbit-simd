name = "justjavac/atoi"

version = "0.1.1"

readme = "README.md"

repository = "https://github.com/justjavac/moonbit-simd"

license = "MIT"

keywords = [ "atoi", "integer", "parsing", "simd", "atoi_simd" ]

description = "Portable decimal byte-to-integer parsing with SIMD, prefix parsing, and 128-bit results, ported from atoi_simd"

preferred_target = "wasm"

warnings = "+missing_doc+test_unqualified_package"
