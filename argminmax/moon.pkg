import {
  "moonbitlang/core/double",
  "moonbitlang/core/float",
  "moonbitlang/core/simd",
}

import {
  "moonbitlang/core/math",
} for "test"

options(
  "allow-experimental-packages": [ "moonbitlang/core/simd" ],
)

// The experimental SIMD import is unused on scalar-only backends.

warnings = "-alert_experimental-unused_package"
